---
/**
 * Sailings and cabins — the heart of the cruise detail page.
 *
 * A river cruise is a fly-cruise: the selling price moves with the UK airport as
 * well as the date, and the cheapest airport is not the same one every week. So the
 * airport is picked first, and every price on the page follows it.
 *
 * Everything is rendered server-side, including the collapsed cabin panels and every
 * airport's price (carried as data-price-CODE on each figure). The script only
 * swaps visible text and toggles panels, so the numbers are in the HTML for crawlers
 * and for anyone without JS.
 */
import type { Airport, Departure } from '../../lib/pricing-transforms';
import { formatPrice } from '../../lib/pricing-transforms';
import type { SailingLadder } from '../../lib/cruise-detail';
import CallLink from './CallLink.astro';

interface Props {
  airports: Airport[];
  departures: Departure[];
  ladders: SailingLadder[];
  shipName: string;
  routeLabel: string;
  nights: number;
  /** Step two: the cabin page for this cruise; a sailing row links to it with ?date=&airport=. */
  cabinsHref?: string;
  tel: string;
  telDisplay: string;
}
const { airports, departures, ladders, shipName, routeLabel, nights, cabinsHref = '', tel, telDisplay } = Astro.props;

// date -> airport code -> price pp
const grid = new Map<string, Map<string, number>>();
for (const d of departures) {
  const date = d.date.slice(0, 10);
  if (!grid.has(date)) grid.set(date, new Map());
  const row = grid.get(date)!;
  const seen = row.get(d.airportCode);
  if (seen == null || d.pricePp < seen) row.set(d.airportCode, d.pricePp);
}

const codes = airports.map(a => a.code);
const lowestFrom = (code: string) =>
  Math.min(...[...grid.values()].map(r => r.get(code) ?? Infinity));

// Default to the airport with the lowest price anywhere on the route.
const defaultCode = codes.slice().sort((a, b) => lowestFrom(a) - lowestFrom(b))[0] ?? '';


const dates = [...grid.keys()].sort();
// Admin-made cruise packages carry dates and airports but no cabin grid.
const hasCabins = ladders.length > 0;
// With no cabin ladders there is nothing to expand, so the row must not pretend
// to be a disclosure: it pointed aria-controls at a panel that was never
// rendered and its "Enquire" CTA did nothing at all (UX review 2026-09-21).
// Without cabins the row is plain and its CTAs are a "Get a written quote" button
// (opens the page's enquiry modal, owner 2026-09-26: river cruises get the form
// back) and the call link (a tel: link on phones, the number as text on desktop;
// see CallLink). With cabins the row is a LINK to step two, the cabin page
// (owner 2026-09-27: one decision per screen — choose the date here, the cabin
// on the next page). The airport in the link follows the airport picked above.
const Row = hasCabins ? 'a' : 'div';
// Long routes (the Zambezi runs 84 sailings) need cutting down before the list
// is usable; short ones show whole and skip the furniture.
const INITIAL_ROWS = 12;
const needsFilters = dates.length > INITIAL_ROWS;
const MONTH_LABELS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const months = [...new Set(dates.map(d => d.slice(0, 7)))].sort()
  .map(ym => ({ ym, label: `${MONTH_LABELS[Number(ym.slice(5, 7)) - 1]} ${ym.slice(0, 4)}`, n: dates.filter(d => d.startsWith(ym)).length }));
const cheapestOf = (row: Map<string, number>) =>
  [...row.entries()].sort((a, b) => a[1] - b[1])[0];

const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const MONS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function niceDate(iso: string) {
  const d = new Date(`${iso}T00:00:00Z`);
  return `${DAYS[d.getUTCDay()]} ${d.getUTCDate()} ${MONS[d.getUTCMonth()]}`;
}
const returnOf = (iso: string, nights: number) => {
  const d = new Date(`${iso}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + nights);
  return `${niceDate(d.toISOString().slice(0, 10))} ${d.getUTCFullYear()}`;
};


const nightCount = nights ?? 0;
const bestOverall = Math.min(...dates.map(d => grid.get(d)?.get(defaultCode) ?? Infinity));
// Several dates can tie on the lowest price; badge only the earliest of them.
const bestDate = dates.find(d => (grid.get(d)?.get(defaultCode) ?? Infinity) === bestOverall);
---

<div class="sp">
  <div class="sp__airports" hidden={airports.length < 2}>
    <p class="sp__eyebrow">Flying from</p>
    <div class="sp__set" role="group" aria-label="Choose your departure airport">
      {airports.map(a => (
        <button
          type="button"
          class="sp__airport"
          data-airport={a.code}
          aria-pressed={a.code === defaultCode ? 'true' : 'false'}
        >
          <span class="sp__airport-name">{a.name}</span>
          <span class="sp__airport-from">from <b>{formatPrice(lowestFrom(a.code))}</b><span class="sp__pp"> per person</span></span>
        </button>
      ))}
    </div>
  </div>

  {needsFilters && (
    <div class="sp__filters">
      <p class="sp__eyebrow">When</p>
      <div class="sp__chips" role="group" aria-label="Filter sailings by month">
        <button type="button" class="sp__chip" data-month="all" aria-pressed="true">
          All dates <span>{dates.length}</span>
        </button>
        {months.map(m => (
          <button type="button" class="sp__chip" data-month={m.ym} aria-pressed="false">
            {m.label} <span>{m.n}</span>
          </button>
        ))}
      </div>
    </div>
  )}

  <div class="sp__table">
    {airports.length > 1 && (
      <p class="sp__from">
        Sailings flying from <b class="sp__for-airport">{airports.find(a => a.code === defaultCode)?.name}</b>
      </p>
    )}
    <div class="sp__head">
      <div>Departs</div><div>Nights</div><div>Ship</div>
      <div class="sp__ta-r">Per person</div><div></div>
    </div>

    {dates.map((date, i) => {
      const row = grid.get(date)!;
      // No flight from the default airport this week: say so on first paint
      // (before, another airport's fare was printed under that airport's name).
      const hasDefault = row.has(defaultCode);
      const base = row.get(defaultCode) ?? cheapestOf(row)[1];
      const [cheapCode, cheapPrice] = cheapestOf(row);
      const priceAttrs = Object.fromEntries(
        codes.filter(c => row.has(c)).map(c => [`data-price-${c}`, String(row.get(c))]),
      );
      return (
        <>
          <Row
            {...(hasCabins ? { href: `${cabinsHref}?date=${date}&airport=${defaultCode}` } : {})}
            class:list={['sp__row', { 'is-na': hasCabins && !hasDefault }]}
            id={`sail-${i}`}
            data-date={date}
            data-month={date.slice(0, 7)}
            hidden={needsFilters && i >= INITIAL_ROWS}
          >
            <span class="sp__date">
              {date === bestDate && <span class="sp__best">Best price</span>}
              {niceDate(date)}
              <span class="sp__sub">returns {returnOf(date, nightCount)}</span>
            </span>
            <span class="sp__nights">{nightCount} nights</span>
            <span class="sp__ship">{shipName && <b>{shipName}</b>}{routeLabel}</span>
            <span class:list={['sp__price', { 'is-na': !hasDefault }]}>
              <span class="sp__amt" {...priceAttrs}>{hasDefault ? formatPrice(base) : '—'}</span>
              <span class="sp__lab">{hasDefault ? 'per person' : `No flights from ${airports.find(a => a.code === defaultCode)?.name ?? defaultCode} this date`}</span>
              <span
                class="sp__cheaper"
                data-cheap-code={cheapCode}
                data-cheap-price={String(cheapPrice)}
                hidden={base - cheapPrice <= 0}
              >{formatPrice(base - cheapPrice)} less from {cheapCode}</span>
            </span>
            {hasCabins
              ? <span class="sp__cta">{hasDefault ? 'Choose this date ›' : 'Not this date'}</span>
              : (
                <span class="sp__ctas">
                  <button type="button" class="sp__enq" data-enq>Get a written quote ›</button>
                  <CallLink class="sp__cta" tel={tel} display={telDisplay} tapLabel="Call to book ›" readLabel={`Call ${telDisplay}`} />
                </span>
              )}
          </Row>

        </>
      );
    })}
    {needsFilters && (
      <button type="button" class="sp__more" data-shown={String(INITIAL_ROWS)}>
        Show all {dates.length} sailings
      </button>
    )}
  </div>
</div>

<script>
  // Progressive enhancement only: every price is already in the HTML as
  // data-price-CODE, so this swaps text rather than fetching or building anything.
  const root = document.querySelector('.sp');
  if (root instanceof HTMLElement) {
    const sp = root;
    const airportName = new Map<string, string>();
    sp.querySelectorAll<HTMLButtonElement>('.sp__airport').forEach(b => {
      airportName.set(b.dataset.airport || '', b.querySelector('.sp__airport-name')?.textContent || '');
    });

    const gbp = (n: number) => '£' + Math.round(n).toLocaleString('en-GB');

    function applyAirport(code: string) {
      sp.querySelectorAll<HTMLButtonElement>('.sp__airport').forEach(b =>
        b.setAttribute('aria-pressed', String(b.dataset.airport === code)),
      );
      // A sailing (or a cabin on it) with no flight price from this airport must not
      // keep showing the last airport's price as if it were this one's.
      sp.querySelectorAll<HTMLElement>('.sp__amt').forEach(el => {
        const v = el.getAttribute('data-price-' + code);
        const cell = el.closest<HTMLElement>('.sp__price');
        const lab = cell?.querySelector<HTMLElement>('.sp__lab');
        if (v) {
          el.textContent = gbp(Number(v));
          cell?.classList.remove('is-na');
          if (lab) lab.textContent = 'per person';
        } else {
          el.textContent = '—';
          cell?.classList.add('is-na');
          if (lab) lab.textContent = `No flights from ${airportName.get(code) || code} this date`;
        }
      });
      sp.querySelectorAll<HTMLElement>('.sp__row').forEach(rowEl => {
        const hint = rowEl.querySelector<HTMLElement>('.sp__cheaper');
        if (!hint) return;
        const here = rowEl.querySelector<HTMLElement>('.sp__price .sp__amt')?.getAttribute('data-price-' + code);
        const cheapCode = hint.dataset.cheapCode || '';
        const cheapPrice = Number(hint.dataset.cheapPrice || 0);
        if (!here || Number(here) - cheapPrice <= 0) { hint.hidden = true; return; }
        hint.hidden = false;
        hint.textContent = `${gbp(Number(here) - cheapPrice)} less from ${cheapCode}`;
      });
      sp.querySelectorAll<HTMLElement>('.sp__for-airport').forEach(el => {
        el.textContent = airportName.get(code) || '';
      });
      sp.querySelectorAll<HTMLAnchorElement>('a.sp__row').forEach(a => {
        const href = a.getAttribute('href') || '';
        a.setAttribute('href', href.replace(/([?&]airport=)[A-Z]{3}/, `$1${code}`));
        // A row with no flight from this airport is not a way into step two.
        const na = !a.querySelector<HTMLElement>('.sp__price .sp__amt')?.getAttribute('data-price-' + code);
        a.classList.toggle('is-na', na);
        a.setAttribute('aria-disabled', String(na));
        const cta = a.querySelector<HTMLElement>('.sp__cta');
        if (cta) cta.textContent = na ? 'Not this date' : 'Choose this date ›';
      });
    }
    sp.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.sp__row.is-na');
      if (a) e.preventDefault();
    });

    // On a phone the airport cards fill the screen, so a tap changed prices the
    // reader could not see. If the first row is below the fold, bring the list up.
    const table = sp.querySelector<HTMLElement>('.sp__table');
    sp.querySelectorAll<HTMLButtonElement>('.sp__airport').forEach(b => {
      b.addEventListener('click', () => {
        applyAirport(b.dataset.airport || '');
        const phone = window.matchMedia('(max-width: 940px)').matches;
        if (phone && table && table.getBoundingClientRect().top > window.innerHeight * 0.55) {
          table.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Month chips + show-more. Every row is already in the HTML; this only toggles.
    const moreBtn = sp.querySelector<HTMLButtonElement>('.sp__more');
    const INITIAL = 12;
    let month = 'all';
    let showAll = false;

    function applyRows() {
      const all = [...sp.querySelectorAll<HTMLElement>('.sp__row')];
      const matching = all.filter(r => month === 'all' || r.dataset.month === month);
      all.forEach(r => {
        const inMonth = month === 'all' || r.dataset.month === month;
        const capped = !showAll && matching.indexOf(r) >= INITIAL;
        r.hidden = !inMonth || capped;
        if (r.hidden) {
          r.setAttribute('aria-expanded', 'false');
          const pnl = document.getElementById(r.getAttribute('aria-controls') || '');
          if (pnl) pnl.hidden = true;
        }
      });
      if (moreBtn) {
        moreBtn.hidden = showAll || matching.length <= INITIAL;
        moreBtn.textContent = `Show all ${matching.length} sailings`;
      }
    }

    sp.querySelectorAll<HTMLButtonElement>('.sp__chip').forEach(chip => {
      chip.addEventListener('click', () => {
        month = chip.dataset.month || 'all';
        showAll = month !== 'all';
        sp.querySelectorAll<HTMLButtonElement>('.sp__chip').forEach(c =>
          c.setAttribute('aria-pressed', String(c === chip)));
        applyRows();
      });
    });
    moreBtn?.addEventListener('click', () => { showAll = true; applyRows(); });
    if (moreBtn) applyRows();

    // "Get a written quote": open the page's enquiry modal with the sailing the
    // reader was looking at (date, airport, ship, cabin, price) already filled in.
    // The modal and __openEnquiryModal live in the page ([slug].astro).
    const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const MONS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const niceDate = (iso: string) => {
      const d = new Date(`${iso}T00:00:00Z`);
      return isNaN(d.getTime()) ? iso : `${DAYS[d.getUTCDay()]} ${d.getUTCDate()} ${MONS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
    };
    sp.querySelectorAll<HTMLButtonElement>('.sp__enq').forEach(b => {
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = (window as any).__openEnquiryModal;
        if (typeof open !== 'function') return;
        const row = b.closest<HTMLElement>('.sp__row');
        const code = sp.querySelector<HTMLButtonElement>('.sp__airport[aria-pressed="true"]')?.dataset.airport || '';
        const shipEl = row?.querySelector<HTMLElement>('.sp__ship b');
        const ship = shipEl?.textContent?.trim() || '';
        const amt = row?.querySelector<HTMLElement>('.sp__amt')?.textContent?.trim();
        open({
          date: row?.dataset.date ? niceDate(row.dataset.date) : undefined,
          airport: airportName.get(code) || code || undefined,
          ship: ship || undefined,
          pricePp: amt ? amt.replace(/[^0-9.]/g, '') : undefined,
        });
      });
    });

    // (Cabins live on step two now; the rows are links and applyAirport keeps
    // their airport in step with the picker.)
  }
</script>

<style>
  .sp__eyebrow {
    margin: 0 0 8px;
    font-size: 14px; line-height: 24px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase; color: #0d6066;
  }
  .sp__airports { margin-bottom: 24px; }
  .sp__airports[hidden] { display: none; }
  /* A grid, not a wrapping flex row: with flex the lone airport on the last row grew
     to the full width (Bristol, five times the width of its siblings). */
  .sp__set { display: grid; grid-template-columns: repeat(auto-fill, minmax(196px, 1fr)); gap: 12px; }
  .sp__airport {
    text-align: left; font: inherit; color: inherit; cursor: pointer;
    background: #fff; border: 1px solid #d4dcde; border-radius: 2px; padding: 12px 16px;
    transition: border-color .12s ease, background-color .12s ease;
  }
  .sp__airport:hover { border-color: #20A1AA; }
  .sp__airport[aria-pressed='true'] {
    border-color: #20A1AA; background: #f0f9fa; box-shadow: inset 0 0 0 1px #20A1AA;
  }
  .sp__airport-name { display: block; font-size: 16px; font-weight: 500; color: #424242; }
  .sp__airport-from { display: block; margin-top: 2px; font-size: 16px; color: #424242; }
  .sp__airport-from b { font-weight: 700; }

  .sp__filters { margin-bottom: 16px; }
  .sp__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .sp__chip {
    font: inherit; font-size: 16px; color: #424242; cursor: pointer;
    background: #fff; border: 1px solid #d4dcde; border-radius: 2px; padding: 10px 14px; min-height: 44px;
  }
  .sp__chip span { color: #6b6b6b; font-size: 14px; margin-left: 4px; }
  .sp__chip:hover { border-color: #20A1AA; }
  .sp__chip[aria-pressed='true'] { background: #20A1AA; border-color: #20A1AA; color: #fff; }
  .sp__chip[aria-pressed='true'] span { color: #d0e8ea; }
  .sp__more {
    display: block; width: 100%; font: inherit; font-size: 16px; font-weight: 500;
    color: #0d6066; background: #f0f9fa; border: 0; border-top: 1px solid #e5e7eb;
    padding: 14px; cursor: pointer;
  }
  .sp__more:hover { background: #d0e8ea; }
  .sp__more[hidden] { display: none; }
  .sp__row[hidden] { display: none; }
  .sp__table { border: 1px solid #e5e7eb; border-radius: 2px; background: #fff; overflow: hidden; scroll-margin-top: 117px; }
  /* Phones only: the dark head row is hidden there, and this names the airport
     every price below is for — the airport cards have scrolled off by then. */
  .sp__from {
    display: none; margin: 0; padding: 12px 16px;
    background: #073140; color: #fff; font-size: 16px; line-height: 24px;
  }
  .sp__from b { font-weight: 700; color: #7fd6dc; }
  .sp__head, .sp__row {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) 84px minmax(0, 1fr) 150px 200px;
    gap: 16px; align-items: center; padding: 16px 24px;
  }
  .sp__head {
    background: #073140; color: #b9d5da;
    font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
    padding-block: 12px;
  }
  .sp__ta-r { text-align: right; }
  .sp__row {
    width: 100%; text-align: left; font: inherit; color: inherit;
    background: #fff; border: 0; border-top: 1px solid #e5e7eb;
    transition: background-color .12s ease;
  }
  .sp__row:first-of-type { border-top: 0; }
  button.sp__row, a.sp__row { cursor: pointer; }
  a.sp__row { text-decoration: none; }
  button.sp__row:hover, a.sp__row:hover { background: #f0f9fa; }
  a.sp__row:hover .sp__cta { background: #20A1AA; border-color: #20A1AA; color: #fff; }
  a.sp__row.is-na { cursor: default; }
  a.sp__row.is-na:hover { background: #fff; }
  a.sp__row.is-na .sp__cta, a.sp__row.is-na:hover .sp__cta { background: none; border-color: #d9b4b2; color: #8a3f3c; }
  .sp__row[aria-expanded='true'] { background: #d0e8ea; }
  .sp__row:focus-visible { outline: 3px solid #20A1AA; outline-offset: -3px; }
  .sp__date { display: block; font-size: 18px; font-weight: 500; color: #424242; }
  .sp__sub { display: block; font-size: 16px; font-weight: 400; color: #6b6b6b; }
  .sp__nights, .sp__ship { display: block; font-size: 16px; color: #424242; }
  .sp__ship b { display: block; font-weight: 500; }
  .sp__price { text-align: right; }
  .sp__price .sp__amt {
    display: block; font-family: CaslonGraphiqueEF, Georgia, serif;
    font-size: 28px; line-height: 1; color: #424242;
  }
  .sp__lab {
    display: block; font-size: 12px; line-height: 20px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b;
  }
  .sp__cheaper { display: block; margin-top: 2px; font-size: 16px; font-weight: 500; color: #0d6066; }
  /* A class with `display` beats the UA [hidden] rule, so restate it. */
  .sp__cheaper[hidden] { display: none; }
  .sp__best {
    display: block; width: max-content; margin-bottom: 4px;
    font-size: 12px; line-height: 20px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
    background: #0d6066; color: #fff; border-radius: 2px; padding: 1px 8px;
  }
  /* :global — the call variants are rendered by CallLink, outside this scope */
  :global(.sp__cta) {
    justify-self: end; white-space: nowrap;
    font-size: 16px; font-weight: 500; letter-spacing: 1px; color: #0d6066;
    border: 1px solid #20A1AA; border-radius: 2px; padding: 10px 14px;
  }
  .sp__row[aria-expanded='true'] .sp__cta { background: #20A1AA; border-color: #20A1AA; color: #fff; }
  :global(a.sp__cta) { text-decoration: none; }
  /* Desktop: the number as text, not a button that looks clickable */
  :global(.sp__cta.call-link--read) { border: 0; padding: 8px 0; color: #073140; font-size: 16px; letter-spacing: 0; }
  /* No-cabin rows: quote button over the call link, right-aligned like the CTA. */
  .sp__ctas { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; justify-self: end; }
  .sp__ctas :global(.sp__cta.call-link--read) { padding: 0; }
  .sp__enq {
    font: inherit; font-size: 16px; font-weight: 500; letter-spacing: 1px; white-space: nowrap; cursor: pointer;
    background: #ff7f00; color: #fff; border: 1px solid #ff7f00; border-radius: 2px; padding: 10px 14px;
    transition: background-color .2s;
  }
  .sp__enq:hover { background: #e67300; border-color: #e67300; }
  .sp__enq:focus-visible { outline: 3px solid #073140; outline-offset: 2px; }

  .is-na .sp__amt { color: #9aa7ab; }
  .is-na .sp__lab { text-transform: none; letter-spacing: 0; font-weight: 500; color: #8a3f3c; }

  @media (max-width: 940px) {
    .sp__head { display: none; }
    .sp__from { display: block; }
    .sp__row { grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; padding: 16px; }
    .sp__nights, .sp__ship { grid-column: 1; font-size: 16px; }
    .sp__price { grid-column: 2; grid-row: 1 / span 3; align-self: center; }
    :global(.sp__cta) { grid-column: 1 / -1; justify-self: stretch; text-align: center; margin-top: 8px; }
    .sp__ctas { grid-column: 1 / -1; justify-self: stretch; align-items: stretch; margin-top: 8px; }
    .sp__ctas .sp__enq, .sp__ctas :global(.sp__cta) { margin-top: 0; text-align: center; }
  }
  @media (max-width: 610px) {
    .sp__set { gap: 8px; }
    .sp__set { grid-template-columns: 1fr 1fr; }
    .sp__airport { padding: 10px 12px; }
    .sp__airport-name { font-size: 16px; }
    .sp__airport-from { font-size: 14px; }
    .sp__pp { display: none; }
  }
  @media (max-width: 450px) {
    .sp__date { font-size: 16px; }
    .sp__price .sp__amt { font-size: 24px; }
  }
</style>
