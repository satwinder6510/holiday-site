---
/**
 * River cruise detail page body.
 *
 * Replaces the shared package template for cruises. The package template asks
 * "which day do you want to fly?" — a flight calendar over every date of every
 * month. A river cruise has a handful of fixed sailings, and the decision is which
 * sailing, then which cabin on which deck, for a price that moves with the UK
 * airport. That is the order this page puts them in.
 *
 * Everything here renders server-side, including the collapsed cabin panels.
 */
import type { HolidayDetail } from '../../lib/holiday-transforms';
import type { HolidayPricing } from '../../lib/pricing-transforms';
import type { HolidayAddon, HolidayExcursion } from '../../lib/holidays-db';
import type { PortCall } from '../../lib/cruise-detail';
import type { SailingLadder } from '../../lib/cruise-detail';
import { splitStays } from '../../lib/cruise-detail';
import { imgSrc } from '../../lib/image-src';
import SailingPicker from './SailingPicker.astro';
import RouteMap from './RouteMap.astro';

interface Props {
  holiday: HolidayDetail;
  pricing: HolidayPricing | null;
  calls: PortCall[];
  ladders: SailingLadder[];
  shipNames: Set<string>;
  addons?: HolidayAddon[];
  excursions?: HolidayExcursion[];
}
const { holiday, pricing, calls, ladders, shipNames, addons = [], excursions = [] } = Astro.props;

const TEL_DISPLAY = '0208 183 0518';
const TEL_HREF = 'tel:+442081830518';

const nights = (() => {
  const m = holiday.duration.match(/(\d+)\s*Night/i);
  return m ? Number(m[1]) : 0;
})();

// Many offers are flight + hotel + cruise, and the accommodations list holds the
// HOTEL first and the ship second. Taking [0] as the ship put a Vienna hotel under
// a "Your ship" heading. The ships table decides which is which.
const { ships, hotels } = splitStays(holiday.accommodations, shipNames, holiday.shipName);
const shipCard = ships[0];
const shipName = holiday.shipName || shipCard?.name || '';
// A route can be sailed by more than one ship (City Hopping Netherlands runs two).
const shipHeading = ships.length > 1 ? 'Your ships' : 'Your ship';

// Where the hotel nights fall. Offers say so; hand-typed packages don't, and for
// those the old wording (which assumed pre-cruise) is left exactly as it was.
const hotelSides = new Set(hotels.map(h => h.when).filter(Boolean));
const hotelSide = hotelSides.size === 1 ? [...hotelSides][0] : null;
const hotelEyebrow = hotelSides.size === 0 || hotelSide === 'before'
  ? 'Before you board'
  : hotelSide === 'after'
    ? 'After you disembark'
    : 'Either side of the cruise';
const hotelGlanceLabel = hotelSides.size === 0 || hotelSide === 'before'
  ? (hotels.length > 1 ? 'Hotels before' : 'Hotel before')
  : hotelSide === 'after'
    ? (hotels.length > 1 ? 'Hotels after' : 'Hotel after')
    : 'Hotels';

// The route line: every port called at, in order, without repeating a berth.
const routePorts: string[] = [];
for (const c of calls) if (routePorts[routePorts.length - 1] !== c.port) routePorts.push(c.port);
const routeLabel = holiday.routeFrom && holiday.routeTo && holiday.routeFrom === holiday.routeTo
  ? `Round trip ${holiday.routeFrom}`
  : [holiday.routeFrom, holiday.routeTo].filter(Boolean).join(' to ');

const countryOf = (c: PortCall) => c.country || '';

const cabinImages = (holiday.cabinImages || []).map(u => imgSrc(u, 400));
/** Photos for a stay: the cruise export's cabin shots, else the accommodation's own. */
const stayPhotos = (acc: { images?: string[] } | undefined, fallback: string[] = []) => {
  const own = (acc?.images || []).filter(Boolean).map(u => imgSrc(u, 640));
  return own.length ? own : fallback;
};
const shipPhotos = stayPhotos(shipCard, cabinImages);
const heroImage = imgSrc(holiday.heroImage, 1600);

const BASIS_LABEL: Record<string, string> = {
  pp: 'pp',
  pp_per_day: 'pp per day',
  per_booking: 'per booking',
  per_cabin: 'per cabin',
};
/** "from £149pp", "£35pp per day", or "Price on application" when there's no figure. */
const addonPrice = (a: HolidayAddon) => {
  if (a.price == null) return 'Price on application';
  const amount = `£${a.price % 1 === 0 ? a.price.toFixed(0) : a.price.toFixed(2)}`;
  const basis = BASIS_LABEL[a.basis] ?? 'pp';
  return `${a.isFromPrice ? 'from ' : ''}${amount}${basis === 'pp' ? basis : ` ${basis}`}`;
};

/**
 * An excursion tied to a day belongs against that day and nowhere else (owner
 * 2026-09-21: it doesn't need two places). Only untagged ones — which have no
 * day to sit against — fall through to the add-ons section.
 */
const looseExcursions = excursions.filter(e => e.day == null);
/** Excursions grouped by the itinerary day they happen on. */
const excursionsByDay = new Map<number, HolidayExcursion[]>();
for (const e of excursions) {
  if (e.day == null) continue;
  const list = excursionsByDay.get(e.day) ?? [];
  list.push(e);
  excursionsByDay.set(e.day, list);
}
const dayNumber = (d: string | number) => {
  const n = Number(String(d).replace(/[^0-9]/g, ''));
  return Number.isFinite(n) ? n : -1;
};

const included = holiday.whatsIncluded.filter(Boolean);
const excluded = holiday.otherInfoBullets?.length
  ? holiday.otherInfoBullets
  : ['Travel insurance', 'Shore excursions', 'Personal expenses'];

const fromPrice = pricing?.cheapestPriceFormatted ?? '';
const fromAirport = pricing?.cheapestDeparture?.airportName ?? '';
const sailingCount = pricing ? new Set(pricing.departures.map(d => d.date.slice(0, 10))).size : 0;
const airportNames = (pricing?.airports ?? []).map(a => a.name);

/**
 * The Widgety feed round-trips some text through a bad encoding, so a curly
 * apostrophe arrives as "¿" — "Europe¿s Geniuses". Repair it between two letters,
 * which is the only place an inverted question mark can't legitimately be.
 */
const fixFeedText = (t: string) => (t || '').replace(/(\p{L})\u00bf(\p{L})/gu, '$1\u2019$2');

/**
 * Supplier overviews open with a promo block that repeats the sailings table
 * ("For the following departures:" + a date list) and carries a book-by date that
 * goes stale. Drop the duplicate list always, and the book-by line once it's past.
 */
function tidyOverview(html: string): string {
  let out = fixFeedText(html);
  out = out.replace(/<p>[^<]*for the following departures:?[^<]*<\/p>\s*<ul>[\s\S]*?<\/ul>/gi, '');
  out = out.replace(/<p>([^<]*book by\s+(\d{1,2}\s+\w+\s+\d{4})[^<]*)<\/p>/gi, (m, _t, date) => {
    const when = Date.parse(date);
    return Number.isFinite(when) && when < Date.now() ? '' : m;
  });
  return out.trim();
}
const overview = tidyOverview(holiday.overview || '');
---

<div class="cd">
  <!-- Hero -->
  <div class="cd-hero">
    <img class="cd-hero__img" src={heroImage} alt={`${shipName || holiday.title} on the ${holiday.destination}`}
         width="1600" height="900" fetchpriority="high" decoding="async" />
    <div class="cd-hero__body">
      <div class="section-container">
        <div class="cd-hero__text">
          <p class="cd-hero__kicker">{[holiday.operator, shipName].filter(Boolean).join(' · ')}</p>
          <h1>{fixFeedText(holiday.title)}</h1>
          {routePorts.length > 1 && (
            <p class="cd-hero__route">
              {routePorts.map((p, i) => (
                <>
                  {i > 0 && <i aria-hidden="true">›</i>}
                  <span class:list={{ 'is-end': i === 0 || i === routePorts.length - 1 }}>{p}</span>
                </>
              ))}
            </p>
          )}
        </div>
        {fromPrice && (
          <div class="cd-hero__price">
            <div>
              <p class="cd-lab">From</p>
              <p class="cd-hero__amt">{fromPrice} <span>pp</span></p>
              <p class="cd-hero__note">Flights{fromAirport ? ` from ${fromAirport}` : ''}, cruise and transfers</p>
            </div>
            <a class="cd-btn" href="#sailings">See sailings &amp; cabins</a>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- At a glance -->
  <div class="cd-glance">
    <dl class="section-container">
      {ships.length > 0 && (
        <div><dt>{ships.length > 1 ? 'Ships' : 'Ship'}</dt>
        <dd>{ships.map(sh => sh.name).join(' & ')}</dd></div>
      )}
      {hotels.length > 0 && (
        <div><dt>{hotelGlanceLabel}</dt>
        <dd>{hotels.map(h => h.name).join(', ')}</dd></div>
      )}
      {nights > 0 && <div><dt>Length</dt><dd>{nights} nights</dd></div>}
      {sailingCount > 0 && <div><dt>Sailings</dt><dd>{sailingCount} dates</dd></div>}
      {holiday.boardBasis && <div><dt>Dining</dt><dd>{holiday.boardBasis}</dd></div>}
      {airportNames.length > 0 && <div><dt>Flights from</dt><dd>{airportNames.join(', ')}</dd></div>}
    </dl>
  </div>

  <!-- What's included: directly under the glance strip, so the price and what
       it carries are read together before anyone picks a sailing. -->
  {(included.length > 0 || excluded.length > 0) && (
    <section class="cd-section" id="included">
      <div class="section-container">
        <div class="cd-split cd-split--wide">
          <div>
            <div class="cd-head">
              <p class="cd-eyebrow">In the price</p>
              <h2>What's included</h2>
            </div>
            {included.length > 0 && (
              <ul class="cd-ticks">
                {included.map(item => <li>{item}</li>)}
              </ul>
            )}
            {excluded.length > 0 && (
              <p class="cd-excl__lab">Not included</p>
            )}
            {excluded.length > 0 && (
              <ul class="cd-excl">
                {excluded.map(item => <li>{item}</li>)}
              </ul>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Add-ons. Featured only (owner 2026-09-21): the price is shown so nobody
       has to ring to find out what an excursion costs, and the booking itself
       still happens on the call. -->
  {(addons.length > 0 || looseExcursions.length > 0) && (
    <section class="cd-section cd-section--band" id="addons">
      <div class="section-container">
        <div class="cd-head">
          <p class="cd-eyebrow">On top of your fare</p>
          <h2>Add to your trip</h2>
        </div>
        {looseExcursions.length > 0 && (
          <p class="cd-addons__rule">Optional paid excursions — not included in your fare</p>
        )}
        {looseExcursions.length > 0 && (
          <ul class="cd-addons">
            {looseExcursions.map(e => (
              <li>
                <div class="cd-addons__text">
                  <h3>{e.name}</h3>
                  <p>
                    {e.day != null && <span class="cd-addons__where">Day {e.day}{e.port ? ` · ${e.port}` : ''}</span>}
                    {e.blurb}
                  </p>
                </div>
                <p class="cd-addons__price">{addonPrice(e)}</p>
              </li>
            ))}
          </ul>
        )}
        {addons.length > 0 && (
          <p class="cd-addons__rule">Optional paid extras — available on any sailing</p>
        )}
        <ul class="cd-addons">
          {addons.map(a => (
            <li>
              <div class="cd-addons__text">
                <h3>{a.name}</h3>
                {a.blurb && <p>{a.blurb}</p>}
              </div>
              <p class="cd-addons__price">{addonPrice(a)}</p>
            </li>
          ))}
        </ul>
        <p class="cd-addons__foot">
          Added to your booking when you call — <a href={TEL_HREF}>{TEL_DISPLAY}</a>
        </p>
      </div>
    </section>
  )}

  <!-- Sailings and cabins -->
  {pricing && (
    <section class="cd-section" id="sailings">
      <div class="section-container">
        <div class="cd-head">
          <p class="cd-eyebrow">Step one</p>
          <h2>Choose your sailing</h2>
          <p class="cd-prose">
            It's a fly-cruise, so the price moves with the airport you fly from &mdash; and the
            cheapest airport isn't the same one every week. Choose your airport, then a
            date{ladders.length > 0 ? ' to see the cabins on board' : ''}.
          </p>
        </div>
        <SailingPicker
          airports={pricing.airports}
          departures={pricing.departures}
          ladders={ladders}
          shipName={shipName}
          routeLabel={routeLabel}
          nights={nights}
          cabinImages={cabinImages}
          tel={TEL_HREF}
        />
      </div>
    </section>
  )}

  <!-- Route: port calls where we have them, else the holiday's own day list -->
  {calls.length === 0 && holiday.itinerary.length > 0 && (
    <section class="cd-section cd-section--band" id="itinerary">
      <div class="section-container">
        <div class="cd-head">
          <p class="cd-eyebrow">Your route</p>
          <h2>Day by day</h2>
        </div>
        <ol class="cd-days">
          {holiday.itinerary.map(d => (
            <li>
              <p class="cd-days__day">{d.day}</p>
              <div>
                <h3 class="cd-days__title">{d.title}</h3>
                {d.description && <div class="cd-prose" set:html={d.description} />}
                {(excursionsByDay.get(dayNumber(d.day)) ?? []).map(e => (
                  <p class="cd-days__exc">
                    <span class="cd-days__exc-lab">Optional paid excursion</span>
                    <b>{e.name}</b> {addonPrice(e)}
                    {e.blurb && <span class="cd-days__exc-blurb">{e.blurb}</span>}
                  </p>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
  {calls.length > 0 && (
    <section class="cd-section cd-section--band" id="itinerary">
      <div class="section-container">
        <div class="cd-head">
          <p class="cd-eyebrow">Your route</p>
          <h2>{calls.length} calls over {nights + 1} days</h2>
          <p class="cd-prose">Where the ship ties up, and for how long.</p>
        </div>

        <RouteMap calls={calls} routeLabel={routePorts.join(', ')} />

        <div class="cd-calls">
          <table>
            <thead>
              <tr>
                <th scope="col">Day</th>
                <th scope="col">Port</th>
                <th scope="col">Country</th>
                <th scope="col" class="cd-r">Arrive</th>
                <th scope="col" class="cd-r">Depart</th>
              </tr>
            </thead>
            <tbody>
              {calls.map((c, i) => {
                const last = i === calls.length - 1;
                return (
                  <tr class:list={{ 'is-night': c.overnight && !last }}>
                    <th scope="row">Day {c.day}</th>
                    <td><b>{c.port}</b></td>
                    <td>{countryOf(c)}</td>
                    <td class="cd-r">{i === 0 ? 'Embark' : (c.arrival || '—')}</td>
                    <td class="cd-r">{last ? 'Disembark' : (c.departure || '—')}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- Ship(s) -->
  {ships.length > 0 && (
    <section class="cd-section" id="ship">
      <div class="section-container">
        <div class="cd-head">
          <p class="cd-eyebrow">On board</p>
          <h2>{shipHeading}</h2>
          {ships.length > 1 && (
            <p class="cd-prose">This route is sailed by more than one ship depending on the date.</p>
          )}
        </div>
        {ships.map(sh => {
          const photos = stayPhotos(sh, cabinImages);
          return (
            <div class:list={['cd-stay', { 'cd-stay--solo': photos.length === 0 }]}>
              <div>
                <h3 class="cd-stay__name">{sh.name}</h3>
                {sh.description && <div class="cd-prose" set:html={sh.description} />}
              </div>
              {photos.length > 0 && (
                <div class="cd-shots">
                  {photos.slice(0, 5).map(src => (
                    <figure>
                      <img src={src} alt={`On board the ${sh.name}`} loading="lazy"
                           decoding="async" width="640" height="427" />
                    </figure>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- Hotel nights, where the trip includes them -->
  {hotels.length > 0 && (
    <section class="cd-section" id="hotels">
      <div class="section-container">
        <div class="cd-head">
          <p class="cd-eyebrow">{hotelEyebrow}</p>
          <h2>{hotels.length > 1 ? 'Your hotels' : 'Your hotel'}</h2>
        </div>
        <ul class="cd-hotels">
          {hotels.map(h => (
            <li>
              {stayPhotos(h).length > 0 && (
                <div class="cd-hotels__shots">
                  {stayPhotos(h).slice(0, 5).map(src => (
                    <img src={src} alt={h.name} loading="lazy" decoding="async"
                         width="640" height="427" />
                  ))}
                </div>
              )}
              <div>
                <h3 class="cd-hotels__name">{h.name}{h.stars ? <span class="cd-hotels__stars">{'\u2605'.repeat(h.stars)}</span> : null}</h3>
                {h.description && <div class="cd-prose" set:html={h.description} />}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Overview. What's included used to share this row; the owner moved it to
       the top of the page (2026-09-21) — what the price carries shouldn't be
       the last thing you read. The background reading stays down here. -->
  {overview && (
    <section class="cd-section cd-section--band" id="overview">
      <div class="section-container">
        <div class="cd-split cd-split--solo">
          <div>
            <div class="cd-head">
              <p class="cd-eyebrow">About this cruise</p>
              <h2>{holiday.destination}</h2>
            </div>
            <div class="cd-prose cd-overview" set:html={overview} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Talk to us -->
  <div class="cd-call">
    <div class="section-container">
      <h2>Talk to a cruise expert</h2>
      <p>Rivers, ships, cabins and dates. One call sorts the flights, transfers and the cabin you want.</p>
      <a class="cd-call__no" href={TEL_HREF}>{TEL_DISPLAY}</a>
      <p class="cd-call__hrs">Lines open 9am to 6pm</p>
    </div>
  </div>
</div>

<style>
  /* The site's own scale: body 18/29.25, prose 14/26, h1 48/50, h2 40/42. */
  .cd h1 { font-family: CaslonGraphiqueEF, Georgia, serif; font-size: 48px; line-height: 50px; font-weight: 400; margin: 8px 0 0; color: #fff; }
  .cd h2 { font-family: CaslonGraphiqueEF, Georgia, serif; font-size: 40px; line-height: 42px; letter-spacing: -.5px; font-weight: 400; margin: 0; color: #424242; }
  .cd-prose { font-size: 14px; line-height: 26px; color: #000; }
  .cd-prose :global(p) { margin: 0 0 16px; }
  .cd-prose :global(p:last-child) { margin-bottom: 0; }
  .cd-eyebrow {
    margin: 0 0 8px; font-size: 14px; line-height: 24px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase; color: #0d6066;
  }
  .cd-lab { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; }
  .cd-head { max-width: 60ch; margin-bottom: 32px; }
  .cd-head .cd-prose { margin-top: 12px; }
  .cd-section { padding-block: 64px; }
  .cd-section--band { background: #f2f5f6; border-block: 1px solid #e5e7eb; }
  /* Two plain sections in a row (included + sailings, ship + hotels) merged into
     one 128px void with nothing between them. A hairline gives the same rhythm
     the band edges do. */
  .cd-section:not(.cd-section--band) + .cd-section:not(.cd-section--band) { border-top: 1px solid #e5e7eb; }
  .cd-split { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .cd-split--solo { grid-template-columns: minmax(0, 75ch); }
  /* A tick list isn't prose: at 75ch it stopped short of the full-width sailings
     table below, leaving the page's right edge ragged. */
  .cd-split--wide { grid-template-columns: minmax(0, 92ch); }

  .cd-btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 500; letter-spacing: 1px;
    background: #ff7f00; color: #fff; border: 0; border-radius: 2px;
    padding: 14px 26px; text-decoration: none;
    box-shadow: 0 6px 14px rgba(7, 49, 64, .18);
    transition: background-color .2s;
  }
  .cd-btn:hover { background: #e67300; }

  /* Hero */
  .cd-hero { position: relative; background: #073140; }
  /* Same height as the holiday detail hero (owner 2026-09-08: a fixed short
     hero was a letterbox on wide screens). Keep the two in step. */
  .cd-hero__img { display: block; width: 100%; height: clamp(500px, 40vw, 760px); object-fit: cover; opacity: .9; }
  .cd-hero__body {
    position: absolute; inset: auto 0 0 0;
    background: linear-gradient(to top, rgba(7, 32, 41, .94) 10%, rgba(7, 32, 41, .5) 65%, rgba(7, 32, 41, 0));
    padding-block: 64px 24px;
  }
  .cd-hero__body .section-container { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cd-hero__text { color: #fff; max-width: 40ch; }
  .cd-hero__kicker { margin: 0; font-size: 14px; line-height: 24px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: #9ad5db; }
  .cd-hero__route { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin: 16px 0 0; font-size: 16px; color: #cfe3e6; }
  .cd-hero__route .is-end { font-weight: 600; color: #fff; }
  .cd-hero__route i { font-style: normal; color: #6aaeb7; }
  .cd-hero__price {
    display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
    background: rgba(255, 255, 255, .97); border-radius: 2px; padding: 16px 24px;
    box-shadow: 0 1px 2px rgba(7, 49, 64, .07), 0 10px 28px rgba(7, 49, 64, .09);
  }
  .cd-hero__amt { margin: 0; font-family: CaslonGraphiqueEF, Georgia, serif; font-size: 40px; line-height: 40px; color: #424242; }
  .cd-hero__amt span { font-family: BentonSans, 'Helvetica Neue', Arial, sans-serif; font-size: 14px; font-weight: 500; }
  .cd-hero__note { margin: 4px 0 0; font-size: 14px; color: #6b6b6b; }

  /* At a glance */
  .cd-glance { background: #f0f9fa; border-bottom: 1px solid #e5e7eb; }
  /* margin-BLOCK, not the shorthand: `margin: 0` here also zeroed the
     margin-inline:auto that .section-container relies on, so above 1240px the
     strip pinned to the left window edge while every other band stayed centred. */
  .cd-glance dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 24px; padding-block: 16px; margin-block: 0; }
  .cd-glance dt { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #20A1AA; }
  .cd-glance dd { margin: 4px 0 0; font-size: 16px; font-weight: 500; color: #424242; }

  /* Port calls */
  .cd-calls { margin-top: 32px; border: 1px solid #e5e7eb; border-radius: 2px; background: #fff; overflow-x: auto; }
  .cd-calls table { width: 100%; border-collapse: collapse; }
  .cd-calls th, .cd-calls td { padding: 12px 16px; text-align: left; font-size: 16px; color: #424242; }
