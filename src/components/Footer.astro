---
import { footerDestinations, footerCollections, footerUsefulLinks, contactInfo, disclaimer } from '../data/footer';
---

<footer class="footer-wrap text-white">
  <div class="section-container relative">
    <!-- Navigation Columns -->
    <div class="footer-nav flex justify-between">
      <!-- Destinations -->
      <div class="footer-col footer-lhs">
        <div class="footer-accordion-header flex items-center justify-between" data-accordion="destinations">
          <h3 class="footer-heading font-display text-white">Destinations</h3>
          <img src="/icons/dropdown-icon.svg" alt="" class="w-3 h-3 transition-transform footer-accordion-icon brightness-0 invert" />
        </div>
        <ul class="footer-accordion-content footer-links footer-links--two-col">
          {footerDestinations.map((item) => (
            <li>
              <a href={item.href} class="text-white/70 hover:text-primary transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Collections -->
      <div class="footer-col footer-mid">
        <div class="footer-accordion-header flex items-center justify-between" data-accordion="collections">
          <h3 class="footer-heading font-display text-white">Collections</h3>
          <img src="/icons/dropdown-icon.svg" alt="" class="w-3 h-3 transition-transform footer-accordion-icon brightness-0 invert" />
        </div>
        <ul class="footer-accordion-content footer-links footer-links--two-col">
          {footerCollections.map((item) => (
            <li>
              <a href={item.href} class="text-white/70 hover:text-primary transition-colors">
                {item.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/collections" class="text-primary font-medium underline">View All</a>
          </li>
        </ul>
      </div>

      <!-- Useful Links -->
      <div class="footer-col footer-rhs">
        <div class="footer-accordion-header flex items-center justify-between" data-accordion="useful">
          <h3 class="footer-heading font-display text-white">Useful Links</h3>
          <img src="/icons/dropdown-icon.svg" alt="" class="w-3 h-3 transition-transform footer-accordion-icon brightness-0 invert" />
        </div>
        <ul class="footer-accordion-content footer-links">
          {footerUsefulLinks.map((item) => (
            <li>
              <a href={item.href} class="text-white/70 hover:text-primary transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Contact & Legal -->
    <div class="footer-contacts">
      <div class="footer-contact-wrap">
        <a href={`tel:${contactInfo.phone.replace(/\s/g, '')}`} class="footer-phone flex items-center gap-2 text-white hover:text-primary transition-colors whitespace-nowrap">
          <img src="/icons/phone-icon.svg" alt="" class="w-4 h-4 brightness-0 invert flex-shrink-0" />
          <span class="font-bold">{contactInfo.phone}</span>
        </a>
        <a href={`mailto:${contactInfo.email}`} class="footer-email-link flex items-center gap-2 text-white/70 hover:text-primary transition-colors text-sm">
          <img src="/icons/email-icon.svg" alt="" class="w-4 h-4 brightness-0 invert" />
          <span class="footer-email-text">{contactInfo.email}</span>
        </a>
      </div>
      <div class="footer-legal">
        <img src="/images/atol.png" alt="ATOL Protected" class="h-12" width="48" height="48" />
        <img src="/images/clia-logo.png" alt="CLIA Member" class="h-12" width="48" height="48" />
        <img src="/images/travel-trust.png" alt="Travel Trust" class="h-12" width="48" height="48" />
      </div>
    </div>

    <!-- Agent Reference Search -->
    <div class="ref-search">
      <form id="ref-search-form" class="ref-search__form">
        <label for="ref-input" class="ref-search__label">Agent reference lookup</label>
        <div class="ref-search__row">
          <input id="ref-input" type="text" inputmode="numeric" pattern="[0-9]*" placeholder="Enter reference number" class="ref-search__input" required />
          <button type="submit" class="ref-search__btn">Go</button>
        </div>
      </form>
    </div>

    <!-- Disclaimer -->
    <p class="footer-disclaimer">{disclaimer}</p>

    <!-- Copyright -->
    <div class="footer-copyright text-center text-white">
      &copy; Flights and Packages {new Date().getFullYear()}
    </div>

    <!-- Return to top -->
    <button
      type="button"
      id="return-to-top"
      class="return-top hidden md:flex flex-col items-center gap-1 text-white/50 hover:text-white transition-colors cursor-pointer absolute"
    >
      <img src="/icons/return-top-icon.svg" alt="" class="w-5 h-5 brightness-0 invert" />
      <span class="text-xs">Return to top</span>
    </button>
  </div>
</footer>

<style>
  .footer-wrap {
    background-color: #000000;
    padding-top: 80px;
  }
  @media (max-width: 760px) { .footer-wrap { padding-top: 40px; } }
  @media (max-width: 450px) { .footer-wrap { padding-top: 20px; } }
  @media (max-width: 350px) { .footer-wrap { padding-top: 0px; } }

  .footer-heading {
    font-size: 24px;
  }

  .footer-nav {
    gap: 0;
  }

  .footer-col {
    flex: 1;
    min-width: 0;
  }
  .footer-lhs {
    flex: 2;
  }
  .footer-mid {
    flex: 2;
    position: relative;
    margin-left: 100px;
    padding-left: 145px;
    border-left: 1px solid rgba(255,255,255,0.15);
  }
  .footer-rhs {
    position: relative;
    padding-left: 145px;
    border-left: 1px solid rgba(255,255,255,0.15);
  }
  @media (max-width: 1260px) {
    .footer-mid { margin-left: 60px; padding-left: 100px; }
    .footer-rhs { padding-left: 100px; }
  }
  @media (max-width: 1100px) {
    .footer-mid { margin-left: 30px; padding-left: 67px; }
    .footer-rhs { padding-left: 67px; }
  }
  @media (max-width: 940px) {
    .footer-mid { margin-left: 10px; padding-left: 35px; }
    .footer-rhs { padding-left: 35px; }
  }
  @media (max-width: 760px) {
    .footer-nav {
      flex-direction: column;
      align-items: center;
    }
    .footer-col {
      flex: none;
      width: 365px;
      max-width: 100%;
    }
    .footer-lhs, .footer-mid {
      border-bottom: 1px solid rgba(255,255,255,0.3);
    }
    .footer-mid, .footer-rhs {
      margin-left: 0;
      padding-left: 0;
      border-left: none;
    }
    .footer-accordion-header {
      padding-top: 10px;
      padding-bottom: 10px;
    }
  }
  @media (max-width: 394px) {
    .footer-col { width: 335px; }
  }
  @media (max-width: 350px) {
    .footer-col { width: 290px; }
  }

  .footer-email-text {
    word-break: break-all;
  }

  /* Accordion display — desktop: visible, mobile: hidden (toggled by JS) */
  .footer-accordion-content {
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
  }
  .footer-links--two-col {
    flex-direction: row;
  }
  .footer-links--two-col li {
    width: 50%;
  }
  .footer-accordion-icon {
    display: none;
  }
  .footer-accordion-header {
    cursor: default;
  }
  @media (max-width: 760px) {
    .footer-accordion-content {
      display: none;
    }
    .footer-accordion-content.open {
      display: flex;
    }
    .footer-links--two-col li {
      width: 100%;
    }
    .footer-accordion-icon {
      display: block;
    }
    .footer-accordion-header {
      cursor: pointer;
    }
  }

  .footer-links {
    margin-top: 45px;
    height: 210px;
  }
  @media (max-width: 760px) {
    .footer-links {
      margin-top: 0;
      height: auto;
    }
  }

  .footer-links li {
    font-size: 14px;
    line-height: 34px;
  }

  /* Contact & Legal */
  .footer-contacts {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 90px;
  }
  @media (max-width: 940px) {
    .footer-contacts {
      flex-direction: column;
      margin-top: 50px;
    }
  }
  @media (max-width: 760px) {
    .footer-contacts { margin-top: 40px; }
  }
  .footer-contact-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 40px;
  }
  @media (max-width: 760px) {
    .footer-contact-wrap {
      flex-direction: column;
      align-items: flex-start;
      width: 365px;
      max-width: 100%;
    }
  }
  @media (max-width: 394px) {
    .footer-contact-wrap { width: 335px; }
  }
  @media (max-width: 350px) {
    .footer-contact-wrap { width: 290px; }
  }
  .footer-phone, .footer-email-link {
    padding-top: 4px;
    padding-bottom: 4px;
  }
  .footer-legal {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .footer-legal img {
    height: 48px;
    width: auto;
  }
  @media (max-width: 940px) {
    .footer-legal { padding-top: 10px; }
  }

  .footer-disclaimer {
    font-size: 9px !important;
    line-height: 14px !important;
    color: rgba(255,255,255,0.5) !important;
    margin-top: 65px;
  }
  @media (max-width: 940px) { .footer-disclaimer { margin-top: 35px; } }
  @media (max-width: 760px) { .footer-disclaimer { text-align: center; } }

  .footer-copyright {
    font-size: 14px;
    margin-bottom: 70px;
  }
  @media (max-width: 760px) { .footer-copyright { margin-bottom: 30px; } }

  .ref-search {
    margin-top: 40px;
    padding-top: 30px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  @media (max-width: 760px) {
    .ref-search { text-align: center; }
    .ref-search__row { margin-left: auto; margin-right: auto; }
  }
  .ref-search__label {
    font-family: "BentonSans", sans-serif;
    font-size: 11px;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 8px;
  }
  .ref-search__row {
    display: flex;
    gap: 8px;
    max-width: 280px;
  }
  .ref-search__input {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 4px;
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-family: "BentonSans", sans-serif;
    font-size: 14px;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }
  .ref-search__input::placeholder { color: rgba(255,255,255,0.3); }
  .ref-search__input:focus { border-color: #20A1AA; }
  .ref-search__btn {
    padding: 8px 18px;
    background: #20A1AA;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-family: "BentonSansMedium", sans-serif;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .ref-search__btn:hover { background: #1a8a92; }

  .return-top {
    right: -125px;
    top: 0;
  }
  @media (max-width: 1530px) { .return-top { position: static; } }
</style>

<script>
  // Footer accordion (mobile)
  document.querySelectorAll('.footer-accordion-header').forEach((header) => {
    header.addEventListener('click', () => {
      if (window.innerWidth >= 760) return;
      const content = header.nextElementSibling as HTMLElement;
      const icon = header.querySelector('.footer-accordion-icon') as HTMLElement;
      if (content) {
        content.classList.toggle('open');
      }
      if (icon) {
        icon.classList.toggle('rotate-180');
      }
    });
  });

  // Return to top
  document.getElementById('return-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Reference lookup
  document.getElementById('ref-search-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('ref-input') as HTMLInputElement;
    const id = input.value.trim();
    if (id) window.location.href = `/api/ref?id=${encodeURIComponent(id)}`;
  });
</script>
