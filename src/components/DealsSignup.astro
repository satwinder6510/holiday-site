---
// "Email me deals" — one email box, our own form (2026-11-25). Shows at once on a
// phone (no Spotler scripts); POSTs to /api/deals-signup. Used inline on a page
// and inside the phone call bar's sheet (MobileCallCTA emailDeals). Any number of
// copies can sit on one page: the script binds every form[data-deals-signup].
interface Props { title?: string; desc?: string; where: string; variant?: 'band' | 'sheet' }
const { title = 'Get our deals by email', desc = 'Our members hear about cruise offers before anyone else.', where, variant = 'band' } = Astro.props;
---
<div class={`ds ds-${variant}`}>
  <p class="ds-title">{title}</p>
  <p class="ds-desc">{desc}</p>
  <form class="ds-form" data-deals-signup data-where={where} novalidate>
    <label class="ds-label">
      <span class="sr-only">Email address</span>
      <input type="email" name="email" autocomplete="email" inputmode="email" placeholder="Your email address" required maxlength="200" />
    </label>
    <input type="text" name="company" tabindex="-1" autocomplete="off" class="ds-hp" aria-hidden="true" />
    <button type="submit">Email me deals</button>
    <p class="ds-msg" role="status" aria-live="polite"></p>
    <p class="ds-small">Unsubscribe any time. See our <a href="/privacy-policy">privacy policy</a>.</p>
  </form>
</div>

<script is:inline>
  (function () {
    if (window.__dealsSignupBound) return;
    window.__dealsSignupBound = true;
    var RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    document.addEventListener('submit', function (e) {
      var form = e.target;
      if (!form || !form.matches || !form.matches('form[data-deals-signup]')) return;
      e.preventDefault();
      var input = form.querySelector('input[name=email]');
      var btn = form.querySelector('button');
      var msg = form.querySelector('.ds-msg');
      var email = (input.value || '').trim();
      if (!RE.test(email)) { msg.textContent = 'Please check your email address.'; msg.className = 'ds-msg ds-err'; input.focus(); return; }
      btn.disabled = true; msg.textContent = ''; msg.className = 'ds-msg';
      var src = 'Direct';
      try { src = sessionStorage.getItem('lead_source') || 'Direct'; } catch (_) {}
      fetch('/api/deals-signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, company: form.querySelector('.ds-hp').value, where: form.getAttribute('data-where') || '', source: src, page_url: location.pathname })
      }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          if (!res.ok) throw new Error((res.d && res.d.error) || 'failed');
          // Every copy on the page shows the thank-you, so the sheet and the band agree.
          document.querySelectorAll('form[data-deals-signup]').forEach(function (f) {
            f.innerHTML = '<p class="ds-done">Thank you. You are on the list for our deals.</p>';
          });
          try { if (window.posthog) window.posthog.capture('deals_signup', { where: form.getAttribute('data-where') || '' }); } catch (_) {}
        })
        .catch(function (err) {
          btn.disabled = false;
          msg.textContent = err && err.message && err.message !== 'failed' ? err.message + '.' : 'Sorry, that did not go through. Please try again.';
          msg.className = 'ds-msg ds-err';
        });
    });
  })();
</script>

<style is:global>
  .ds { text-align: center; }
  .ds-title { margin: 0 0 6px; font-family: BentonSans, sans-serif; font-weight: 700; font-size: 24px; line-height: 30px; color: #073140; }
  .ds-desc { margin: 0 0 16px; font-size: 17px; line-height: 24px; color: #424242; }
  .ds-form { max-width: 460px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
  .ds-form input[type=email] { width: 100%; box-sizing: border-box; height: 52px; padding: 0 14px; border: 1px solid #b9c4c8; border-radius: 4px; font-size: 17px; color: #222; background: #fff; }
  .ds-form input[type=email]:focus { outline: none; border-color: #20A1AA; box-shadow: 0 0 0 3px rgba(32,161,170,.2); }
  .ds-form button { height: 52px; border: 0; border-radius: 4px; background: #ff7f00; color: #fff; font-size: 18px; font-weight: 700; font-family: BentonSans, sans-serif; cursor: pointer; }
  .ds-form button:disabled { opacity: .6; cursor: default; }
  .ds-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .ds-msg { margin: 0; min-height: 0; font-size: 15px; }
  .ds-msg:empty { display: none; }
  .ds-err { color: #b3261e; }
  .ds-small { margin: 0; font-size: 14px; color: #666; }
  .ds-small a { color: inherit; text-decoration: underline; }
  .ds-done { margin: 0; padding: 14px; background: #e8f6f7; border: 1px solid #20A1AA; border-radius: 4px; color: #073140; font-size: 17px; font-weight: 600; }
  .ds-band { background: #f2f7f8; padding: 36px 16px; }
  .ds-sheet .ds-title { font-size: 22px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (min-width: 768px) {
    .ds-band .ds-form { flex-direction: row; flex-wrap: wrap; justify-content: center; }
    .ds-band .ds-form label { flex: 1 1 260px; }
    .ds-band .ds-form button { flex: 0 0 auto; padding: 0 28px; }
    .ds-band .ds-msg, .ds-band .ds-small { flex-basis: 100%; }
  }
</style>
