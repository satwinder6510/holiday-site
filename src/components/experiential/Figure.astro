---
// Renders one MediaSlot as an image, video, or labelled placeholder.
// The placeholder shows what to drop in and the intended path, so the
// edit→preview loop is self-documenting. Every variant keeps the slot's
// aspect ratio so swapping media never shifts the layout.
import type { MediaSlot } from '../../data/experiences';

interface Props {
  slot: MediaSlot;
  /** Eager-load the hero; lazy-load everything below the fold. */
  priority?: boolean;
}

const { slot, priority = false } = Astro.props;
const ar = slot.ar;
const isHeroVideo = slot.kind === 'video' && slot.ambient;
---

{slot.kind === 'placeholder' && (
  <figure class="shot shot--placeholder" style={`--ar:${ar}`} aria-hidden="true">
    <div class="ph-inner">
      <span class="ph-icon">▦</span>
      <span class="ph-label">{slot.label}</span>
      {slot.src && <code class="ph-path">{slot.src}</code>}
      {(slot.mp4 || slot.webm) && <code class="ph-path">{slot.mp4 || slot.webm}</code>}
      <span class="ph-ar">{ar}</span>
    </div>
  </figure>
)}

{slot.kind === 'image' && (
  <figure class="shot" style={`--ar:${ar}`}>
    <img
      src={slot.src}
      alt={slot.alt || ''}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
    />
  </figure>
)}

{slot.kind === 'video' && isHeroVideo && (slot.hls || slot.mp4 || slot.webm) && (
  <figure class="shot" style={ar ? `--ar:${ar}` : undefined}>
    <video
      class="hero-video"
      autoplay muted loop playsinline preload="metadata"
      poster={slot.src}
      data-hls={slot.hls || undefined}
    >
      {slot.webm && <source src={slot.webm} type="video/webm" />}
      {slot.mp4 && <source src={slot.mp4} type="video/mp4" />}
    </video>
  </figure>
)}

{/* Hero declared as video but no source yet (e.g. Stream URL not filled in) →
    show the poster as a static image so the live hero never breaks. */}
{slot.kind === 'video' && isHeroVideo && !(slot.hls || slot.mp4 || slot.webm) && slot.src && (
  <figure class="shot" style={ar ? `--ar:${ar}` : undefined}>
    <img
      src={slot.src}
      alt={slot.alt || ''}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
    />
  </figure>
)}

{slot.kind === 'video' && !isHeroVideo && (
  <figure class="shot shot--video" style={`--ar:${ar}`}>
    <video controls preload="none" playsinline poster={slot.src} aria-label={slot.alt || slot.label}>
      {slot.webm && <source src={slot.webm} type="video/webm" />}
      {slot.mp4 && <source src={slot.mp4} type="video/mp4" />}
    </video>
  </figure>
)}

<style>
  .shot {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ar, 4 / 3);
    overflow: hidden;
    border-radius: 10px;
    background: #eef1f0;
  }
  .shot img,
  .shot video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shot--video {
    cursor: pointer;
  }

  /* Placeholder — clearly a slot to fill, on-brand teal dashed frame */
  .shot--placeholder {
    background:
      repeating-linear-gradient(45deg, #f3f7f7 0 12px, #eef3f3 12px 24px);
    border: 2px dashed #20A1AA;
  }
  .ph-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    text-align: center;
  }
  .ph-icon {
    font-size: 28px;
    line-height: 1;
    color: #20A1AA;
    opacity: 0.7;
  }
  .ph-label {
    font-family: 'BentonSans', sans-serif;
    font-weight: 700;
    font-size: 13px;
    line-height: 18px;
    color: #177D85;
    max-width: 36ch;
  }
  .ph-path {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: #6a7b7c;
    background: rgba(255, 255, 255, 0.7);
    padding: 2px 6px;
    border-radius: 4px;
    word-break: break-all;
    max-width: 90%;
  }
  .ph-ar {
    font-family: 'BentonSans', sans-serif;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #9aa7a7;
  }
</style>
