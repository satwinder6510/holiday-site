<section class="newsletter-section">
  <div class="newsletter-bg"></div>
  <div class="section-container">
    <div class="newsletter">
      <div class="newsletter-text">
        <div class="newsletter-title">Subscribe to our newsletter</div>
        <span class="newsletter-desc">Get our latest news and offers delivered right to your inbox</span>
      </div>
      <div class="newsletter-form-mount">
        <!-- Spotler Mail+ dynamic sign-up form renders here -->
        <div id="mpform1302"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Lazy-load the Spotler Mail+ form only when the newsletter scrolls into view,
  // so jQuery / jQuery UI (~300KB) don't load on every page upfront.
  (function () {
    var mount = document.getElementById('mpform1302');
    if (!mount) return;
    var started = false;

    function addCss(href) {
      var l = document.createElement('link');
      l.rel = 'stylesheet';
      l.type = 'text/css';
      l.href = href;
      document.head.appendChild(l);
    }

    function addScript(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = src;
        s.async = false; // keep execution order
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    function loadSpotler() {
      if (started) return;
      started = true;
      addCss('https://static.mailplus.nl/jq/ui/jquery-ui-1.13.2.custom.min.css');
      addScript('https://static.mailplus.nl/jq/jquery-3.6.0.min.js')
        .then(function () { return addScript('https://static.mailplus.nl/jq/jquery.validate.1.19.5.min.js'); })
        .then(function () { return addScript('https://static.mailplus.nl/jq/ui/jquery-ui-1.13.2.custom.min.js'); })
        .then(function () { return addScript('https://m4.mailplus.nl/genericservice/code/servlet/React?command=getFormJs&uid=503101206&feid=hbErRHprFNaN2U6ekmPx&p=https&om=d&of=x&c=1&jq=3'); })
        .then(function () {
          // Spotler's loader normally self-initialises on the window 'load' event.
          // Because we lazy-load it on scroll (after 'load' has already fired),
          // that listener never runs — so trigger its init manually. The init
          // function name derives from the mount id: mpform1302 -> initShowHideform1302.
          var formId = mount.id.replace(/^mp/, '');
          var initFn = window['initShowHide' + formId];
          if (typeof initFn === 'function') {
            initFn();
          } else {
            window.dispatchEvent(new Event('load'));
          }
        })
        .catch(function (e) { console.error('[Spotler] sign-up form failed to load', e); });
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { loadSpotler(); io.disconnect(); }
        });
      }, { rootMargin: '300px' });
      io.observe(mount);
    } else {
      loadSpotler();
    }
  })();
</script>

