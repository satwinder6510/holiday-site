---
// Experiential blog layout — full-bleed, long-form storytelling.
// Brand-matched: BentonSans body, CaslonGraphiqueEF display, teal #20A1AA,
// CTA orange #ff7f00, navy #073140. Composes the site Header/Footer so it is
// unmistakably Flights and Packages — it does NOT fork the product template.
//
// Section order: header → breadcrumb → hero → bookable strip → intro →
// at-a-glance → journey (chapters, alternating media) → gallery → teal CTA →
// related posts → footer.
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import MobileCallCTA from '../components/MobileCallCTA.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import Figure from '../components/experiential/Figure.astro';
import CruisePricingCalendar from '../components/experiential/CruisePricingCalendar.astro';
import { allBlogs } from '../data/blogs';
import type { Experience } from '../data/experiences';
import type { HolidayPricing } from '../lib/pricing-transforms';

interface Props {
  post: Experience;
  cruisePricing?: HolidayPricing | null;
  cruiseUrl?: string;
  cruiseTitle?: string;
  cruiseId?: number | string;
}
const { post, cruisePricing = null, cruiseUrl = '', cruiseTitle = '', cruiseId = '' } = Astro.props;

const url = `https://holidays.flightsandpackages.com/blog/experiences/${post.slug}`;
const hasBooking = post.cta.bookingUrl && !post.cta.bookingUrl.startsWith('TODO');
const hasCalendar = !!(cruisePricing && cruisePricing.departures && cruisePricing.departures.length > 0);

// Related posts: standard blog posts sharing a tag (e.g. River Cruise).
const relatedPosts = allBlogs
  .filter((b) => b.tags.some((t) => post.tags.includes(t)))
  .slice(0, 4);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.hero.title,
  description: post.seo.excerpt,
  image: post.seo.image,
  author: { '@type': 'Organization', name: post.author },
  publisher: {
    '@type': 'Organization',
    name: 'Flights and Packages',
    url: 'https://holidays.flightsandpackages.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://holidays.flightsandpackages.com/icons/flights-and-packages-logo.png',
    },
  },
  datePublished: post.publishedAt || post.date,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
};
---

<BaseLayout
  title={post.seo.metaTitle}
  description={post.seo.metaDescription}
  image={post.seo.image}
  type="article"
  noindex={post.draft}
>
  <BreadcrumbSchema slot="head" items={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: post.hero.title },
  ]} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {post.publishedAt && <meta slot="head" property="article:published_time" content={post.publishedAt} />}

  <Header />
  <MobileNav />

  {post.draft && (
    <div class="draft-banner">
      DRAFT PREVIEW — not indexed, not in any public feed. Visible in dev only.
    </div>
  )}

  <article class="xp">
    <!-- Breadcrumb -->
    <nav class="xp-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/blog">Blog</a>
      <span aria-hidden="true">/</span>
      <span class="current">{post.hero.title}</span>
    </nav>

    <!-- Hero -->
    <header class="xp-hero">
      <div class="xp-hero-media">
        <Figure slot={post.hero.media} priority={true} />
        <div class="xp-hero-scrim" aria-hidden="true"></div>
      </div>
      <div class="xp-hero-text">
        <p class="xp-eyebrow">{post.hero.eyebrow}</p>
        <h1>{post.hero.title}</h1>
        <p class="xp-hero-meta">{post.hero.meta}</p>
      </div>
    </header>

    <!-- This trip is bookable -->
    <aside class="xp-bookable">
      <div class="xp-bookable-inner">
        <span class="xp-bookable-label">This trip is bookable</span>
        <a class="xp-bookable-cta" href={hasCalendar ? '#availability' : (hasBooking ? post.cta.bookingUrl : `tel:${post.cta.phone.replace(/\s/g, '')}`)}>
          {post.cta.price}
        </a>
      </div>
    </aside>

    <!-- Intro -->
    <section class="xp-intro">
      {post.intro.map((para) => <p>{para}</p>)}
    </section>

    <!-- At a glance -->
    <section class="xp-glance" aria-label="At a glance">
      {post.glance.map((card) => (
        <div class="xp-glance-card">
          <h2 class="xp-glance-label">{card.label}</h2>
          <p>{card.value}</p>
        </div>
      ))}
    </section>

    <!-- Journey -->
    <section class="xp-journey" aria-label="The journey">
      {post.chapters.map((ch, i) => (
        <div class={`xp-chapter ${i % 2 === 1 ? 'is-reversed' : ''}`}>
          <div class="xp-chapter-media">
            <Figure slot={ch.media} />
          </div>
          <div class="xp-chapter-text">
            <span class="xp-chapter-num">{ch.day}</span>
            <p class="xp-chapter-place">{ch.place}</p>
            <h2 class="xp-chapter-title">{ch.title}</h2>
            <p>{ch.body}</p>
          </div>
        </div>
      ))}
    </section>

    <!-- Gallery -->
    <section class="xp-gallery" aria-label="Gallery">
      {post.gallery.map((g) => (
        <div class="xp-gallery-item">
          <Figure slot={g} />
        </div>
      ))}
    </section>

    <!-- CTA — skipped when a live availability calendar follows (it carries the price + enquiry) -->
    {!hasCalendar && (
      <section class="xp-cta" id="cta">
        <div class="xp-cta-inner">
          <h2>{post.cta.headline}</h2>
          <p class="xp-cta-price">{post.cta.price}</p>
          <div class="xp-cta-actions">
            <a class="xp-cta-btn primary" href={hasBooking ? post.cta.bookingUrl : `tel:${post.cta.phone.replace(/\s/g, '')}`}>
              {hasBooking ? 'View this holiday' : `Enquire — call ${post.cta.phone}`}
            </a>
            <a class="xp-cta-btn ghost" href={hasBooking ? `tel:${post.cta.phone.replace(/\s/g, '')}` : '/Holidays/river-cruises/'}>
              {hasBooking ? `Call ${post.cta.phone}` : 'Browse river cruises'}
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Live availability calendar (when the post maps to a cruise) -->
    {cruisePricing && cruisePricing.departures && cruisePricing.departures.length > 0 && (
      <CruisePricingCalendar
        pricing={cruisePricing}
        packageName={cruiseTitle || post.hero.title}
        packageId={cruiseId}
        bookingUrl={cruiseUrl}
      />
    )}

    <!-- Related -->
    {relatedPosts.length > 0 && (
      <section class="xp-related" aria-label="Related posts">
        <h2 class="xp-related-head">Keep reading</h2>
        <div class="xp-related-grid">
          {relatedPosts.map((p) => (
            <a class="xp-related-card" href={`/blog/${p.slug}`}>
              <img src={p.image} alt="" loading="lazy" />
              <span class="xp-related-title">{p.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <Footer />
  <MobileCallCTA />

  <!-- Hero ambient video: reduced-motion guard + lazy HLS player.
       Safari plays HLS natively; other browsers lazy-load hls.js only when an
       HLS hero is on the page. Self-hosted mp4/webm <source> needs no JS. -->
  <script is:inline>
    (function () {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('.hero-video').forEach(function (v) {
        if (reduce) { v.removeAttribute('autoplay'); v.pause(); return; }
        var src = v.getAttribute('data-hls');
        if (!src) return; // mp4/webm <source> already handles playback
        if (v.canPlayType('application/vnd.apple.mpegurl')) {
          v.src = src; // Safari / iOS — native HLS
          return;
        }
        var s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/hls.js@1.5/dist/hls.min.js';
        s.onload = function () {
          if (window.Hls && window.Hls.isSupported()) {
            var hls = new window.Hls({ capLevelToPlayerSize: true });
            hls.loadSource(src);
            hls.attachMedia(v);
          }
        };
        document.head.appendChild(s);
      });
    })();
  </script>
</BaseLayout>

<style>
  :root {
    --xp-teal: #20A1AA;
    --xp-teal-deep: #177D85;
    --xp-navy: #073140;
    --xp-orange: #ff7f00;
    --xp-ink: #424242;
    --xp-sand: #F7F4ED;
    --xp-measure: 720px;
  }

  .draft-banner {
    margin-top: 100px;
    background: #fff4e0;
    border-bottom: 2px solid var(--xp-orange);
    color: #8a4b00;
    font-family: 'BentonSans', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.5px;
    text-align: center;
    padding: 10px 16px;
  }
  @media (max-width: 768px) { .draft-banner { margin-top: 50px; } }
  /* When the draft banner is present it already clears the header */
  .draft-banner + .xp .xp-breadcrumb { margin-top: 18px; }
  @media (max-width: 768px) { .xp-breadcrumb { margin-top: 50px; } }

  .xp {
    color: var(--xp-ink);
    overflow-x: clip;
  }

  /* Breadcrumb — clears the fixed site header */
  .xp-breadcrumb {
    max-width: 1240px;
    margin: 100px auto 0;
    padding: 18px 20px 0;
    font-family: 'BentonSans', sans-serif;
    font-size: 12px;
    color: #7a8688;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .xp-breadcrumb a { color: var(--xp-teal); }
  .xp-breadcrumb .current { color: #7a8688; }

  /* Hero — only push below the fixed header when NOT preceded by the draft banner */
  .xp-hero {
    position: relative;
    margin-top: 12px;
  }
  .draft-banner + .xp .xp-hero { margin-top: 12px; }
  .xp-hero-media {
    position: relative;
    width: 100%;
    max-height: 78vh;
    overflow: hidden;
  }
  .xp-hero-media :global(.shot) {
    border-radius: 0;
    max-height: 78vh;
  }
  .xp-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 49, 64, 0.1) 0%, rgba(7, 49, 64, 0.0) 35%, rgba(7, 49, 64, 0.65) 100%);
    pointer-events: none;
  }
  .xp-hero-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 40px 20px 44px;
    max-width: 1240px;
    margin: 0 auto;
    color: #fff;
    text-align: center;
  }
  .xp-eyebrow {
    font-family: 'BentonSans', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 14px;
    opacity: 0.92;
  }
  .xp-hero-text h1 {
    font-family: 'CaslonGraphiqueEF', Georgia, serif;
    color: #fff;
    font-size: clamp(34px, 6vw, 72px);
    line-height: 1.05;
    margin: 0 auto;
    max-width: 16ch;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  }
  .xp-hero-meta {
    font-family: 'BentonSans', sans-serif;
    font-size: 15px;
    color: #fff;
    margin: 16px 0 0;
    opacity: 0.95;
  }

  /* Bookable strip */
  .xp-bookable {
    background: var(--xp-navy);
  }
  .xp-bookable-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .xp-bookable-label {
    font-family: 'BentonSans', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #fff;
  }
  .xp-bookable-cta {
    background: var(--xp-orange);
    color: #fff;
    font-family: 'BentonSans', sans-serif;
    font-weight: 700;
    font-size: 14px;
    padding: 10px 22px;
    border-radius: 4px;
    transition: filter 0.15s ease;
  }
  .xp-bookable-cta:hover { filter: brightness(1.08); }

  /* Intro */
  .xp-intro {
    max-width: var(--xp-measure);
    margin: 0 auto;
    padding: 64px 20px 8px;
  }
  .xp-intro p {
    font-size: 19px;
    line-height: 32px;
    color: #3a4344;
    margin: 0 0 22px;
  }
  .xp-intro p:first-child::first-letter {
    font-family: 'CaslonGraphiqueEF', Georgia, serif;
    font-size: 64px;
    line-height: 48px;
    float: left;
    padding: 4px 12px 0 0;
    color: var(--xp-teal-deep);
  }
  @media (max-width: 768px) { .xp-intro { padding-top: 44px; } .xp-intro p { font-size: 17px; line-height: 29px; } }

  /* At a glance */
  .xp-glance {
    max-width: 1100px;
    margin: 40px auto 8px;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .xp-glance-card {
    background: var(--xp-sand);
    border-radius: 10px;
    padding: 24px;
    border-top: 4px solid var(--xp-teal);
  }
  .xp-glance-label {
    font-family: 'BentonSans', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--xp-teal-deep);
    margin: 0 0 10px;
  }
  .xp-glance-card p { margin: 0; font-size: 15px; line-height: 25px; }
  @media (max-width: 768px) { .xp-glance { grid-template-columns: 1fr; } }

  /* Journey */
  .xp-journey {
    max-width: 1100px;
    margin: 0 auto;
    padding: 56px 20px 8px;
  }
  .xp-chapter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    margin-bottom: 72px;
  }
  .xp-chapter.is-reversed .xp-chapter-media { order: 2; }
  /* Real chapter photos show at their natural ratio (portrait or landscape),
     centred and capped so tall shots never run off-screen. Placeholders keep
     their fixed-ratio box so empty slots stay visible. */
  .xp-chapter-media :global(.shot:not(.shot--placeholder)) {
    aspect-ratio: auto;
    width: auto;
    max-width: 100%;
    max-height: 74vh;
    margin: 0 auto;
    background: none;
  }
  .xp-chapter-media :global(.shot:not(.shot--placeholder)) img,
  .xp-chapter-media :global(.shot:not(.shot--placeholder)) video {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 74vh;
    object-fit: contain;
  }
  .xp-chapter-num {
    font-family: 'CaslonGraphiqueEF', Georgia, serif;
    font-size: 30px;
    line-height: 1;
    color: var(--xp-orange);
    display: block;
    margin-bottom: 8px;
    white-space: nowrap;
  }
  .xp-chapter-place {
    font-family: 'BentonSans', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--xp-teal-deep);
    margin: 0 0 8px;
  }
  .xp-chapter-title {
    font-family: 'CaslonGraphiqueEF', Georgia, serif;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.1;
    color: var(--xp-ink);
    margin: 0 0 16px;
  }
  .xp-chapter-text p:last-child { font-size: 17px; line-height: 29px; margin: 0; }
  @media (max-width: 768px) {
    .xp-chapter { grid-template-columns: 1fr; gap: 20px; margin-bottom: 52px; }
    .xp-chapter.is-reversed .xp-chapter-media { order: 0; }
  }

  /* Gallery — masonry (mixed portrait/landscape, each at natural ratio) */
  .xp-gallery {
    max-width: 1240px;
    margin: 24px auto 0;
    padding: 40px 20px;
    columns: 3;
    column-gap: 16px;
  }
  .xp-gallery-item {
    break-inside: avoid;
    margin-bottom: 16px;
  }
  /* Gallery photos flow at their own height; placeholders keep their ratio box. */
  .xp-gallery :global(.shot:not(.shot--placeholder)) {
    aspect-ratio: auto;
  }
  .xp-gallery :global(.shot:not(.shot--placeholder)) img,
  .xp-gallery :global(.shot:not(.shot--placeholder)) video {
    height: auto;
    object-fit: contain;
  }
  @media (max-width: 768px) {
    .xp-gallery { columns: 2; }
  }
  @media (max-width: 450px) {
    .xp-gallery { columns: 1; }
  }

  /* CTA */
  .xp-cta {
    background: linear-gradient(135deg, var(--xp-teal) 0%, var(--xp-teal-deep) 100%);
    margin-top: 24px;
  }
  .xp-cta-inner {
    max-width: 820px;
    margin: 0 auto;
    padding: 64px 20px;
    text-align: center;
    color: #fff;
  }
  .xp-cta-inner h2 {
    font-family: 'CaslonGraphiqueEF', Georgia, serif;
    color: #fff;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.15;
    margin: 0 0 14px;
  }
  .xp-cta-price {
    font-family: 'BentonSans', sans-serif;
    font-size: 18px;
    color: #fff;
    opacity: 0.95;
    margin: 0 0 28px;
  }
  .xp-cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .xp-cta-btn {
    font-family: 'BentonSans', sans-serif;
    font-weight: 700;
    font-size: 15px;
    padding: 14px 28px;
    border-radius: 4px;
    transition: filter 0.15s ease, background 0.15s ease;
  }
  .xp-cta-btn.primary { background: var(--xp-orange); color: #fff; }
  .xp-cta-btn.primary:hover { filter: brightness(1.08); }
  .xp-cta-btn.ghost { background: rgba(255, 255, 255, 0.12); color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.7); }
  .xp-cta-btn.ghost:hover { background: rgba(255, 255, 255, 0.22); }

  /* Related */
  .xp-related {
    max-width: 1240px;
    margin: 0 auto;
    padding: 56px 20px 72px;
  }
  .xp-related-head {
    font-family: 'CaslonGraphiqueEF', Georgia, serif;
    font-size: 30px;
    color: var(--xp-ink);
    margin: 0 0 24px;
    text-align: center;
  }
  .xp-related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .xp-related-card {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .xp-related-card:hover { transform: translateY(-3px); box-shadow: 0 8px 22px rgba(0, 0, 0, 0.12); }
  .xp-related-card img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; }
  .xp-related-title {
    display: block;
    font-family: 'BentonSans', sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: var(--xp-ink);
    padding: 14px 16px 18px;
  }
  @media (max-width: 768px) { .xp-related-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 450px) { .xp-related-grid { grid-template-columns: 1fr; } }
</style>
