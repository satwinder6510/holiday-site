---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  preloadImage?: string;
}

const {
  title,
  description = 'Holidays - Flights and Packages offer Quality City Breaks, Beach Holidays, Multi Centre Holidays, Tailor Made Holidays and Private Tours at Affordable Prices.',
  image,
  type = 'website',
  noindex = false,
  preloadImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image || 'https://holidays.flightsandpackages.com/images/og-default.jpg';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': 'https://holidays.flightsandpackages.com/#organization',
  name: 'Flights and Packages',
  url: 'https://holidays.flightsandpackages.com',
  telephone: '+44 208 183 0518',
  email: 'info@holidays.flightsandpackages.com',
  description: 'Quality City Breaks, Beach Holidays, Multi Centre Holidays, Tailor Made Holidays and Private Tours at Affordable Prices.',
  logo: {
    '@type': 'ImageObject',
    url: 'https://holidays.flightsandpackages.com/icons/flights-and-packages-logo.png',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Airport House, Purley Way',
    addressLocality: 'Croydon',
    postalCode: 'CR0 0XZ',
    addressCountry: 'GB',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+44 208 183 0518',
    contactType: 'customer service',
    availableLanguage: 'English',
    areaServed: 'GB',
  },
  sameAs: [
    'https://www.facebook.com/flightsandpackages',
  ],
  areaServed: 'GB',
  priceRange: '$$',
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Flights and Packages',
  url: 'https://holidays.flightsandpackages.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://holidays.flightsandpackages.com/Holidays/search?destination={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#20A1AA" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <link rel="canonical" href={canonicalURL.href} />

  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Flights and Packages" />
  <meta property="og:locale" content="en_GB" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Font Preloads -->
  <link rel="preload" href="/fonts/BentonSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/BentonSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/BentonSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/CaslonGraphiqueEF.woff2" as="font" type="font/woff2" crossorigin />

  {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  <link rel="preconnect" href="https://admin.citiesandbeaches.com" />

  <link rel="icon" type="image/png" href="/favicon.png" />

  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <!-- WebSite Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <!-- FB Pixel noscript fallback (no perf impact) -->
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=2922972984621050&ev=PageView&noscript=1" /></noscript>

  <slot name="head" />
</head>
<body>
  <main><slot /></main>

  <!-- Lazy background-image loader -->
  <script is:inline>
    (function () {
      var els = document.querySelectorAll('[data-bg]');
      if (!els.length) return;
      if (!('IntersectionObserver' in window)) {
        els.forEach(function (el) { el.style.backgroundImage = "url('" + el.getAttribute('data-bg') + "')"; });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.style.backgroundImage = "url('" + e.target.getAttribute('data-bg') + "')";
            io.unobserve(e.target);
          }
        });
      }, { rootMargin: '200px' });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>

  <!-- Traffic source tracking -->
  <script is:inline>
    (function () {
      if (sessionStorage.getItem('lead_source')) return;
      var params = new URLSearchParams(window.location.search);
      var src = params.get('utm_source');
      if (!src && document.referrer) {
        try {
          var host = new URL(document.referrer).hostname.replace('www.', '');
          if (host.indexOf('chat.openai') >= 0 || host.indexOf('chatgpt') >= 0) src = 'ChatGPT';
          else if (host.indexOf('perplexity') >= 0) src = 'Perplexity';
          else if (host.indexOf('claude.ai') >= 0) src = 'Claude';
          else if (host.indexOf('copilot.microsoft') >= 0) src = 'Microsoft Copilot';
          else if (host.indexOf('gemini.google') >= 0) src = 'Gemini';
          else if (host.indexOf('you.com') >= 0) src = 'You.com';
          else if (host.indexOf('google') >= 0) src = 'Google';
          else if (host.indexOf('bing') >= 0) src = 'Bing';
          else if (host.indexOf('facebook') >= 0 || host.indexOf('fb.') >= 0) src = 'Facebook';
          else if (host.indexOf('instagram') >= 0) src = 'Instagram';
          else if (host.indexOf('twitter') >= 0 || host.indexOf('x.com') >= 0) src = 'Twitter/X';
          else if (host.indexOf('tiktok') >= 0) src = 'TikTok';
          else if (host.indexOf('youtube') >= 0) src = 'YouTube';
          else if (host.indexOf(window.location.hostname) >= 0) src = null;
          else src = host;
        } catch (e) { src = null; }
      }
      sessionStorage.setItem('lead_source', src || 'Direct');
      if (!sessionStorage.getItem('landing_page')) {
        sessionStorage.setItem('landing_page', window.location.pathname);
      }
    })();
  </script>

  <!-- Cookie Banner (UK PECR/GDPR) -->
  <div id="cookie-banner" style="display:none; position:fixed; bottom:0; left:0; right:0; background:#073140; color:#fff; padding:14px 20px; z-index:9999; font-family:'BentonSans',sans-serif; font-size:14px; line-height:22px;">
    <div style="max-width:1240px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
      <p style="margin:0; flex:1; min-width:200px;">We use cookies to improve your experience on our site. By continuing to browse, you accept our use of cookies. <a href="/cookies-policy" style="color:#20A1AA; text-decoration:underline;">Cookie Policy</a></p>
      <button id="cookie-accept" style="background:#20A1AA; color:#fff; border:none; padding:8px 24px; border-radius:4px; font-size:14px; font-family:'BentonSans',sans-serif; font-weight:700; cursor:pointer; white-space:nowrap;">Accept</button>
    </div>
  </div>
  <script is:inline>
    (function () {
      if (!document.cookie.includes('cookie_consent=1')) {
        document.getElementById('cookie-banner').style.display = 'block';
      }
      document.getElementById('cookie-accept').addEventListener('click', function () {
        document.cookie = 'cookie_consent=1; path=/; max-age=' + (365 * 24 * 60 * 60) + '; SameSite=Lax';
        document.getElementById('cookie-banner').style.display = 'none';
      });
    })();
  </script>

  <!-- Error Monitoring — beacon to admin API -->
  <script is:inline>
    (function () {
      var BEACON_URL = 'https://holiday-admin-api.satwinder-30c.workers.dev/api/monitor/errors';
      var reported = {};
      try { reported = JSON.parse(sessionStorage.getItem('_err_reported') || '{}'); } catch (e) {}

      function report(type, detail) {
        var key = type + ':' + (detail || '').slice(0, 120);
        if (reported[key]) return;
        reported[key] = 1;
        try { sessionStorage.setItem('_err_reported', JSON.stringify(reported)); } catch (e) {}
        var payload = JSON.stringify({
          type: type,
          url: location.href,
          detail: detail ? detail.slice(0, 2000) : null,
          userAgent: navigator.userAgent,
          referrer: document.referrer || null
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon(BEACON_URL, new Blob([payload], { type: 'application/json' }));
        }
      }

      // JS errors
      window.addEventListener('error', function (e) {
        if (e.target && (e.target.tagName === 'IMG' || e.target.tagName === 'SCRIPT')) return;
        report('js_error', (e.message || 'Unknown error') + ' at ' + (e.filename || '') + ':' + (e.lineno || 0));
      });

      // Broken images (capture phase)
      document.addEventListener('error', function (e) {
        if (e.target && e.target.tagName === 'IMG') {
          report('broken_image', e.target.src || e.target.getAttribute('data-src') || 'unknown');
        }
      }, true);

      // Unhandled promise rejections
      window.addEventListener('unhandledrejection', function (e) {
        var msg = e.reason ? (e.reason.message || String(e.reason)) : 'Unhandled rejection';
        report('js_error', msg);
      });
    })();
  </script>

  <!-- Tidio Live Chat -->
  <script src="//code.tidio.co/umkdiuqjxuccie7jbxsnr0f6pj3lkfcs.js" async></script>

  <!-- Deferred Analytics — FB Pixel, Clarity (loaded after main content) -->
  <script is:inline>
    (function () {
      function loadAnalytics() {
        // Facebook Pixel
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '2922972984621050');
        fbq('track', 'PageView');

        // PostHog
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init('phc_CncpMTolnthosh7c98z3b7iqSHbhB1vokNzW2WgrC2R', {
            api_host: 'https://eu.i.posthog.com'
        });

        // Microsoft Clarity
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "vvtl8xkgpk");
      }

      if (typeof requestIdleCallback === 'function') {
        requestIdleCallback(loadAnalytics);
      } else {
        setTimeout(loadAnalytics, 2000);
      }
    })();
  </script>
</body>
</html>

<style is:global>
  @import '../styles/fonts.css';
  @import '../styles/global.css';
</style>
