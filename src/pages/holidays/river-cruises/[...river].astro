  /* ── Cruise card (promo-style) ── */
  .cruise-card {
    display: grid; grid-template-columns: 380px 1fr;
    background: #fff; border-radius: 8px; overflow: hidden;
    box-shadow: 0 2px 16px rgba(0,0,0,0.08); margin-top: 24px; transition: box-shadow 0.2s;
  }
