---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import MobileNav from '../../../components/MobileNav.astro';
import Footer from '../../../components/Footer.astro';
import Newsletter from '../../../components/Newsletter.astro';
import MobileCallCTA from '../../../components/MobileCallCTA.astro';
import BreadcrumbSchema from '../../../components/BreadcrumbSchema.astro';
import { getDb } from '../../../lib/get-db';
import { getAllListedHolidaysFromDb, getCabinPricingForOfferIds } from '../../../lib/holidays-db';
import { slugifyRiver } from '../../../lib/holiday-transforms';
import { roundToNine } from '../../../lib/pricing-transforms';

const riverSlug = Astro.params.river as string | undefined;

/**
 * Cabin type names from the DB are long and inconsistent across operators
 * ("Cat A (Main Deck, Adjustable Twin Beds)" / "2-bed Outside Cabin with Juliette
 * Balcony"). Shorten to a clean, scannable label for the listing card price list.
 * Falls through gracefully — an unrecognised name gets light cleanup, never empty.
 */
function shortenCabinName(raw: string): string {
  if (!raw) return '';
  let s = raw.trim();
  // CroisiEurope: "Cat A (Main Deck, …)" / "Cat B Suite (Middle Deck, …)"
  //   -> "Cat A · Main Deck" / "Cat B Suite · Middle Deck" (keep category + deck only)
  const m = s.match(/^(Cat\s+[A-Za-z0-9+]+(?:\s+Suite)?)\s*\(\s*((?:Main|Upper|Middle|Lower)\s+Deck)/i);
  if (m) return `${m[1].replace(/\s+/g, ' ').trim()} · ${m[2].replace(/\s+/g, ' ').trim()}`;
  // Everyone else (A-ROSA + misc): strip verbose bits, keep it scannable.
  s = s.replace(/\s*\([^)]*\)\s*/g, ' ');                          // drop "(2 Single Beds)", "(with Extra Bed)", etc.
  s = s.replace(/^\d+-bed\s+/i, '');                               // "2-bed Outside Cabin" -> "Outside Cabin"
  s = s.replace(/\bwith\s+(?:Drop-down\s+)?Panorama\s+Window\b/i, ''); // drop window detail
  s = s.replace(/\bwith\s+(?:Juliette\s+)?Balcony\b/i, '· Balcony');
  s = s.replace(/\band\s+Juliette\s+Balcony\b/i, '');              // "Balcony and Juliette Balcony" -> "Balcony"
  s = s.replace(/\s*-\s*(?:Disabled Person|Handicap+ed)\s*/i, ' '); // drop accessibility tag (typo-tolerant)
  s = s.replace(/\bCabin\b/i, '');                                 // drop generic "Cabin"
  s = s.replace(/\s{2,}/g, ' ').replace(/\s*·\s*·\s*/g, ' · ').replace(/^[·\s]+|[·\s]+$/g, '').trim();
  return s;
}

/**
 * CroisiEurope: the "Cat A/B/C" prefix is just cabin POSITION — irrelevant to
 * customers. Collapse the many "Cat X (Deck, beds)" rows to the cheapest price per
 * deck (Main / Middle / Upper) plus the cheapest Suite. `cabins` arrives sorted
 * cheapest-first, so the first hit per bucket is that bucket's cheapest. Returns
 * up to 4 rows, cheapest-first (so the highlighted top row matches the headline).
 */
function bucketByDeck(cabins: { cabinType: string; pricePp: number }[]): { name: string; pricePp: number }[] {
  const cheapest = new Map<string, number>();
  for (const c of cabins) {
    const t = c.cabinType;
    let label: string;
    // Cabins are already scoped to ONE ship (the cheapest-entry ship), so the decks
    // here are that ship's real decks — a 2-deck ship yields Main/Upper, a 3-deck
    // ship (e.g. MS Vivaldi) yields Main/Middle/Upper. "Cat X" = position, dropped.
    if (/suite/i.test(t)) label = 'Suite';
    else if (/main deck/i.test(t)) label = 'Main Deck';
    else if (/middle deck/i.test(t)) label = 'Middle Deck';
    else if (/upper deck/i.test(t)) label = 'Upper Deck';
    else label = shortenCabinName(t); // oddballs (specific ships) keep a cleaned name
    if (!cheapest.has(label)) cheapest.set(label, c.pricePp);
  }
  return [...cheapest.entries()]
    .map(([name, pricePp]) => ({ name, pricePp }))
    .sort((a, b) => a.pricePp - b.pricePp)
    .slice(0, 4);
}

// Itinerary port names from Widgety vary in quality — some are day-programme titles
// ("Board your ship", "Arrive Vienna - Return to UK") rather than clean ports.
// Clean each, drop non-port junk, and collapse consecutive duplicates (case-insensitive).
const PORT_JUNK = /board your ship|your ship|return to uk|^uk$|^at sea$|^cruising$|cruising day|river day|scenic crus|free (day|time)|day at leisure|leisure/i;
function buildPortSequence(itinerary: { title: string }[]): string[] {
  const cleaned = itinerary
    .map((d) => (d.title || '')
      .trim()
      .replace(/^UK\s*[-–]\s*/i, '')
      .replace(/\s*[-–]\s*Return to UK.*$/i, '')
      .replace(/^(Arrive|Arrival in|Departure from|Depart from|Departure|Depart)\s+/i, '')
      .trim())
    .filter((p) => p && !PORT_JUNK.test(p) && p.length <= 30);
  return cleaned.filter((p, i, a) => i === 0 || p.toLowerCase() !== a[i - 1].toLowerCase());
}

let allCruises;
try {
  const db = getDb(Astro);
  const all = await getAllListedHolidaysFromDb(db);
  allCruises = all
    .filter(h => h.tags.includes('River Cruise'))
    .sort((a, b) => (a.price + a.localChargesPp) - (b.price + b.localChargesPp));
} catch (e) {
  console.error('DB error on river-cruises:', e);
  return new Response('Service temporarily unavailable', { status: 503 });
}

// Build river slug → display name lookup, excluding destinations that are just country names
const countryNames = new Set(allCruises.map(c => c.country));
const riverMap = new Map<string, string>();
for (const c of allCruises) {
  if (countryNames.has(c.destination)) continue;
  const slug = slugifyRiver(c.destination);
  if (!riverMap.has(slug)) {
    riverMap.set(slug, c.destination);
  }
}

// Validate river slug if provided
let activeRiverName: string | null = null;
if (riverSlug) {
  activeRiverName = riverMap.get(riverSlug) ?? null;
  if (!activeRiverName) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
}

// Filter holidays by river if a slug is active
const holidays = activeRiverName
  ? allCruises.filter(h => {
      // Exact destination match (cruise-export cruises have river as destination)
      if (h.destination === activeRiverName) return true;
      // Multi-river destinations like "Danube, Main" when filtering by "Danube"
      if (h.destination.includes(activeRiverName)) return true;
      // DB holidays tagged 'River Cruise' have country as destination — match by title
      if (countryNames.has(h.destination)) {
        return h.title.toLowerCase().includes(activeRiverName.toLowerCase());
      }
      return false;
    })
  : allCruises;

// Attach cheapest per-cabin pricing (live D1) to each cruise card. Best-effort —
// on failure the cards just render without a cabin grid (never 503 the page).
try {
  const db = getDb(Astro);
  const cabinMap = await getCabinPricingForOfferIds(db, holidays.map(h => h.id));
  for (const h of holidays) {
    const cabins = cabinMap.get(h.id);
    if (!cabins || cabins.length === 0) continue;
    // CroisiEurope → cheapest per deck + suite (Cat X is irrelevant position).
    // A-ROSA → keep its meaningful cabin types (Outside / Balcony / Suite), cheapest 4.
    h.cabins = /croisi/i.test(h.operator)
      ? bucketByDeck(cabins)
      : cabins.slice(0, 4).map((c) => ({ name: shortenCabinName(c.cabinType), pricePp: c.pricePp }));
    // NOTE: the headline "from" price stays as h.price (cheapest_total_pp — the
    // ONE canonical all-in price used on every page + the detail calendar). We no
    // longer override it with the cabin grid's flat-estimate net, which made the
    // /river-cruises "from" disagree with the detail page and /Holidays/[country].
    // The cabin grid below is a secondary per-deck breakdown.
  }
} catch (e) {
  console.error('cabin pricing attach failed:', e);
}

// Sorted river list for sidebar links (with counts)
const rivers = [...riverMap.entries()]
  .map(([slug, name]) => {
    const count = allCruises.filter(c =>
      c.destination === name || c.destination.includes(name) ||
      (countryNames.has(c.destination) && c.title.toLowerCase().includes(name.toLowerCase()))
    ).length;
    return { slug, name, count };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

// SEO
const pageTitle = activeRiverName
  ? `${activeRiverName} River Cruises | Flights and Packages`
  : 'River Cruises | Flights and Packages';
const pageDescription = activeRiverName
  ? `Explore our ${activeRiverName} fly-cruise river cruise packages. All-inclusive sailings with flights from UK airports.`
  : 'Explore our fly-cruise river cruise packages across Europe. All-inclusive sailings with CroisiEurope and A-Rosa, with flights from UK airports.';
const heroTitle = activeRiverName
  ? `${activeRiverName} River Cruises`
  : 'River Cruises';

const breadcrumbItems = activeRiverName
  ? [
      { name: 'Home', url: '/' },
      { name: 'River Cruises', url: '/Holidays/river-cruises' },
      { name: `${activeRiverName}` },
    ]
  : [
      { name: 'Home', url: '/' },
      { name: 'River Cruises' },
    ];

const bannerImage = '/images/heroes/river-cruises-danube.jpg';
const bannerFallback = '/images/heroes/river-cruises-danube.jpg';

// ItemList schema for first 20 cruises
const itemListName = activeRiverName ? `${activeRiverName} River Cruises` : 'River Cruises';
const itemListSchema = holidays.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: itemListName,
  numberOfItems: holidays.length,
  itemListElement: holidays.slice(0, 20).map((h, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: h.title,
    url: `https://holidays.flightsandpackages.com/Holidays/${h.countrySlug}/${h.slug}`,
    image: h.image,
  })),
} : null;
---

<BaseLayout title={pageTitle} description={pageDescription} image={bannerFallback}>
  <link slot="head" rel="preload" as="image" type="image/jpeg" href={bannerImage} />
  <BreadcrumbSchema slot="head" items={breadcrumbItems} />
  {itemListSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
  <Header />
  <MobileNav />

  <!-- Custom Hero -->
  <section class="country-hero" aria-label="Page hero">
    <img src={bannerImage} alt="" class="hero-bg" fetchpriority="high" decoding="async" width="1920" height="776" />
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <img src="/icons/breadcrumb-arrow.svg" alt="" class="breadcrumb-icon" />
      {activeRiverName ? (
        <>
          <a href="/Holidays/river-cruises">River Cruises</a>
          <img src="/icons/breadcrumb-arrow.svg" alt="" class="breadcrumb-icon" />
          <span>{activeRiverName}</span>
        </>
      ) : (
        <span>River Cruises</span>
      )}
    </nav>
    <div class="hero-content">
      <div class="hero-subtitle">discover</div>
      <h1>{heroTitle}</h1>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="intro-section section-container">
    <p class="intro-text">
      {activeRiverName
        ? `Discover the beauty of the ${activeRiverName} with our fly-cruise river cruise packages. All packages include return flights from UK airports, full-board dining, and unforgettable itineraries.`
        : 'Discover the beauty of Europe from the water with our fly-cruise river cruise packages. Sail along the Rhine, Danube, Douro and more with award-winning operators CroisiEurope and A-Rosa. All packages include return flights from UK airports, full-board dining, and unforgettable itineraries through some of the continent\'s most charming towns and cities.'}
    </p>
    <p class="intro-text-extra hide" id="intro-extra-text">
      Whether you prefer the intimate charm of a boutique vessel or the modern luxury of a premium ship,
      our river cruise collection has something for every traveller. Glide past medieval castles,
      world-class vineyards, and vibrant capitals — all while enjoying exceptional onboard service.
      Browse our latest departures below or call our team for expert advice on choosing the perfect sailing.
    </p>
    <button type="button" class="read-more" aria-expanded="false" aria-controls="intro-extra-text">
      Read more
      <span class="icon-dropdown"></span>
    </button>
  </section>

  <!-- Holiday List Section -->
  <section class="holiday-list-section section-container">
    <!-- Sidebar -->
    <div class="sidebar-backdrop"></div>
    <div class="sidebar" id="sidebar-filters">
      <div class="filter">
        <div class="sidebar-header">
          <div class="type">Filters</div>
          <button type="button" class="reset">Reset</button>
          <button type="button" class="sidebar-close" aria-label="Close filters">&times;</button>
        </div>
      </div>

      <!-- Special offers filter (top) -->
      <div class="filter">
        <button type="button" class="sidebar-header" aria-expanded="true">
          <div class="type">Special Offers</div>
          <span class="icon-pullup"></span>
        </button>
        <div class="sidebar-content">
          <div class="checkbox-option">
            <input type="checkbox" name="special" id="special-offers" value="1" />
            <label for="special-offers">Special offers only</label>
          </div>
        </div>
      </div>

      <!-- River filter — links instead of checkboxes -->
      <div class="filter">
        <button type="button" class="sidebar-header" aria-expanded="true">
          <div class="type">River</div>
          <span class="icon-pullup"></span>
        </button>
        <div class="sidebar-content">
          <a
            class:list={['river-link', { active: !activeRiverName }]}
            href="/Holidays/river-cruises"
          >All Rivers ({allCruises.length})</a>
          {rivers.map(({ slug, name, count }) => (
            <a
              class:list={['river-link', { active: activeRiverName === name }]}
              href={`/Holidays/river-cruises/${slug}`}
            >{name} ({count})</a>
          ))}
        </div>
      </div>

      <!-- Duration filter -->
      <div class="filter">
        <button type="button" class="sidebar-header" aria-expanded="true">
          <div class="type">Duration</div>
          <span class="icon-pullup"></span>
        </button>
        <div class="sidebar-content">
          {[...new Set(holidays.map(h => {
            const m = h.duration.match(/(\d+)\s*Nights/);
            return m ? parseInt(m[1]) : 0;
          }))].sort((a, b) => a - b).filter(n => n > 0).map((nights) => (
            <div class="checkbox-option">
              <input type="checkbox" name="duration" id={`d-${nights}`} value={String(nights)} />
              <label for={`d-${nights}`}>{nights} Nights</label>
            </div>
          ))}
        </div>
      </div>

      <!-- Country filter -->
      <div class="filter">
        <button type="button" class="sidebar-header" aria-expanded="true">
          <div class="type">Country</div>
          <span class="icon-pullup"></span>
        </button>
        <div class="sidebar-content">
          {[...new Set(holidays.map(h => h.country))].sort().map((country) => (
            <div class="checkbox-option">
              <input type="checkbox" name="country" id={`c-${country.toLowerCase().replace(/\s+/g, '-')}`} value={country} />
              <label for={`c-${country.toLowerCase().replace(/\s+/g, '-')}`}>{country}</label>
            </div>
          ))}
        </div>
      </div>

      <!-- Operator filter -->
      <div class="filter">
        <button type="button" class="sidebar-header" aria-expanded="true">
          <div class="type">Operator</div>
          <span class="icon-pullup"></span>
        </button>
        <div class="sidebar-content">
          <div class="checkbox-option">
            <input type="checkbox" name="operator" id="croisieurope" value="CroisiEurope" />
            <label for="croisieurope">CroisiEurope</label>
          </div>
          <div class="checkbox-option">
            <input type="checkbox" name="operator" id="a-rosa" value="A-Rosa" />
            <label for="a-rosa">A-Rosa</label>
          </div>
          <div class="checkbox-option">
            <input type="checkbox" name="operator" id="viva-cruises" value="Viva Cruises" />
            <label for="viva-cruises">Viva Cruises</label>
          </div>
        </div>
      </div>

      <!-- Mobile actions -->
      <div class="mobile-actions">
        <button type="button" class="btn-primary filter-apply-btn" aria-label="Apply filters">Apply</button>
        <button type="button" class="reset">Reset</button>
      </div>
    </div>

    <!-- Content -->
    <div class="content">
      <div class="search-sort">
        <h2 class="results" aria-live="polite" aria-atomic="true">{holidays.length} river cruises</h2>
        <div class="order">
          <div class="price" role="group" aria-label="Sort order">
            Price
            <button type="button" class="price-order active" aria-pressed="true">Low to high</button>
            <button type="button" class="price-order" aria-pressed="false">High to low</button>
          </div>
          <div class="mobile-filter-wrap">
            <button type="button" class="filter-btn" aria-expanded="false" aria-controls="sidebar-filters">
              <span class="icon-filter"></span>
              Filter
            </button>
            <div class="sort">
              Sort by
              <button type="button" class="sort-order" aria-haspopup="listbox" aria-expanded="false">
                <span class="current-option">Price: Low to high</span>
                <span class="icon-dropdown"></span>
              </button>
              <ul class="sort-order-list" role="listbox" aria-label="Sort order">
                <li class="sort-option" role="option" tabindex="0" aria-selected="true">Price: Low to high</li>
                <li class="sort-option" role="option" tabindex="0" aria-selected="false">Price: High to low</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Holiday cards -->
      <div class="holidays">
        {holidays.map((holiday) => {
          // parseInt strips zero-padding ("04" → "4") so data-duration matches the
          // duration filter checkbox values (which are parseInt'd).
          const nightsMatch = holiday.duration.match(/(\d+)\s*Nights/);
          const nights = nightsMatch ? String(parseInt(nightsMatch[1], 10)) : '';
          const fromPrice = holiday.displayPrice ?? roundToNine(holiday.price + holiday.localChargesPp);
          const detailUrl = `/Holidays/${holiday.countrySlug}/${holiday.slug}`;
          const showBadge = holiday.destination && holiday.destination !== holiday.country;
          // Keep the card body compact (so it balances the image side) — trim the
          // blurb to ~2 lines; full description is on the detail page.
          const cardDesc = holiday.description && holiday.description.length > 150
            ? holiday.description.slice(0, 150).replace(/\s+\S*$/, '') + '…'
            : (holiday.description || '');
          // Card gallery images. Widgety cruises → hero + ship/cabin photos; manual
          // flight_packages River Cruises → hero + their own gallery photos. Deduped.
          const cardImages = [holiday.image, ...(holiday.cabinImages || []), ...(holiday.galleryImages || [])]
            .filter(Boolean)
            .filter((v, i, a) => a.indexOf(v) === i)
            .slice(0, 4);
          // Port sequence (cleaned) → shows the ports in between, not just start/end.
          // Falls back to "From → To" when there's no usable itinerary.
          const portSeq = buildPortSequence(holiday.itinerary || []);
          let routeLine = portSeq.length > 1
            ? portSeq.join(' → ')
            : (holiday.routeFrom && holiday.routeTo ? `${holiday.routeFrom} → ${holiday.routeTo}` : '');
          // Cap very long itineraries so the line stays readable.
          if (portSeq.length > 10) {
            routeLine = portSeq.slice(0, 7).join(' → ') + ' → … → ' + portSeq[portSeq.length - 1];
          }
          return (
          <article class="cruise-card holiday"
            data-country={holiday.country}
            data-duration={nights}
            data-operator={holiday.operator}
            data-price={fromPrice}
            data-special-offer={holiday.isSpecialOffer ? 'true' : 'false'}
          >
            <div class="card-gallery">
              <div class="card-gallery-main">
                <img class="card-gallery-img" src={cardImages[0]} alt={holiday.title} loading="lazy" decoding="async" />
                {showBadge && <span class="badge" aria-hidden="true">{holiday.destination}</span>}
                {holiday.isSpecialOffer && <span class="special-badge" aria-hidden="true">Special Offer</span>}
                <span class="duration-badge" aria-hidden="true">{nights ? `${Number(nights)} nights` : holiday.duration}</span>
              </div>
              {cardImages.length > 1 && (
                <div class="card-gallery-thumbs">
                  {cardImages.map((im, i) => (
                    <button type="button" class={`card-thumb${i === 0 ? ' active' : ''}`} data-src={im} aria-label={`Show image ${i + 1}`}>
                      <img src={im} alt="" loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
              )}
            </div>
            <div class="card-body">
              <a class="card-title" href={detailUrl}><h3>{holiday.title}</h3></a>
              {routeLine && (
                <div class="card-route">{routeLine}</div>
              )}
              <div class="card-from-price" aria-label={`from £${fromPrice} per person`}>
                <span aria-hidden="true">From</span>
                <span class="now-price" aria-hidden="true">&pound;{fromPrice}</span>
                <span class="from-pp" aria-hidden="true">pp</span>
              </div>
              <p class="card-desc">{cardDesc}</p>
              {holiday.cabins && holiday.cabins.length > 0 && (
                <details class="cabin-list">
                  <summary class="cabin-list-toggle">
                    <span>Cabin options ({holiday.cabins.length})</span>
                  </summary>
                  <ul class="cabin-rows">
                    {holiday.cabins.map((cab, i) => (
                      <li class={`cabin-row${i === 0 ? ' is-cheapest' : ''}`}>
                        <span class="cabin-name">{cab.name}</span>
                        <span class="cabin-price-wrap">
                          <span class="cabin-price" aria-hidden="true">&pound;{cab.pricePp}</span>
                          <span class="cabin-pp" aria-hidden="true">pp</span>
                        </span>
                        <span class="sr-only">{cab.name} from &pound;{cab.pricePp} per person</span>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              <p class="flight-note"><strong>Includes return UK flights &amp; all-inclusive cruise.</strong></p>
              <div class="card-cta-row">
                <a href="tel:02081830518" class="btn-call">Call to Book</a>
                <a class="btn-primary view-more-btn" href={detailUrl}>
                  View More
                  <img src="/icons/more-icon-white.svg" alt="" class="icon-more" />
                </a>
              </div>
            </div>
          </article>
        )})}
      </div>

      <button class="load-more-btn btn-primary">Load More</button>

      <div class="no-filter-results" style="display:none">
        <p>No cruises match your selected filters. <button type="button" class="clear-filters">Clear all filters</button></p>
      </div>

      {holidays.length === 0 && (
        <div class="no-results">
          <p>No river cruises are currently available. Please check back soon or call us on <a href="tel:02081830518">0208 183 0518</a> for the latest sailings.</p>
        </div>
      )}
    </div>

  </section>

  <Newsletter />
  <Footer />
  <MobileCallCTA />
</BaseLayout>

<style>
  .country-hero {
    margin-top: 100px;
    height: 500px;
    position: relative;
    color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 100%;
    overflow: hidden;
  }
  .country-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0.35) 100%);
    z-index: 1;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%; /* aim the crop at the ship (lower-middle of the photo) */
    z-index: 0;
  }
  .country-hero .breadcrumbs,
  .country-hero .hero-content {
    position: relative;
    z-index: 2;
  }
  @media (max-width: 768px) {
    .country-hero { margin-top: 50px; height: 400px; }
    .hero-bg { object-position: center 62%; }
