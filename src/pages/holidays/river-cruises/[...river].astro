  @media (max-width: 1100px) { .cruise-card { grid-template-columns: 320px 1fr; } }
  @media (max-width: 760px) { .cruise-card { grid-template-columns: 1fr; } }

  /* card gallery (main image + thumbnail strip) */
  .cruise-card .card-gallery { display: flex; flex-direction: column; min-height: 300px; background: #fff; }
  @media (max-width: 760px) { .cruise-card .card-gallery { min-height: 0; } .cruise-card .card-gallery-main { min-height: 230px; } }
  /* Main image fills the column (cover-crop) so every card is a uniform height
     regardless of body length or photo count — the image absorbs the variance. */
  .cruise-card .card-gallery-main { position: relative; flex: 1 1 auto; min-height: 210px; overflow: hidden; }
  .cruise-card .card-gallery-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .cruise-card .card-gallery-main .badge {
    position: absolute; top: 14px; left: 14px; background: rgba(7,49,64,0.85); color: #fff; z-index: 1;
    font-family: "BentonSansBold", sans-serif; font-size: 11px;
    padding: 5px 12px; border-radius: 3px; text-transform: uppercase; letter-spacing: 0.5px;
  }
  .cruise-card .card-gallery-main .special-badge {
    position: absolute; top: 14px; right: 14px; background: #ff7f00; color: #fff; z-index: 1;
    font-family: "BentonSansBold", sans-serif; font-size: 11px;
    padding: 5px 12px; border-radius: 3px; text-transform: uppercase; letter-spacing: 0.5px;
  }
  .cruise-card .card-gallery-main .duration-badge {
    position: absolute; bottom: 14px; left: 14px; background: #20A1AA; color: #fff; z-index: 1;
    font-family: "BentonSansBold", sans-serif; font-size: 13px; padding: 6px 14px; border-radius: 3px;
