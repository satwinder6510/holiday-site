---
export const prerender = false;

/**
 * River cruise LISTING — the level-two page behind every tile on the landing.
 *   /Holidays/river-cruises/all       every cruise
 *   /Holidays/river-cruises/<river>   one river
 * Presets from the landing tiles: ?nights=short|week|long, ?months=11,12.
 * Cards are the shared RiverCruiseCard; filters are a chip row (river, length, month).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import MobileNav from '../../../components/MobileNav.astro';
import Footer from '../../../components/Footer.astro';
import Newsletter from '../../../components/Newsletter.astro';
import MobileCallCTA from '../../../components/MobileCallCTA.astro';
import BreadcrumbSchema from '../../../components/BreadcrumbSchema.astro';
import RiverCruiseCard from '../../../components/RiverCruiseCard.astro';
import { getDb } from '../../../lib/get-db';
import { getAllListedHolidaysFromDb, getDepartureWindows, type DepartureWindow } from '../../../lib/holidays-db';
import { slugifyRiver, type HolidayDetail } from '../../../lib/holiday-transforms';
import { flightPackages } from '../../../lib/db-schema';
import { inArray } from 'drizzle-orm';
import { fromPrice, nightsOf, shipFromAccommodations, MONTHS } from '../../../lib/cruise-card';

const rawRiverSlug = Astro.params.river as string | undefined;
const riverSlug = rawRiverSlug === 'all' || !rawRiverSlug ? undefined : rawRiverSlug;

let allCruises: HolidayDetail[];
try {
  const db = getDb(Astro);
  const all = await getAllListedHolidaysFromDb(db);
  allCruises = all
    .filter(h => h.tags.includes('River Cruise'))
    .sort((a, b) => fromPrice(a) - fromPrice(b));
} catch (e) {
  console.error('DB error on river-cruises:', e);
  return new Response('Service temporarily unavailable', { status: 503 });
}

// River slug → display name, excluding destinations that are just country names
const countryNames = new Set(allCruises.map(c => c.country));
const riverMap = new Map<string, string>();
for (const c of allCruises) {
  if (countryNames.has(c.destination)) continue;
  const slug = slugifyRiver(c.destination);
  if (!riverMap.has(slug)) riverMap.set(slug, c.destination);
}
let activeRiverName: string | null = null;
if (riverSlug) {
  activeRiverName = riverMap.get(riverSlug) ?? null;
  if (!activeRiverName) return new Response(null, { status: 404, statusText: 'Not Found' });
}
const matchesRiver = (h: HolidayDetail, name: string) =>
  h.destination === name || h.destination.includes(name) ||
  (countryNames.has(h.destination) && h.title.toLowerCase().includes(name.toLowerCase()));
const holidays = activeRiverName ? allCruises.filter(h => matchesRiver(h, activeRiverName!)) : allCruises;

// Chip row: single-name rivers with at least two cruises sold under their own name
const rivers = [...riverMap.entries()]
  .filter(([, name]) => !name.includes(',') && allCruises.filter(c => c.destination === name).length >= 2)
  .map(([slug, name]) => ({ slug, name, count: allCruises.filter(c => matchesRiver(c, name)).length }))
  .sort((a, b) => b.count - a.count);

// Departure windows (date on the card, months for the filter)
let windows = new Map<number, DepartureWindow>();
try { windows = await getDepartureWindows(getDb(Astro), holidays.map(h => h.id)); } catch (e) { console.error('windows failed', e); }

// Manual packages: ship + inclusions live in columns the listing query leaves out
const shipById = new Map<number, string>();
const includedById = new Map<number, string[]>();
try {
  const manualIds = holidays.filter(h => h.id < 10000).map(h => h.id);
  if (manualIds.length) {
    const rows = await getDb(Astro)
      .select({ id: flightPackages.id, accommodations: flightPackages.accommodations, whatsIncluded: flightPackages.whatsIncluded })
      .from(flightPackages)
      .where(inArray(flightPackages.id, manualIds));
    for (const r of rows) {
      includedById.set(r.id, ((r.whatsIncluded as string[] | null) || []).filter(Boolean));
      shipById.set(r.id, shipFromAccommodations(((r.accommodations as { name?: string }[] | null) || []).map(a => a.name || '')));
    }
  }
} catch (e) { console.error('manual lookup failed', e); }

// Month chips: the next 12 months, only those with a sailing
const now = new Date();
const monthChips = Array.from({ length: 12 }, (_, i) => {
  const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + i, 1));
  const ym = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
  const n = holidays.filter(h => windows.get(h.id)?.months.includes(ym)).length;
  return { value: String(d.getUTCMonth() + 1), label: `${MONTHS[d.getUTCMonth()]}${i === 0 || d.getUTCMonth() === 0 ? ' ' + d.getUTCFullYear() : ''}`, count: n };
}).filter(m => m.count > 0);
const lengthChips = [
  { key: 'short', label: '2 to 4 nights', count: holidays.filter(h => nightsOf(h) > 0 && nightsOf(h) <= 4).length },
  { key: 'week', label: '5 to 8 nights', count: holidays.filter(h => nightsOf(h) >= 5 && nightsOf(h) <= 8).length },
  { key: 'long', label: '9 nights and more', count: holidays.filter(h => nightsOf(h) >= 9).length },
].filter(c => c.count > 0);

const riverOf = (h: HolidayDetail) => (countryNames.has(h.destination) ? '' : h.destination);
const lengthKey = (n: number) => (n <= 4 ? 'short' : n <= 8 ? 'week' : 'long');

// SEO
const pageTitle = activeRiverName ? `${activeRiverName} River Cruises | Flights and Packages` : 'All River Cruises | Flights and Packages';
const pageDescription = activeRiverName
  ? `${holidays.length} ${activeRiverName} fly-cruise river holidays with flights from UK airports, full board and transfers included.`
  : `All ${holidays.length} fly-cruise river holidays on the Rhine, Danube, Douro, Seine and more, with flights from UK airports.`;
const heroTitle = activeRiverName ? `${activeRiverName} river cruises` : 'All river cruises';
const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'River Cruises', url: '/Holidays/river-cruises' },
  { name: activeRiverName ?? 'All cruises' },
];
const bannerImage = '/images/heroes/river-cruises-danube.jpg';
const itemListSchema = holidays.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: activeRiverName ? `${activeRiverName} River Cruises` : 'River Cruises',
  numberOfItems: holidays.length,
  itemListElement: holidays.slice(0, 20).map((h, i) => ({
    '@type': 'ListItem', position: i + 1, name: h.title,
    url: `https://holidays.flightsandpackages.com/Holidays/${h.countrySlug}/${h.slug}`, image: h.image,
  })),
} : null;
---
<BaseLayout title={pageTitle} description={pageDescription} image={bannerImage}>
  <link slot="head" rel="preload" as="image" type="image/jpeg" href={bannerImage} />
  <BreadcrumbSchema slot="head" items={breadcrumbItems} />
  {itemListSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
  <Header />
  <MobileNav />

  <section class="rl-hero" aria-label="Page hero">
    <img src={bannerImage} alt="" class="rl-hero-bg" fetchpriority="high" decoding="async" width="1920" height="776" />
    <nav class="rl-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">›</span>
      <a href="/Holidays/river-cruises">River Cruises</a><span aria-hidden="true">›</span>
      <span>{activeRiverName ?? 'All cruises'}</span>
    </nav>
    <div class="rl-hero-inner">
      <h1>{heroTitle}</h1>
    </div>
  </section>

  <section class="section-container rl-body">
    <div class="rl-chips" aria-label="Filters">
      <div class="rl-chip-row">
        <span class="rl-chip-label">River</span>
        <a class:list={['rl-chip', { active: !activeRiverName }]} href="/Holidays/river-cruises/all">All rivers</a>
        {rivers.map(r => <a class:list={['rl-chip', { active: activeRiverName === r.name }]} href={`/Holidays/river-cruises/${r.slug}`}>{r.name} <small>{r.count}</small></a>)}
      </div>
      {lengthChips.length > 1 && (
        <div class="rl-chip-row">
          <span class="rl-chip-label">Length</span>
          {lengthChips.map(c => <button type="button" class="rl-chip" data-filter="nights" data-value={c.key} aria-pressed="false">{c.label} <small>{c.count}</small></button>)}
        </div>
      )}
      {monthChips.length > 1 && (
        <div class="rl-chip-row">
          <span class="rl-chip-label">Month</span>
          {monthChips.map(m => <button type="button" class="rl-chip" data-filter="months" data-value={m.value} aria-pressed="false">{m.label} <small>{m.count}</small></button>)}
        </div>
      )}
    </div>

    <div class="rl-toolbar">
      <h2 class="rl-results" aria-live="polite" aria-atomic="true">{holidays.length} cruises</h2>
      <div class="rl-sort" role="group" aria-label="Sort order">
        <span>Price</span>
        <button type="button" class="rl-sort-btn active" data-sort="asc" aria-pressed="true">Low to high</button>
        <button type="button" class="rl-sort-btn" data-sort="desc" aria-pressed="false">High to low</button>
      </div>
    </div>

    <div class="rl-grid" id="rl-grid">
      {holidays.map(h => (
        <RiverCruiseCard
          holiday={h}
          window={windows.get(h.id)}
          ship={shipById.get(h.id)}
          included={includedById.get(h.id)}
          river={riverOf(h)}
          data={{
            price: String(fromPrice(h)),
            nights: lengthKey(nightsOf(h)),
            months: (windows.get(h.id)?.months || []).map(ym => String(parseInt(ym.slice(5, 7), 10))).join(','),
          }}
        />
      ))}
    </div>

    <div class="rl-more-wrap">
      <button type="button" class="rl-load-more btn-primary">Show more cruises</button>
    </div>
    <div class="rl-empty" hidden>
      <p>No cruises match those filters.</p>
      <button type="button" class="rl-clear">Clear filters</button>
    </div>
    <p class="rl-call">Prefer to talk it through? <a href="tel:02081830518">Call 0208 183 0518</a>, lines open 9am to 6pm.</p>
  </section>

  <Newsletter />
  <Footer />
  <MobileCallCTA />
</BaseLayout>

<style>
  .rl-hero { position: relative; height: clamp(300px, 22vw, 400px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; }
  .rl-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 62%; }
  .rl-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7,49,64,.25) 0%, rgba(7,49,64,.7) 100%); }
  .rl-crumbs { position: absolute; top: 12px; left: max(20px, calc((100vw - 1240px) / 2 + 20px)); z-index: 2; display: flex; gap: 8px; align-items: center; font-family: BentonSans, sans-serif; font-weight: 500; font-size: 13px; color: #fff; }
  .rl-crumbs a { color: #fff; text-decoration: none; }
  .rl-hero-inner { position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 0 20px 36px; width: 100%; }
  .rl-hero h1 { font-family: CaslonGraphiqueEF, Georgia, serif; font-weight: 400; font-size: 48px; line-height: 1.05; margin: 0; color: #fff; text-shadow: 0 2px 12px rgba(7,49,64,.45); }

  .rl-body { padding: 28px 20px 64px; }
  .rl-chips { display: flex; flex-direction: column; gap: 10px; padding-bottom: 20px; border-bottom: 1px solid #e3e8ea; }
  .rl-chip-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .rl-chip-label { font-family: BentonSans, sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; width: 64px; }
  .rl-chip { border: 1px solid #cfd8db; background: #fff; color: #424242; font-size: 13px; line-height: 1; padding: 9px 12px; border-radius: 999px; text-decoration: none; cursor: pointer; font-family: BentonSans, sans-serif; }
  .rl-chip small { font-size: 11px; color: #6b6b6b; margin-left: 4px; }
  .rl-chip:hover { border-color: #20A1AA; }
  .rl-chip.active, .rl-chip[aria-pressed="true"] { background: #073140; border-color: #073140; color: #fff; }
  .rl-chip.active small, .rl-chip[aria-pressed="true"] small { color: #9fd9dd; }

  .rl-toolbar { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding: 22px 0 18px; flex-wrap: wrap; }
  .rl-results { font-family: CaslonGraphiqueEF, Georgia, serif; font-weight: 400; font-size: 28px; margin: 0; color: #424242; }
  .rl-sort { display: flex; gap: 14px; align-items: center; font-size: 14px; color: #6b6b6b; }
  .rl-sort-btn { background: none; border: 0; padding: 0; font: inherit; color: #424242; cursor: pointer; border-bottom: 2px solid transparent; }
  .rl-sort-btn.active { color: #20A1AA; border-bottom-color: #20A1AA; }

  .rl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .rl-grid > :global(.rc-offer[hidden]) { display: none; }
  .rl-more-wrap { text-align: center; margin-top: 32px; }
  .rl-load-more { padding: 16px 32px; }
  .rl-empty { text-align: center; padding: 40px 0; }
  .rl-clear { background: none; border: 0; color: #20A1AA; text-decoration: underline; cursor: pointer; font: inherit; }
  .rl-call { text-align: center; margin: 36px 0 0; color: #6b6b6b; }
  .rl-call a { color: #20A1AA; font-weight: 500; }

  @media (max-width: 1100px) { .rl-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) { .rl-hero h1 { font-size: 34px; } .rl-chip-label { width: 100%; } }
  @media (max-width: 610px) { .rl-grid { grid-template-columns: 1fr; gap: 20px; } .rl-chip { padding: 8px 10px; } }
</style>

<script>
  // Chips (length/month) filter the server-rendered cards in place; the URL keeps the
  // state (?nights=, ?months=) so the landing-page tiles and shared links pre-apply it.
  const PAGE = 12;
  const grid = document.getElementById('rl-grid');
  const cards = Array.from(grid?.querySelectorAll<HTMLElement>('.rc-offer') ?? []);
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.rl-chip[data-filter]'));
  const results = document.querySelector<HTMLElement>('.rl-results');
  const loadMore = document.querySelector<HTMLButtonElement>('.rl-load-more');
  const empty = document.querySelector<HTMLElement>('.rl-empty');
  let shown = PAGE;
  let sortDir: 'asc' | 'desc' = 'asc';

  const params = new URLSearchParams(window.location.search);
  const state = {
    nights: new Set((params.get('nights') || '').split(',').filter(Boolean)),
    months: new Set((params.get('months') || '').split(',').filter(Boolean)),
  };

  function syncUrl() {
    const u = new URL(window.location.href);
    for (const k of ['nights', 'months'] as const) {
      const v = [...state[k]].join(',');
      if (v) u.searchParams.set(k, v); else u.searchParams.delete(k);
    }
    history.replaceState(null, '', u.toString());
  }

  function matches(card: HTMLElement): boolean {
    const n = card.dataset.nights || '';
    const ms = (card.dataset.months || '').split(',');
    const okNights = state.nights.size === 0 || state.nights.has(n);
    const okMonths = state.months.size === 0 || [...state.months].some(m => ms.includes(m));
    return okNights && okMonths;
  }

  function render(reset = true) {
    if (reset) shown = PAGE;
    const matched = cards.filter(matches).sort((a, b) => {
      const d = Number(a.dataset.price) - Number(b.dataset.price);
      return sortDir === 'asc' ? d : -d;
    });
    for (const c of cards) c.hidden = true;
    matched.forEach((c, i) => { c.hidden = i >= shown; grid?.appendChild(c); });
    if (results) results.textContent = `${matched.length} ${matched.length === 1 ? 'cruise' : 'cruises'}`;
    if (loadMore) loadMore.hidden = matched.length <= shown;
    if (empty) empty.hidden = matched.length > 0;
    for (const chip of chips) {
      const k = chip.dataset.filter as 'nights' | 'months';
      chip.setAttribute('aria-pressed', state[k].has(chip.dataset.value || '') ? 'true' : 'false');
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const k = chip.dataset.filter as 'nights' | 'months';
      const v = chip.dataset.value || '';
      if (state[k].has(v)) state[k].delete(v); else state[k].add(v);
      syncUrl(); render();
    });
  }
  document.querySelectorAll<HTMLButtonElement>('.rl-sort-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      sortDir = (btn.dataset.sort as 'asc' | 'desc') || 'asc';
      document.querySelectorAll('.rl-sort-btn').forEach(b => { b.classList.toggle('active', b === btn); b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
      render();
    });
  });
  loadMore?.addEventListener('click', () => { shown += PAGE; render(false); });
  document.querySelector('.rl-clear')?.addEventListener('click', () => { state.nights.clear(); state.months.clear(); syncUrl(); render(); });
  render();
</script>
