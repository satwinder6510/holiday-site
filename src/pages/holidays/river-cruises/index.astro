---
export const prerender = false;

/**
 * River cruises LANDING page — a doorway, not a list.
 *
 * Special offers first (the only prices on the page), then tiles by river, by
 * length and by season that each open the filtered listing at /river-cruises/all
 * (or /river-cruises/<river>), then the ships, then why-book-with-us and the phone.
 * The 159-card listing lives one click behind every tile.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import MobileNav from '../../../components/MobileNav.astro';
import Footer from '../../../components/Footer.astro';
import Newsletter from '../../../components/Newsletter.astro';
import MobileCallCTA from '../../../components/MobileCallCTA.astro';
import BreadcrumbSchema from '../../../components/BreadcrumbSchema.astro';
import { getDb } from '../../../lib/get-db';
import { getAllListedHolidaysFromDb, getDepartureWindows, type DepartureWindow } from '../../../lib/holidays-db';
import { slugifyRiver, cleanCruiseTitle, type HolidayDetail } from '../../../lib/holiday-transforms';
import { roundToNine } from '../../../lib/pricing-transforms';
import { imgSrc } from '../../../lib/image-src';
import { flightPackages } from '../../../lib/db-schema';
import { inArray } from 'drizzle-orm';

const PHONE = '0208 183 0518';
const PHONE_HREF = 'tel:02081830518';

let cruises: HolidayDetail[];
let windows: Map<number, DepartureWindow>;
try {
  const db = getDb(Astro);
  const all = await getAllListedHolidaysFromDb(db);
  cruises = all.filter(h => h.tags.includes('River Cruise'));
  windows = await getDepartureWindows(db, cruises.map(h => h.id));
} catch (e) {
  console.error('DB error on river-cruises landing:', e);
  return new Response('Service temporarily unavailable', { status: 503 });
}

const fromPrice = (h: HolidayDetail) => h.displayPrice ?? roundToNine(h.price + h.localChargesPp);
// Tile photo: prefer a Widgety cruise (ids over 10000), whose image is the ship's exterior cover;
// manual packages' featured images can be a cabin or bar.
const tileImage = (list: HolidayDetail[]) => (list.find(h => h.id > 10000 && h.image) || list.find(h => h.image))?.image || '';
const nightsOf = (h: HolidayDetail) => { const m = h.duration.match(/(\d+)\s*Nights/i); return m ? parseInt(m[1], 10) : 0; };
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthLabel = (ym: string) => `${MONTHS[parseInt(ym.slice(5, 7), 10) - 1]} ${ym.slice(0, 4)}`;
const dateLabel = (iso: string) => {
  const d = new Date(iso.slice(0, 10) + 'T00:00:00Z');
  return `${String(d.getUTCDate()).padStart(2, '0')} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
};
function sailsLabel(w: DepartureWindow | undefined): string {
  if (!w) return '';
  const a = w.first.slice(0, 7), b = w.last.slice(0, 7);
  if (a === b) return `Sails ${monthLabel(a)}`;
  if (a.slice(0, 4) === b.slice(0, 4)) return `Sails ${MONTHS[parseInt(a.slice(5, 7), 10) - 1]} to ${monthLabel(b)}`;
  return `Sails ${monthLabel(a)} to ${monthLabel(b)}`;
}

// ── Special offers ───────────────────────────────────────────────────
const offers = cruises
  .filter(h => h.isSpecialOffer && fromPrice(h) > 0)
  .sort((a, b) => fromPrice(a) - fromPrice(b))
  .slice(0, 9);

// Manually built cruise packages carry the ship under accommodations ("MS Vivaldi"),
// which the listing query leaves out. Fetch just those rows for the offers shown.
const shipByPackage = new Map<number, string>();
try {
  const manualIds = offers.filter(h => !h.shipName && h.id < 10000).map(h => h.id);
  if (manualIds.length) {
    const rows = await getDb(Astro)
      .select({ id: flightPackages.id, accommodations: flightPackages.accommodations })
      .from(flightPackages)
      .where(inArray(flightPackages.id, manualIds));
    for (const r of rows) {
      const names = ((r.accommodations as { name?: string }[] | null) || []).map(a => a.name || '');
      // Two entries = pre-cruise hotel + ship; drop anything that reads as a hotel, keep the last.
      const ships = names.filter(n => n && !/\b(hotel|inn|palace|palazzo|plaza|palais|resort|apartments?)\b/i.test(n));
      const ship = ships[ships.length - 1] || '';
      if (ship) shipByPackage.set(r.id, ship.trim());
    }
  }
} catch (e) {
  console.error('ship lookup failed:', e);
}
const shipOf = (h: HolidayDetail) => h.shipName || shipByPackage.get(h.id) || '';

// ── Rivers (same derivation as the listing so tile links resolve) ───
const countryNames = new Set(cruises.map(c => c.country));
const riverOf = (c: HolidayDetail) => (countryNames.has(c.destination) ? '' : c.destination);
// One tile per single-name river ("Rhine", not "Dutch Waterways, Rhine"); a multi-river
// destination counts under each river it names, which is how the listing filter matches.
const riverMap = new Map<string, { slug: string; name: string; count: number; image: string }>();
for (const c of cruises) {
  const name = riverOf(c);
  if (!name || name.includes(',')) continue;
  const slug = slugifyRiver(name);
  if (!riverMap.has(slug)) riverMap.set(slug, { slug, name, count: 0, image: c.image });
}
for (const r of riverMap.values()) {
  r.count = cruises.filter(c =>
    c.destination === r.name || c.destination.includes(r.name) ||
    (!riverOf(c) && c.title.toLowerCase().includes(r.name.toLowerCase())),
  ).length;
}
// A river earns a tile when at least two cruises are sold under its own name; rivers
// that only ever appear as the second half of a pairing ("Rhone, Saone") ride along.
const soloCount = (name: string) => cruises.filter(c => c.destination === name).length;
// Hand-picked river photos (public/images/rivers/<slug>.jpg). A slug listed here wins
// over the automatic ship cover; add a line when the file is added.
const RIVER_IMAGES: Record<string, string> = {
};
const rivers = [...riverMap.values()]
  .filter(r => soloCount(r.name) >= 2)
  .sort((a, b) => b.count - a.count)
  .slice(0, 9)
  .map(r => ({ ...r, image: RIVER_IMAGES[r.slug] || r.image }));

// ── Length ───────────────────────────────────────────────────────────
const lengths = [
  { key: 'short', title: 'Short breaks', sub: '2 to 4 nights', test: (n: number) => n > 0 && n <= 4 },
  { key: 'week', title: 'A week away', sub: '5 to 8 nights', test: (n: number) => n >= 5 && n <= 8 },
  { key: 'long', title: 'The long way round', sub: '9 nights and more', test: (n: number) => n >= 9 },
].map(l => {
  const matches = cruises.filter(h => l.test(nightsOf(h)));
  return { ...l, count: matches.length, image: tileImage(matches) };
});

// ── Season (months with a sailing, next 12 months) ──────────────────
const seasons = [
  { key: 'christmas', title: 'Christmas markets', sub: 'Sailings in November and December', months: [11, 12] },
  { key: 'spring', title: 'Spring blossom', sub: 'Sailings March to May', months: [3, 4, 5] },
  { key: 'summer', title: 'Summer on the water', sub: 'Sailings June to August', months: [6, 7, 8] },
  { key: 'autumn', title: 'Autumn colours', sub: 'Sailings September and October', months: [9, 10] },
].map(s => {
  const matches = cruises.filter(h => {
    const w = windows.get(h.id);
    return w?.months.some(ym => s.months.includes(parseInt(ym.slice(5, 7), 10)));
  });
  return { ...s, count: matches.length, image: tileImage(matches), query: s.months.join(',') };
});

// ── Ships / operators ───────────────────────────────────────────────
const OPERATOR_COPY: Record<string, string> = {
  croisieurope: 'French family-owned line with the largest river fleet in Europe. All meals, drinks with meals and the open bar are included.',
  'a-rosa': 'German premium ships with bigger cabins, a pool deck on most and a relaxed, all-inclusive style.',
  viva: 'Boutique ships with a fine-dining focus and everything included, from the bar to the excursions.',
};
const operatorKey = (op: string) => {
  const k = op.toLowerCase().replace(/[^a-z-]/g, '');
  return k.startsWith('croisi') ? 'croisieurope' : k.startsWith('a-rosa') || k.startsWith('arosa') ? 'a-rosa' : k.startsWith('viva') ? 'viva' : k;
};
const operatorsMap = new Map<string, { name: string; count: number; image: string; ships: Set<string>; copy: string }>();
for (const c of cruises) {
  if (!c.operator) continue;
  const key = operatorKey(c.operator);
  const o = operatorsMap.get(key) ?? { name: c.operator, count: 0, image: c.image, ships: new Set<string>(), copy: OPERATOR_COPY[key] || '' };
  o.count += 1;
  if (c.shipName) o.ships.add(c.shipName);
  operatorsMap.set(key, o);
}
const operators = [...operatorsMap.values()].sort((a, b) => b.count - a.count);

// ── SEO ─────────────────────────────────────────────────────────────
const pageTitle = 'River Cruises with Flights from the UK | Flights and Packages';
const pageDescription = `${cruises.length} fly-cruise river holidays on the Rhine, Danube, Douro, Seine and more. Flights from UK airports, full board and transfers included. Call ${PHONE}.`;
const bannerImage = '/images/heroes/river-cruises-sunset-deck.jpg'; // MV La Belle de l'Adriatique sun deck, 1920x425 panorama, CroisiEurope / Alexandre Sattler
const breadcrumbItems = [{ name: 'Home', url: '/' }, { name: 'River Cruises' }];
---
<BaseLayout title={pageTitle} description={pageDescription} image={bannerImage}>
  <link slot="head" rel="preload" as="image" type="image/jpeg" href={bannerImage} />
  <BreadcrumbSchema slot="head" items={breadcrumbItems} />
  <Header />
  <MobileNav />

  <section class="rc-hero" aria-label="River cruises">
    <img src={bannerImage} alt="" class="rc-hero-bg" fetchpriority="high" decoding="async" width="1920" height="425" />
    <div class="rc-hero-inner">
      <p class="rc-kicker">Fly-cruise river holidays</p>
      <h1>River cruises with flights from the UK</h1>
    </div>
  </section>

  {offers.length > 0 && (
    <section class="section-container rc-section rc-offers">
      <div class="rc-heading">
        <p class="section-label">this week</p>
        <h2>Special offers</h2>
        <a class="rc-more" href="/Holidays/river-cruises/all?special=1">All offers</a>
      </div>
      <div class="rc-offer-grid">
        {offers.map(h => {
          const w = windows.get(h.id);
          const nights = nightsOf(h);
          const url = `/Holidays/${h.countrySlug}/${h.slug}`;
          return (
          <article class="rc-offer">
            <a class="rc-offer-img" href={url} aria-hidden="true" tabindex="-1">
              <img src={imgSrc(h.image, 800)} alt="" loading="lazy" decoding="async" width="800" height="500" />
              <span class="rc-pills">
                <span class="rc-pill">Special offer</span>
                {riverOf(h) && <span class="rc-pill">{riverOf(h)}</span>}
              </span>
              {h.operator && <span class="rc-operator">{h.operator}</span>}
            </a>
            <div class="rc-offer-body">
              <h3><a href={url}>{cleanCruiseTitle(h.title)}</a></h3>
              <ul class="rc-facts">
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="m9 15 2 2 4-4"/></svg>
                  <span>{w ? dateLabel(w.cheapestDate || w.first) : 'Call for dates'}</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.5A8 8 0 0 1 8.5 4a8 8 0 1 0 11.5 11.5Z"/></svg>
                  <span>{nights} nights</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17c2 1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0"/><path d="M4 14l1.5-4h13L20 14"/><path d="M7 10V6h10v4"/><path d="M12 3v3"/></svg>
                  <span>{shipOf(h) || h.operator || 'Ship confirmed on booking'}</span>
                </li>
              </ul>
              <div class="rc-offer-foot">
                <p class="rc-price"><span>from</span>£{fromPrice(h).toLocaleString('en-GB')}<small>/pp</small></p>
                <a class="rc-view" href={url}>View more <span aria-hidden="true">›</span></a>
              </div>
            </div>
          </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- By river: dark full-bleed band, tall portrait tiles edge to edge -->
  <section class="rc-band rc-band-dark" aria-labelledby="rc-rivers-h">
    <div class="section-container rc-band-head">
      <div>
        <p class="section-label">choose your river</p>
        <h2 id="rc-rivers-h">By river</h2>
      </div>
      <div class="rc-arrows" data-strip="rivers">
        <button type="button" class="rc-arrow" data-dir="-1" aria-label="Previous rivers">&larr;</button>
        <button type="button" class="rc-arrow" data-dir="1" aria-label="Next rivers">&rarr;</button>
      </div>
    </div>
    <div class="rc-strip" id="strip-rivers">
      {rivers.map(r => (
        <a class="rc-portrait" href={`/Holidays/river-cruises/${r.slug}`}>
          <img src={imgSrc(r.image, 640)} alt="" loading="lazy" decoding="async" width="640" height="1000" />
          <span class="rc-tile-count">{r.count} {r.count === 1 ? 'cruise' : 'cruises'}</span>
          <span class="rc-portrait-name">{r.name}</span>
        </a>
      ))}
    </div>
    <div class="section-container rc-band-foot">
      <a class="btn-primary rc-explore" href="/Holidays/river-cruises/all">All rivers</a>
    </div>
  </section>

  <!-- By length: text column beside three portrait cards -->
  <section class="section-container rc-section rc-split" aria-labelledby="rc-length-h">
    <div class="rc-split-text">
      <p class="section-label">how long</p>
      <h2 id="rc-length-h">By length</h2>
      <p>Two to four nights is a taster, usually with a city at one end. A week is the classic river cruise. Nine nights and more takes in two rivers, or the whole length of one.</p>
    </div>
    <div class="rc-split-cards">
      {lengths.filter(l => l.count > 0).map(l => (
        <a class="rc-portrait rc-portrait-sm" href={`/Holidays/river-cruises/all?nights=${l.key}`}>
          <img src={imgSrc(l.image, 640)} alt="" loading="lazy" decoding="async" width="640" height="900" />
          <span class="rc-tile-count">{l.count} cruises</span>
          <span class="rc-portrait-name">{l.title}<small>{l.sub}</small></span>
        </a>
      ))}
    </div>
  </section>

  <!-- By season: staggered tiles on a grey band -->
  <section class="rc-band rc-band-grey" aria-labelledby="rc-season-h">
    <div class="section-container">
      <div class="rc-heading">
        <p class="section-label">when to go</p>
        <h2 id="rc-season-h">By season</h2>
      </div>
      <div class="rc-stagger">
        {seasons.filter(s => s.count > 0).map(s => (
          <a class="rc-tile rc-tile-tall" href={`/Holidays/river-cruises/all?months=${s.query}`}>
            <img src={imgSrc(s.image, 640)} alt="" loading="lazy" decoding="async" width="640" height="800" />
            <span class="rc-tile-count">{s.count} cruises</span>
            <span class="rc-tile-name">{s.title}<small>{s.sub}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {operators.length > 0 && (
    <section class="section-container rc-section">
      <div class="rc-heading">
        <p class="section-label">who you sail with</p>
        <h2>The ships</h2>
      </div>
      <div class="rc-ops">
        {operators.map(o => (
          <article class="rc-op">
            <img src={imgSrc(o.image, 640)} alt="" loading="lazy" decoding="async" width="640" height="400" />
            <div class="rc-op-body">
              <h3>{o.name}</h3>
              {o.copy && <p>{o.copy}</p>}
              <p class="rc-op-meta">{o.count} {o.count === 1 ? 'cruise' : 'cruises'}{o.ships.size > 0 ? ` on ${o.ships.size} ${o.ships.size === 1 ? 'ship' : 'ships'}` : ''}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="rc-why">
    <div class="section-container rc-why-inner">
      <div>
        <p class="section-label">why book with us</p>
        <h2>One call sorts the lot</h2>
        <ul>
          <li>Return flights from your nearest UK airport, matched to the sailing</li>
          <li>Transfers, full board and the cabin you actually want</li>
          <li>ATOL protected, and a person on the phone who has done it before</li>
        </ul>
      </div>
      <div class="rc-why-call">
        <p>Lines open 9am to 6pm</p>
        <a class="btn-primary rc-call" href={PHONE_HREF}>Call {PHONE}</a>
        <a class="rc-link" href="/Holidays/river-cruises/all">Browse all {cruises.length} cruises</a>
      </div>
    </div>
  </section>

  <Newsletter />
  <Footer />
  <MobileCallCTA />
</BaseLayout>

<style>
  /* The hero photo is a 1920x425 panorama: hold its native ratio (22.1vw) so it is never
     upscaled on a desktop. Floor of 360px keeps room for the headline on laptops. */
  .rc-hero { position: relative; height: clamp(360px, 22.1vw, 425px); display: flex; align-items: center; color: #fff; overflow: hidden; }
  .rc-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .rc-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7,49,64,.15) 0%, rgba(7,49,64,.65) 100%); }
  .rc-hero-inner { position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 40px 20px; width: 100%; }
  /* Explicit white: the global p colour would otherwise win over the hero's inherited colour. */
  .rc-kicker { font-family: BentonSans, sans-serif; font-weight: 500; letter-spacing: 3px; text-transform: uppercase; font-size: 13px; margin: 0 0 12px; color: #fff; }
  .rc-hero h1 { font-family: CaslonGraphiqueEF, Georgia, serif; font-weight: 400; font-size: 52px; line-height: 1.05; margin: 0; max-width: 760px; color: #fff; text-shadow: 0 2px 12px rgba(7,49,64,.45); }
  .rc-call { font-size: 17px; padding: 14px 26px; }
  .rc-link { color: #fff; text-decoration: underline; text-underline-offset: 4px; font-weight: 500; }
  .rc-section .rc-link { color: #20A1AA; }

  .rc-section { padding: 56px 20px 8px; }
  .rc-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 24px; margin-bottom: 22px; }
  .rc-heading h2 { font-family: CaslonGraphiqueEF, Georgia, serif; font-weight: 400; font-size: 40px; margin: 0; color: #424242; }
  .rc-heading .section-label, .rc-why .section-label {
    margin: 0 0 6px; width: 100%; order: -1;
    font-family: BentonSans, sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #20A1AA;
  }
  .rc-more { margin-left: auto; color: #20A1AA; font-weight: 500; text-decoration: none; border-bottom: 1px solid currentColor; }

  /* Special offers — the cruise-site card: pills on the photo, operator mark, fact strip, price + View more */
  .rc-offer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .rc-offer { background: #fff; border-radius: 6px; box-shadow: 0 6px 16px rgba(0,0,0,.08); overflow: hidden; display: flex; flex-direction: column; }
  .rc-offer-img { position: relative; display: block; aspect-ratio: 16 / 10; background: #eef2f3; }
  .rc-offer-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rc-pills { position: absolute; top: 14px; left: 14px; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .rc-pill { background: #073140; color: #fff; font-size: 12px; font-weight: 500; padding: 7px 12px; border-radius: 999px; white-space: nowrap; }
  .rc-operator { position: absolute; right: 0; bottom: 0; background: #fff; color: #073140; font-size: 12px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; padding: 10px 16px; border-top-left-radius: 6px; }
  .rc-offer-body { padding: 22px 24px 24px; display: flex; flex-direction: column; flex: 1; }
  .rc-offer h3 { font-family: CaslonGraphiqueEF, Georgia, serif; font-weight: 400; font-size: 24px; line-height: 1.2; margin: 0 0 20px; height: 3.6em; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .rc-offer h3 a { color: #424242; text-decoration: none; }
  .rc-facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid #e3e8ea; border-radius: 4px; }
  .rc-facts li { padding: 14px 8px; text-align: center; font-size: 13px; line-height: 18px; color: #424242; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .rc-facts li + li { border-left: 1px solid #e3e8ea; }
  .rc-facts svg { width: 26px; height: 26px; fill: none; stroke: #20A1AA; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .rc-offer-foot { margin-top: auto; padding-top: 18px; border-top: 1px dashed #d9dfe2; display: flex; align-items: center; justify-content: space-between; }
  .rc-facts { margin-bottom: 22px; }
  .rc-price { margin: 0; font-family: CaslonGraphiqueEF, Georgia, serif; font-size: 34px; line-height: 1; color: #20A1AA; }
  .rc-price span { font-family: BentonSans, sans-serif; font-size: 13px; display: block; margin-bottom: 6px; color: #424242; }
  .rc-price small { font-family: BentonSans, sans-serif; font-size: 14px; color: #424242; }
  .rc-view { background: #20A1AA; color: #fff; text-decoration: none; font-weight: 500; font-size: 14px; letter-spacing: .5px; text-transform: uppercase; padding: 16px 20px; border-radius: 3px; white-space: nowrap; }
  .rc-view span { margin-left: 6px; }

  /* Tiles */
  .rc-tiles { display: grid; gap: 18px; }
  .rc-tiles-3 { grid-template-columns: repeat(3, 1fr); }
  .rc-tiles-4 { grid-template-columns: repeat(4, 1fr); }
  .rc-tile { position: relative; display: block; aspect-ratio: 16 / 10; border-radius: 4px; overflow: hidden; color: #fff; text-decoration: none; background: #073140; }
  .rc-tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .rc-tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7,49,64,0) 35%, rgba(7,49,64,.8) 100%); }
  .rc-tile:hover img { transform: scale(1.04); }
  .rc-tile-name { position: absolute; left: 18px; bottom: 16px; right: 18px; z-index: 1; font-family: CaslonGraphiqueEF, Georgia, serif; font-size: 26px; line-height: 1.1; }
  .rc-tile-name small { display: block; font-family: BentonSans, sans-serif; font-size: 13px; margin-top: 4px; opacity: .9; }
  .rc-tile-count { position: absolute; right: 14px; top: 14px; z-index: 1; background: rgba(255,255,255,.92); color: #073140; font-size: 12px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; padding: 7px 11px; border-radius: 3px; }

  /* Full-bleed bands */
  .rc-band { margin-top: 64px; padding: 56px 0 48px; }
  .rc-band-dark { background: linear-gradient(180deg, #0b2b38 0%, #073140 100%); color: #fff; }
  .rc-band-dark h2 { color: #fff; }
  .rc-band-dark .section-label { color: #9fd9dd; }
  .rc-band-grey { background: #f2f5f6; }
  .rc-band-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 26px; padding-left: 20px; padding-right: 20px; }
  .rc-band-head h2 { font-family: CaslonGraphiqueEF, Georgia, serif; font-weight: 400; font-size: 40px; margin: 0; }
  .rc-band-head .section-label, .rc-split-text .section-label, .rc-band-grey .section-label {
    margin: 0 0 6px; font-family: BentonSans, sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: #20A1AA;
  }
  .rc-band-foot { padding: 28px 20px 0; }
  .rc-explore { display: inline-block; padding: 16px 28px; font-size: 14px; letter-spacing: 1px; text-transform: uppercase; background: #20A1AA; color: #fff; text-decoration: none; border-radius: 3px; }
  .rc-arrows { display: flex; gap: 6px; }
  .rc-arrow { width: 56px; height: 56px; border: 0; background: rgba(255,255,255,.12); color: #fff; font-size: 20px; cursor: pointer; }
  .rc-arrow:hover { background: rgba(255,255,255,.22); }

  /* Edge-to-edge strip of tall tiles (scroll-snap; arrows nudge it) */
  .rc-strip { --edge: max(20px, calc((100vw - 1240px) / 2 + 20px)); display: flex; gap: 6px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: var(--edge); scrollbar-width: none; padding: 0 var(--edge); }
  .rc-strip::-webkit-scrollbar { display: none; }
  .rc-portrait { position: relative; flex: 0 0 296px; aspect-ratio: 296 / 515; scroll-snap-align: start; overflow: hidden; color: #fff; text-decoration: none; background: #073140; display: block; }
  .rc-portrait img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .rc-portrait::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7,49,64,0) 45%, rgba(7,49,64,.85) 100%); }
  .rc-portrait:hover img { transform: scale(1.04); }
  .rc-portrait-name { position: absolute; left: 18px; right: 18px; bottom: 22px; z-index: 1; font-family: CaslonGraphiqueEF, Georgia, serif; font-size: 30px; line-height: 1.1; }
  .rc-portrait-name small { display: block; font-family: BentonSans, sans-serif; font-size: 13px; margin-top: 6px; opacity: .9; }

  /* Text column beside cards */
  .rc-split { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: center; }
  .rc-split-text h2 { font-family: CaslonGraphiqueEF, Georgia, serif; font-weight: 400; font-size: 40px; margin: 0 0 16px; color: #424242; }
  .rc-split-text p:not(.section-label) { line-height: 26px; margin: 0; }
  .rc-split-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .rc-portrait-sm { flex: none; aspect-ratio: 3 / 4; border-radius: 4px; }
  .rc-portrait-sm .rc-portrait-name { font-size: 24px; }

  /* Staggered tiles */
  .rc-stagger { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; align-items: start; }
  .rc-stagger .rc-tile-tall { aspect-ratio: 4 / 5; }
  .rc-stagger > :nth-child(even) { margin-top: 44px; }

  /* Operators */
  .rc-ops { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .rc-op { background: #fff; border-radius: 4px; box-shadow: 0 6px 12px 2px rgba(0,0,0,.08); overflow: hidden; }
  .rc-op img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .rc-op-body { padding: 18px; }
  .rc-op h3 { font-family: CaslonGraphiqueEF, Georgia, serif; font-weight: 400; font-size: 24px; margin: 0 0 8px; color: #424242; }
  .rc-op p { margin: 0 0 8px; line-height: 24px; }
  .rc-op-meta { color: #6b6b6b; font-size: 13px; }

  /* Why */
  .rc-why { background: #073140; color: #fff; margin-top: 64px; padding: 56px 20px; }
  .rc-why-inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center; }
  .rc-why h2 { font-family: CaslonGraphiqueEF, Georgia, serif; font-weight: 400; font-size: 40px; margin: 0 0 16px; color: #fff; }
  .rc-why .section-label { color: #9fd9dd; }
  .rc-why ul { margin: 0; padding: 0; list-style: none; line-height: 30px; font-size: 16px; }
  .rc-why li::before { content: '✓'; color: #9fd9dd; margin-right: 10px; font-weight: 700; }
  .rc-why-call { text-align: center; }
  .rc-why-call p { margin: 0 0 14px; opacity: .85; }
  .rc-why-call .rc-link { display: block; margin-top: 16px; }

  @media (max-width: 1100px) {
    .rc-offer-grid { grid-template-columns: repeat(2, 1fr); }
    .rc-tiles-4 { grid-template-columns: repeat(2, 1fr); }
    .rc-split { grid-template-columns: 1fr; gap: 28px; }
    .rc-stagger { grid-template-columns: repeat(2, 1fr); }
    .rc-stagger > :nth-child(even) { margin-top: 0; }
    .rc-stagger > :nth-child(4n+2), .rc-stagger > :nth-child(4n+3) { margin-top: 0; }
  }
  @media (max-width: 768px) {
    .rc-hero { height: 360px; }
    .rc-hero h1 { font-size: 38px; }
    .rc-hero-inner { padding: 48px 20px; }
    .rc-tiles-3 { grid-template-columns: repeat(2, 1fr); }
    .rc-ops { grid-template-columns: 1fr; }
    .rc-why-inner { grid-template-columns: 1fr; }
    .rc-heading h2 { font-size: 32px; }
  }
  @media (max-width: 610px) {
    .rc-offer-grid, .rc-tiles-3, .rc-tiles-4, .rc-split-cards { grid-template-columns: 1fr; }
    .rc-stagger { grid-template-columns: 1fr 1fr; gap: 12px; }
    .rc-portrait { flex-basis: 240px; }
    .rc-band-head h2, .rc-split-text h2 { font-size: 30px; }
    .rc-arrows { display: none; }
    .rc-heading { align-items: flex-end; }
    .rc-heading h2 { font-size: 30px; }
    .rc-more { margin-bottom: 6px; }
    .rc-section { padding-top: 40px; }
    .rc-tile-name { font-size: 22px; }
  }
</style>

<script>
  // Strip arrows: nudge the edge-to-edge tile strip by one tile.
  document.querySelectorAll<HTMLElement>('.rc-arrows').forEach(arrows => {
    const strip = document.getElementById(`strip-${arrows.dataset.strip}`);
    if (!strip) return;
    arrows.querySelectorAll<HTMLButtonElement>('.rc-arrow').forEach(btn => {
      btn.addEventListener('click', () => {
        const tile = strip.querySelector<HTMLElement>('.rc-portrait');
        const step = (tile?.getBoundingClientRect().width || 300) + 6;
        strip.scrollBy({ left: step * Number(btn.dataset.dir || 1), behavior: 'smooth' });
      });
    });
  });
</script>
