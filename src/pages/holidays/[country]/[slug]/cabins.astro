---
/**
 * Step two of choosing a river cruise: the cabin, for ONE sailing.
 *
 * Step one (the cruise page) is airport then date; each sailing row links here
 * with ?date=YYYY-MM-DD&airport=CODE. This page shows the cabins on that sailing
 * at that airport's price, how many are travelling, the total, and two doors:
 * a written quote with everything filled in, or a call quoting the reference.
 * One decision per screen (owner 2026-09-27, from the Riverwise mock: "choose
 * date > next page choose cabin").
 *
 * The airport can still be changed here: each chip is a link back to this page
 * with a different code, so it works without JS. Only the traveller count and the
 * running total are scripted.
 */
export const prerender = false;
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import MobileNav from '../../../../components/MobileNav.astro';
import Footer from '../../../../components/Footer.astro';
import CallLink from '../../../../components/cruise/CallLink.astro';
import { getDb } from '../../../../lib/get-db';
import { getHolidayBySlugFromDb } from '../../../../lib/holidays-db';
import { getSailingLadders, gradePrice, directSaving } from '../../../../lib/cruise-detail';
import { getCabinTypes, matchCabinTypes } from '../../../../lib/cabin-types';
import { formatPrice } from '../../../../lib/pricing-transforms';
import { imgSrc } from '../../../../lib/image-src';
import { cleanCruiseTitle } from '../../../../lib/holiday-transforms';

const TEL_DISPLAY = '0208 183 0518';
const TEL_HREF = 'tel:+442081830518';

const { country, slug } = Astro.params;
const date = (Astro.url.searchParams.get('date') || '').slice(0, 10);
const airportParam = (Astro.url.searchParams.get('airport') || '').toUpperCase();
const cruiseUrl = `/Holidays/${country}/${slug}`;

const db = getDb(Astro);
const result = await getHolidayBySlugFromDb(db, slug!);
if (!result || !result.pricing || !result.holiday.tags.includes('River Cruise')) {
  return Astro.redirect(cruiseUrl, 302);
}
const { holiday, pricing } = result;
if (country && holiday.countrySlug && country.toLowerCase() !== holiday.countrySlug.toLowerCase()) {
  return Astro.redirect(`/Holidays/${holiday.countrySlug}/${slug}/cabins${Astro.url.search}`, 301);
}

const [ladders, cabinTypes] = await Promise.all([
  getSailingLadders(db, holiday.id),
  getCabinTypes(db, holiday.id),
]);
const ladder = ladders.find(l => l.date === date);
if (!ladder || !ladder.grades.length) {
  return Astro.redirect(`${cruiseUrl}#sailings`, 302);
}

// Airports with a flight price on this sailing, cheapest first.
type Dep = { airportCode: string; airportName: string; pricePp: number; date: string };
const deps = (pricing.departures as Dep[]).filter(d => d.date.slice(0, 10) === date);
const byCode = new Map<string, Dep>();
for (const d of deps) { const seen = byCode.get(d.airportCode); if (!seen || d.pricePp < seen.pricePp) byCode.set(d.airportCode, d); }
const airports = [...byCode.values()].sort((a, b) => a.pricePp - b.pricePp);
if (!airports.length) {
  return Astro.redirect(`${cruiseUrl}#sailings`, 302);
}
// An airport with no flight on this sailing: land on the cheapest one and say so,
// with the URL rewritten so it never contradicts the page.
if (airportParam && !byCode.has(airportParam)) {
  return Astro.redirect(`?date=${date}&airport=${airports[0].airportCode}&from=${airportParam}`, 302);
}
const chosen = byCode.get(airportParam) ?? airports[0];
const fromCode = (Astro.url.searchParams.get('from') || '').toUpperCase();
const allAirports = (pricing.airports as { code: string; name: string }[]) || [];
const swappedFrom = fromCode && fromCode !== chosen.airportCode ? (allAirports.find(a => a.code === fromCode)?.name || fromCode) : '';

const cabinInfo = matchCabinTypes(ladder.grades.map(g => g.cabinType), cabinTypes);
const grades = [...ladder.grades].sort((a, b) => a.netPp - b.netPp);
interface CabinCard { id: string; cabinType: string; name: string; deck: string | null; label: string; price: number; saving: number | null; facts: string[]; summary: string; equipment: string[]; image: string }
interface CabinCardExtra extends CabinCard { alsoAt: number[] }
const cabinsRaw: CabinCard[] = grades.flatMap((g, i): CabinCard[] => {
  const price = gradePrice(ladder, chosen.pricePp, g.cabinType);
  const info = cabinInfo[g.cabinType];
  const facts = [
    info?.sizeSqm ? `${info.sizeSqm} m²` : null,
    g.deck ? `${g.deck}${/deck$/i.test(g.deck) ? '' : ' deck'}` : null,
    info?.outlook,
    info?.sleeps ? `Sleeps ${info.sleeps}` : null,
  ].filter((f): f is string => !!f);
  if (price == null) return [];
  const shipShots = holiday.cabinImages || [];
  const fallback = shipShots.length ? imgSrc(shipShots[i % shipShots.length], 600) : '';
  return [{
    id: `cabin-${i}`,
    cabinType: g.cabinType,
    name: g.name,
    deck: g.deck,
    label: g.deck ? `${g.name}, ${g.deck}` : g.name,
    price,
    saving: directSaving(g, price),
    facts,
    summary: info?.summary || '',
    equipment: info?.equipment || [],
    image: info?.images[0] ? imgSrc(info.images[0], 600) : fallback,
  }];
});
// CroisiEurope sells "Cat A/B/C" on the same deck — same cabin, different position,
// three prices. One card at the cheapest, with the other prices named on it,
// instead of three identical cards (fine-detail audit 2026-09-27).
const cabins: CabinCardExtra[] = [];
for (const c of cabinsRaw) {
  const same = cabins.find(x => x.label === c.label && x.summary === c.summary);
  if (same) { same.alsoAt.push(c.price); continue; }
  cabins.push({ ...c, alsoAt: [] });
}

const nights = (() => { const m = holiday.duration.match(/(\d+)\s*Night/i); return m ? Number(m[1]) : 0; })();
const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const MONS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const nice = (iso: string) => { const d = new Date(`${iso}T00:00:00Z`); return `${DAYS[d.getUTCDay()]} ${d.getUTCDate()} ${MONS[d.getUTCMonth()]} ${d.getUTCFullYear()}`; };
const returns = (() => { const d = new Date(`${date}T00:00:00Z`); d.setUTCDate(d.getUTCDate() + nights); return nice(d.toISOString().slice(0, 10)); })();
const title = cleanCruiseTitle(holiday.title);
const shipName = holiday.shipName || '';
// What a caller quotes: the cruise id and the sailing, so whoever answers finds the exact sailing.
const quoteRef = `${holiday.id}-${date.slice(5, 7)}${date.slice(8, 10)}`;
const meta = { id: holiday.id, title, date: nice(date), airport: chosen.airportName, ship: shipName, ref: quoteRef };
---
<BaseLayout title={`Choose your cabin · ${title} · ${nice(date)}`} description={`Cabins and prices for ${title} sailing ${nice(date)}, flying from ${chosen.airportName}.`} noindex={true}>
  <Header />
  <MobileNav />

  <main class="cb">
    <div class="section-container cb__wrap">
      <p class="cb__back"><a href={`${cruiseUrl}#sailings`}>‹ Back to dates</a></p>
      <p class="cd-eyebrow">Step two</p>
      <h1>Choose your cabin</h1>
      <p class="cb__lede">{title}, sailing <b>{nice(date)}</b>. Every cabin has a private shower room; the price is per person sharing, with flights, hold luggage and transfers in it.</p>

      <div class="cb__grid">
        <div class="cb__main">
          {swappedFrom && (
            <p class="cb__swap">There are no {swappedFrom} flights on this sailing. Prices below are from {chosen.airportName}.</p>
          )}
          {airports.length > 1 && (
            <div class="cb__airports">
              <p class="cd-lab">Flying from</p>
              <div class="cb__chips">
                {airports.map(a => (
                  <a class="cb__chip" href={`?date=${date}&airport=${a.airportCode}`} aria-current={a.airportCode === chosen.airportCode ? 'true' : undefined}>
                    {a.airportName} <span>from {formatPrice(a.pricePp)}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <fieldset class="cb__cabins">
            <legend class="cd-lab">Cabins on this sailing, flying from {chosen.airportName}</legend>
            {cabins.map((c, i) => (
              <label class="cb__cabin" for={c.id}>
                <input type="radio" name="cabin" id={c.id} value={c.cabinType} data-label={c.label} data-price={c.price} checked={i === 0} />
                <span class="cb__radio" aria-hidden="true"></span>
                {c.image && <img class="cb__img" src={c.image} alt={`${c.label} on the ${shipName}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" width="600" height="400" />}
                <span class="cb__body">
                  <span class="cb__name">{c.label}</span>
                  {c.facts.length > 0 && <span class="cb__facts">{c.facts.map(f => <span>{f}</span>)}</span>}
                  {c.summary && <span class="cb__sum">{c.summary}</span>}
                </span>
                <span class="cb__price">
                  <span class="cb__amt">{c.alsoAt.length > 0 && <small>from </small>}{formatPrice(c.price)}</span>
                  <span class="cd-lab">per person</span>
                  {c.saving && <span class="cb__save">Save £{c.saving.toLocaleString('en-GB')} vs booking direct</span>}
                  {c.alsoAt.length > 0 && <span class="cb__also">Also {c.alsoAt.map(p => formatPrice(p)).join(' and ')} by position on deck</span>}
                </span>
                {c.equipment.length > 0 && (
                  <details class="cb__more">
                    <summary>What's in the cabin</summary>
                    <ul>{c.equipment.map(e => <li>{e}</li>)}</ul>
                  </details>
                )}
              </label>
            ))}
          </fieldset>

          <div class="cb__people">
            <p class="cb__people-q">How many people are travelling?</p>
            <div class="cb__stepper">
              <button type="button" class="cb__step" id="cb-less" aria-label="One fewer traveller">−</button>
              <span class="cb__count" id="cb-count">2 people</span>
              <button type="button" class="cb__step" id="cb-more" aria-label="One more traveller">+</button>
            </div>
            <p class="cb__people-note">Travelling alone, or more than four? Ask in the quote and we will price it.</p>
          </div>
        </div>

        <aside class="cb__side" id="cb-side">
          <div class="cb__summary">
            <button type="button" class="cb__sheet-close" id="cb-sheet-close" aria-label="Close">×</button>
            <p class="cd-lab">Your cruise</p>
            <p class="cb__title">{title}</p>
            <dl class="cb__facts-list" aria-live="polite">
              <div><dt>Departs</dt><dd>{nice(date)}</dd></div>
              <div><dt>Returns</dt><dd>{returns}</dd></div>
              <div><dt>Flying from</dt><dd>{chosen.airportName}</dd></div>
              {shipName && <div><dt>Ship</dt><dd>{shipName}</dd></div>}
              <div><dt>Cabin</dt><dd id="cb-sum-cabin">{cabins[0]?.label}</dd></div>
              <div><dt>Travellers</dt><dd id="cb-sum-people">2 people</dd></div>
            </dl>
            <div class="cb__total" aria-live="polite">
              <span>Total</span>
              <span class="cb__total-amt" id="cb-total">{formatPrice((cabins[0]?.price ?? 0) * 2)}</span>
            </div>
            <p class="cb__total-note">Flights, hold luggage, cruise and transfers. Nothing to pay today.</p>

            <form id="cb-form" class="cb__form" novalidate>
              <p class="cb__form-h">Get a written quote</p>
              <input type="text" name="company" value="" autocomplete="off" tabindex="-1" aria-hidden="true" class="cb__hp" />
              <div class="cb__row2">
                <label>First name <input name="first_name" type="text" autocomplete="given-name" required /></label>
                <label>Last name <input name="last_name" type="text" autocomplete="family-name" required /></label>
              </div>
              <label>Email <input name="email" type="email" autocomplete="email" required /></label>
              <label>Phone <input name="phone" type="tel" autocomplete="tel" required /></label>
              <button type="submit" class="cd-btn cb__submit" id="cb-submit">Send me this quote</button>
              <p class="cb__form-note">We reply by email, usually the same working day.</p>
            </form>
            <div class="cb__done" id="cb-done" hidden>
              <p class="cb__done-h">Thank you</p>
              <p>Your quote is on its way. One of our cruise team will email it, usually the same working day.</p>
            </div>

            <div class="cb__talk">
              <p class="cb__talk-h">Rather talk it through?</p>
              <p>Call <CallLink class="cb__tel" tel={TEL_HREF} display={TEL_DISPLAY} /> and quote <b>{quoteRef}</b>. We will have this sailing up when you ring. Lines open 9am to 6pm.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <!-- Phones and tablets: the summary and form live in a sheet; this bar opens it. -->
    <div class="cb__bar" id="cb-bar">
      <div class="cb__bar-text">
        <span class="cb__bar-cabin" id="cb-bar-cabin">{cabins[0]?.label}</span>
        <span class="cb__bar-total"><b id="cb-bar-total">{formatPrice((cabins[0]?.price ?? 0) * 2)}</b> <span id="cb-bar-people">for 2 people</span></span>
      </div>
      <button type="button" class="cd-btn cb__bar-btn" id="cb-bar-open">Get a written quote</button>
    </div>
  </main>

  <script type="application/json" id="cb-meta" set:html={JSON.stringify(meta).replace(/</g, '\\u003c')} />
  <Footer />
</BaseLayout>

<script>
  const meta = JSON.parse(document.getElementById('cb-meta')?.textContent || '{}');
  const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="cabin"]')];
  const countEl = document.getElementById('cb-count')!;
  const sumCabin = document.getElementById('cb-sum-cabin')!;
  const sumPeople = document.getElementById('cb-sum-people')!;
  const totalEl = document.getElementById('cb-total')!;
  let people = 2;
  const gbp = (n: number) => '£' + Math.round(n).toLocaleString('en-GB');
  const chosen = () => radios.find(r => r.checked) || radios[0];
  function paint() {
    const c = chosen();
    const price = Number(c?.dataset.price || 0);
    const label = people === 1 ? '1 person' : `${people} people`;
    countEl.textContent = label;
    sumPeople.textContent = label;
    sumCabin.textContent = c?.dataset.label || '';
    totalEl.textContent = gbp(price * people);
    const barCabin = document.getElementById('cb-bar-cabin'); if (barCabin) barCabin.textContent = c?.dataset.label || '';
    const barTotal = document.getElementById('cb-bar-total'); if (barTotal) barTotal.textContent = gbp(price * people);
    const barPeople = document.getElementById('cb-bar-people'); if (barPeople) barPeople.textContent = `for ${label}`;
    (document.getElementById('cb-less') as HTMLButtonElement | null)?.toggleAttribute('disabled', people <= 1);
    (document.getElementById('cb-more') as HTMLButtonElement | null)?.toggleAttribute('disabled', people >= 4);
  }
  radios.forEach(r => r.addEventListener('change', paint));
  document.getElementById('cb-less')?.addEventListener('click', () => { people = Math.max(1, people - 1); paint(); });
  document.getElementById('cb-more')?.addEventListener('click', () => { people = Math.min(4, people + 1); paint(); });
  paint();

  // The sheet (phones and tablets): open from the bar, close with ×, backdrop or Escape.
  const side = document.getElementById('cb-side')!;
  const openSheet = () => { side.classList.add('is-open'); document.body.classList.add('cb-sheet-open'); track('cabin_sheet_open'); (side.querySelector('#cb-form input:not(.cb__hp)') as HTMLElement | null)?.focus(); };
  const closeSheet = () => { side.classList.remove('is-open'); document.body.classList.remove('cb-sheet-open'); };
  document.getElementById('cb-bar-open')?.addEventListener('click', openSheet);
  // The site's cookie banner is fixed to the bottom at z-index 9999; while it shows,
  // the bar sits on top of it rather than under it.
  const bar = document.getElementById('cb-bar');
  const liftBar = () => { const cb = document.getElementById('cookie-banner'); const h = cb && getComputedStyle(cb).display !== 'none' ? cb.getBoundingClientRect().height : 0; if (bar) bar.style.bottom = h ? `${h}px` : ''; };
  liftBar(); window.addEventListener('resize', liftBar);
  document.getElementById('cookie-accept')?.addEventListener('click', () => setTimeout(liftBar, 0));
  setTimeout(liftBar, 300);
  document.getElementById('cb-sheet-close')?.addEventListener('click', closeSheet);
  side.addEventListener('click', (e) => { if (e.target === side) closeSheet(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && side.classList.contains('is-open')) closeSheet(); });

  // Phones and tablets: the chat bubble sat on the quote bar (owner 2026-09-27),
  // so it is hidden on this page there. The CSS below covers it before Tidio
  // loads; the API call covers Tidio re-showing itself after.
  if (window.matchMedia('(max-width: 940px)').matches) {
    const hideChat = () => { try { (window as any).tidioChatApi?.hide(); } catch { /* not loaded yet */ } };
    hideChat();
    document.addEventListener('tidioChat-ready', hideChat);
  }

  const track = (event: string, props: Record<string, string> = {}) => {
    try { (window as any).posthog?.capture(event, { lead_source: sessionStorage.getItem('lead_source') || 'Direct', ...props }); } catch { /* never block */ }
  };
  track('cabin_page_view', { cruise: String(meta.id), date: meta.date, airport: meta.airport });

  const form = document.getElementById('cb-form') as HTMLFormElement | null;
  const submit = document.getElementById('cb-submit') as HTMLButtonElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const c = chosen();
    const price = Number(c?.dataset.price || 0);
    const payload: Record<string, string> = {};
    new FormData(form).forEach((v, k) => { payload[k] = String(v); });
    Object.assign(payload, {
      form_type: 'Package Enquiry',
      package_name: meta.title,
      package_id: String(meta.id),
      departure_date: meta.date,
      departure_airport: meta.airport,
      num_adults: String(people),
      price_per_person: String(price),
      total_price: String(price * people),
      message: `Cabin: ${c?.dataset.label || ''}${meta.ship ? ` on the ${meta.ship}` : ''}. Ref ${meta.ref}.`,
      source: sessionStorage.getItem('lead_source') || 'Direct',
      landing_page: sessionStorage.getItem('landing_page') || '',
      page_url: location.pathname + location.search,
      page_title: document.title,
    });
    if (submit) { submit.disabled = true; submit.textContent = 'Sending…'; }
    try {
      const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      const done = document.getElementById('cb-done'); if (done) done.hidden = false;
      track('quote_form_submit', { cruise: String(meta.id), cabin: c?.dataset.label || '', people: String(people) });
      try { (window as any).fbq?.('track', 'Lead', { content_name: document.title, content_category: 'Holiday Enquiry', currency: 'GBP' }); } catch { /* optional */ }
      try { (window as any).oaiq?.('measure', 'lead_created', { type: 'customer_action', amount: 0, currency: 'GBP' }); } catch { /* optional */ }
    } catch {
      if (submit) { submit.disabled = false; submit.textContent = 'Send me this quote'; }
      const note = form.querySelector<HTMLElement>('.cb__form-note');
      if (note) note.textContent = `Sorry, that did not send. Please call ${meta.tel || '0208 183 0518'} and quote ${meta.ref}.`;
    }
  });
</script>

<style>
  /* 125px top: the site header is fixed and 101px tall (51px under 768). */
  .cb { background: #f2f5f6; padding-block: 125px 64px; }
  .cb__back { margin: 0 0 20px; font-size: 16px; }
  .cb__back a { color: #0d6066; font-weight: 500; text-decoration: none; }
  .cb__back a:hover { text-decoration: underline; }
  .cd-eyebrow { margin: 0 0 8px; font-size: 14px; line-height: 24px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: #0d6066; }
  .cb h1 { font-family: CaslonGraphiqueEF, Georgia, serif; font-size: 40px; line-height: 42px; letter-spacing: -.5px; font-weight: 400; margin: 0; color: #424242; text-wrap: balance; }
  .cb__swap { margin: 0; padding: 12px 16px; background: #fff7ed; border: 1px solid #f5d0a9; border-radius: 2px; font-size: 16px; line-height: 24px; color: #7a4a10; }
  .cb__chip:focus-visible, .cb__step:focus-visible, .cb__back a:focus-visible, .cb__more summary:focus-visible, .cb__submit:focus-visible { outline: 3px solid #073140; outline-offset: 2px; }
  .cb__lede { margin: 12px 0 0; max-width: 72ch; font-size: 16px; line-height: 28px; color: #424242; }
  .cd-lab { margin: 0; font-size: 12px; line-height: 20px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; }

  .cb__grid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 32px; align-items: start; margin-top: 32px; }
  .cb__main { display: grid; gap: 24px; }

  .cb__airports { margin: 0; }
  .cb__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .cb__chip { display: inline-flex; flex-direction: column; gap: 2px; min-height: 44px; justify-content: center; padding: 8px 14px; border: 1px solid #d4dcde; border-radius: 2px; background: #fff; color: #424242; font-size: 16px; font-weight: 500; text-decoration: none; }
  .cb__chip span { font-size: 14px; font-weight: 400; color: #6b6b6b; }
  .cb__chip:hover { border-color: #20A1AA; }
  .cb__chip[aria-current] { border-color: #20A1AA; box-shadow: inset 0 0 0 1px #20A1AA; background: #f0f9fa; }

  .cb__cabins { margin: 0; padding: 0; border: 0; display: grid; gap: 12px; }
  .cb__cabins legend { margin-bottom: 8px; }
  .cb__cabin { position: relative; display: grid; grid-template-columns: 28px 160px minmax(0, 1fr) 200px; grid-template-areas: 'radio img body price' 'radio img more price'; gap: 12px 16px; align-items: start; padding: 16px; background: #fff; border: 2px solid #e5e7eb; border-radius: 2px; cursor: pointer; }
  .cb__radio { grid-area: radio; }
  .cb__img { grid-area: img; }
  .cb__body { grid-area: body; }
  .cb__more { grid-area: more; }
  .cb__price { grid-area: price; }
  .cb__cabin:hover { border-color: #9fcbd4; }
  .cb__cabin:has(input:checked) { border-color: #20A1AA; background: #f7fcfc; }
  .cb__cabin:has(input:focus-visible) { outline: 3px solid #073140; outline-offset: 2px; }
  .cb__cabin input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .cb__radio { width: 24px; height: 24px; border-radius: 50%; border: 2px solid #9aa7ab; background: #fff; display: block; }
  .cb__cabin:has(input:checked) .cb__radio { border-color: #20A1AA; box-shadow: inset 0 0 0 6px #20A1AA; }
  .cb__img { width: 100%; height: auto; aspect-ratio: 3/2; object-fit: cover; border-radius: 2px; display: block; }
  .cb__body { display: grid; gap: 6px; }
  .cb__name { font-size: 18px; line-height: 26px; font-weight: 500; color: #424242; }
  .cb__facts { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 16px; color: #424242; }
  .cb__facts span::before { content: '✓'; color: #20A1AA; font-weight: 700; margin-right: 4px; }
  .cb__sum { font-size: 16px; line-height: 26px; color: #424242; }
  .cb__more { font-size: 16px; color: #424242; }
