---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import MobileNav from '../../../components/MobileNav.astro';
import PageHero from '../../../components/PageHero.astro';
import Footer from '../../../components/Footer.astro';
import Newsletter from '../../../components/Newsletter.astro';
import MobileCallCTA from '../../../components/MobileCallCTA.astro';
import BreadcrumbSchema from '../../../components/BreadcrumbSchema.astro';
import { allCollections, type Collection } from '../../../data/collections-static';
import { getDb } from '../../../lib/get-db';
import { getHolidaysByCountryFromDb, getAllListedHolidaysFromDb, getFilterData } from '../../../lib/holidays-db';

const { country: countrySlug } = Astro.params;

// Check if this slug matches a collection (collections and countries share the same URL pattern)
const matchedCollection = allCollections.find(c => {
  const slug = c.href.replace('/Holidays/', '');
  return slug === countrySlug;
});
const isCollection = !!matchedCollection && matchedCollection.href !== '/Holidays/river-cruises';

let pageTitle: string;
let pageDescription: string;
let countryName: string;
let holidays: any[];
let boardBasisOptions: string[];
let priceRange: { min: number; max: number };
let collection: Collection | undefined;

try {
  const db = getDb(Astro);

  if (isCollection) {
    collection = matchedCollection;
    pageTitle = `${collection!.name} Holidays | Flights and Packages`;
    countryName = collection!.name;
    const all = await getAllListedHolidaysFromDb(db);
    holidays = all
      .filter(h => h.tags.includes(collection!.tag))
      .sort((a, b) => (a.price + a.localChargesPp) - (b.price + b.localChargesPp));
    const filterData = getFilterData(holidays);
    boardBasisOptions = filterData.boardBasisOptions;
    priceRange = filterData.priceRange;
    const cheapest = holidays.length > 0 ? Math.round(holidays[0].price + holidays[0].localChargesPp) : null;
    pageDescription = cheapest
      ? `Explore ${holidays.length} ${collection!.name} holidays${cheapest ? ` from £${cheapest}pp` : ''}. Flights, hotel and transfers included. ATOL protected.`
      : `Browse our ${collection!.name} holiday deals. Flights and accommodation included.`;
  } else {
    const result = await getHolidaysByCountryFromDb(db, countrySlug!);
    if (!result) {
      return new Response(null, { status: 404, statusText: 'Not Found' });
    }
    countryName = result.countryName;
    holidays = result.holidays;
    pageTitle = `${countryName} Holidays | Flights and Packages`;
    const cheapest = holidays.length > 0 ? Math.round(Math.min(...holidays.map(h => h.price + h.localChargesPp))) : null;
    pageDescription = cheapest
      ? `Discover ${holidays.length} ${countryName} holidays from £${cheapest}pp. Flights, hotel and transfers included. ATOL protected. Book online or call 020 8183 0518.`
      : `Browse our latest ${countryName} holiday deals. Find flights and packages to ${countryName}.`;
    const filterData = getFilterData(holidays);
    boardBasisOptions = filterData.boardBasisOptions;
    priceRange = filterData.priceRange;
  }
} catch (e) {
  console.error('DB error on listing page:', e);
  return new Response('Service temporarily unavailable', { status: 503 });
}

const heroOverrides: Record<string, string> = {
  'Special Offer': '/images/heroes/special-offers.jpg',
};
const bannerImage = isCollection
  ? (heroOverrides[collection!.tag] || (holidays.length > 0 ? holidays[0].heroImage : collection!.image))
  : (holidays.length > 0 ? holidays[0].heroImage : '/images/heroes/country.jpg');

// ItemList schema for first 20 holidays
const itemListSchema = holidays.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${countryName} Holidays`,
  numberOfItems: holidays.length,
  itemListElement: holidays.slice(0, 20).map((h, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: h.title,
    url: `https://holidays.flightsandpackages.com/Holidays/${h.countrySlug}/${h.slug}`,
    image: h.image,
  })),
} : null;
---

<BaseLayout title={pageTitle} description={pageDescription} image={bannerImage}>
  <BreadcrumbSchema slot="head" items={isCollection ? [
    { name: 'Home', url: '/' },
    { name: 'Collections', url: '/collections' },
    { name: countryName },
  ] : [
    { name: 'Home', url: '/' },
    { name: 'Destinations', url: '/destinations' },
    { name: countryName },
  ]} />
  {itemListSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
  <Header />
  <MobileNav />

  <!-- Custom Hero -->
  <section class="country-hero" aria-label="Page hero">
    <img src={bannerImage} alt="" class="hero-bg" fetchpriority="high" decoding="async" width="1920" height="500" />
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <img src="/icons/breadcrumb-arrow.svg" alt="" class="breadcrumb-icon" />
      {isCollection ? (
        <><a href="/collections">Collections</a><img src="/icons/breadcrumb-arrow.svg" alt="" class="breadcrumb-icon" /></>
      ) : (
        <><a href="/destinations">Destinations</a><img src="/icons/breadcrumb-arrow.svg" alt="" class="breadcrumb-icon" /></>
      )}
      <span>{countryName}</span>
    </nav>
    <div class="hero-content">
      <div class="hero-subtitle">discover</div>
      <h1>{countryName} Holidays</h1>
    </div>
  </section>

  <!-- Search Bar Section -->
  <div class="search-section section-container">
    <div class="search-form">
      <form role="search" aria-label="Search holidays">
        <div class="mobile-wrap">
          <div class="form-box">
            <label for="destination">Destination</label>
            <div class="input">
              <input type="text" id="destination" name="destination" placeholder="Where to?" value={countryName} />
            </div>
          </div>
          <div class="form-box">
            <label for="airport">Departing from</label>
            <div class="input">
              <select id="airport" name="airport">
                <option value="">Any airport</option>
                <option value="London Heathrow">London Heathrow</option>
                <option value="London Gatwick">London Gatwick</option>
                <option value="Manchester">Manchester</option>
                <option value="Birmingham">Birmingham</option>
              </select>
            </div>
          </div>
          <div class="form-box">
            <label for="month">Departure month</label>
            <div class="input">
              <select id="month" name="month">
                <option value="">Any month</option>
                <option value="January">January</option>
                <option value="February">February</option>
                <option value="March">March</option>
                <option value="April">April</option>
                <option value="May">May</option>
                <option value="June">June</option>
                <option value="July">July</option>
                <option value="August">August</option>
                <option value="September">September</option>
                <option value="October">October</option>
                <option value="November">November</option>
                <option value="December">December</option>
              </select>
            </div>
          </div>
          <div class="form-box">
            <label for="passengers">Passengers</label>
            <div class="input">
              <select id="passengers" name="passengers">
                <option value="2">2 Adults</option>
                <option value="1">1 Adult</option>
                <option value="3">3 Adults</option>
                <option value="4">4 Adults</option>
              </select>
            </div>
          </div>
        </div>
        <button type="submit" class="btn-primary search-submit-btn">Search</button>
      </form>
    </div>
    <!-- Floating mobile search button -->
    <a href="/Holidays/search" class="btn-primary search-btn" aria-label="Search holidays">
      <span class="icon-search"></span>
      <span class="sr-only">Search</span>
    </a>
  </div>

  <!-- Intro Section -->
  <section class="intro-section section-container">
    <p class="intro-text">
      {countryName} is a wonderful destination offering a rich blend of culture, history, and natural beauty.
      From vibrant cities to stunning landscapes, there is something for every type of traveller.
      Whether you are looking for relaxation on sun-drenched beaches, adventure in the great outdoors,
      or a journey through centuries of fascinating heritage, {countryName} delivers an unforgettable holiday experience.
    </p>
    <p class="intro-text-extra hide" id="intro-extra-text">
      Our carefully curated {countryName} holiday packages include flights, accommodation, and transfers to take the
      stress out of planning. Choose from luxury resorts, boutique hotels, and charming guesthouses, all handpicked
      by our travel experts. With departures from major UK airports and flexible booking options, your dream
      {countryName} holiday is just a click away. Browse our latest deals below or speak to one of our
      friendly travel advisors for a tailor-made quote.
    </p>
    <button type="button" class="read-more" aria-expanded="false" aria-controls="intro-extra-text">
      Read more
      <span class="icon-dropdown"></span>
    </button>
  </section>

  <!-- Holiday List Section -->
  <section class="holiday-list-section section-container">
    <!-- Sidebar -->
    <div class="sidebar-backdrop"></div>
    <div class="sidebar" id="sidebar-filters">
      <!-- Filter header -->
      <div class="filter">
        <div class="sidebar-header">
          <div class="type">Filters</div>
          <button type="button" class="reset">Reset</button>
          <button type="button" class="sidebar-close" aria-label="Close filters">&times;</button>
        </div>
      </div>

      {isCollection && (
        <div class="filter">
          <button type="button" class="sidebar-header" aria-expanded="true">
            <div class="type">Country</div>
            <span class="icon-pullup"></span>
          </button>
          <div class="sidebar-content">
            {[...new Set(holidays.map((h: any) => h.country))].sort().map((country: string) => (
              <div class="checkbox-option">
                <input type="checkbox" name="country" id={`c-${country.toLowerCase().replace(/\s+/g, '-')}`} value={country} />
                <label for={`c-${country.toLowerCase().replace(/\s+/g, '-')}`}>{country}</label>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Board Basis filter -->
      <div class="filter">
        <button type="button" class="sidebar-header" aria-expanded="true">
          <div class="type">Board basis</div>
          <span class="icon-pullup"></span>
        </button>
        <div class="sidebar-content">
          {boardBasisOptions.map((basis) => (
            <div class="checkbox-option">
              <input type="checkbox" name="board" id={`b-${basis.toLowerCase().replace(/[\s&]+/g, '-')}`} value={basis} />
              <label for={`b-${basis.toLowerCase().replace(/[\s&]+/g, '-')}`}>{basis}</label>
            </div>
          ))}
        </div>
      </div>

      {!isCollection && (
        <>
          <div class="filter">
            <button type="button" class="sidebar-header" aria-expanded="true">
              <div class="type">Price range</div>
              <span class="icon-pullup"></span>
            </button>
            <div class="sidebar-content">
              <div class="price-boxes">
                <div aria-label="Minimum price">&pound;<span>{priceRange.min}</span></div>
                <div aria-label="Maximum price">&pound;<span>{priceRange.max}</span></div>
              </div>
            </div>
          </div>

          <div class="filter">
            <button type="button" class="sidebar-header" aria-expanded="true">
              <div class="type">Airport</div>
              <span class="icon-pullup"></span>
            </button>
            <div class="sidebar-content">
              <div class="checkbox-option">
                <input type="checkbox" name="airport" id="london-heathrow" value="London Heathrow" />
                <label for="london-heathrow">London Heathrow</label>
              </div>
              <div class="checkbox-option">
                <input type="checkbox" name="airport" id="london-gatwick" value="London Gatwick" />
                <label for="london-gatwick">London Gatwick</label>
              </div>
              <div class="checkbox-option">
                <input type="checkbox" name="airport" id="manchester" value="Manchester" />
                <label for="manchester">Manchester</label>
              </div>
              <div class="checkbox-option">
                <input type="checkbox" name="airport" id="birmingham" value="Birmingham" />
                <label for="birmingham">Birmingham</label>
              </div>
            </div>
          </div>
        </>
      )}

      <!-- Mobile actions -->
      <div class="mobile-actions">
        <button type="button" class="btn-primary filter-apply-btn" aria-label="Apply filters">Apply</button>
        <button type="button" class="reset">Reset</button>
      </div>
    </div>

    <!-- Content -->
    <div class="content">
      <!-- Sort bar -->
      <div class="search-sort">
        <div class="results" aria-live="polite" aria-atomic="true"></div>
        <div class="order">
          <div class="price" role="group" aria-label="Sort order">
            Price
            <button type="button" class="price-order active" aria-pressed="true">Low to high</button>
            <button type="button" class="price-order" aria-pressed="false">High to low</button>
          </div>
          <div class="mobile-filter-wrap">
            <button type="button" class="filter-btn" aria-expanded="false" aria-controls="sidebar-filters">
              <span class="icon-filter"></span>
              Filter
            </button>
            <div class="sort">
              Sort by
              <button type="button" class="sort-order" aria-haspopup="listbox" aria-expanded="false">
                <span class="current-option">Price: Low to high</span>
                <span class="icon-dropdown"></span>
              </button>
              <ul class="sort-order-list" role="listbox" aria-label="Sort order">
                <li class="sort-option" role="option" tabindex="0" aria-selected="true">Price: Low to high</li>
                <li class="sort-option" role="option" tabindex="0" aria-selected="false">Price: High to low</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Holiday cards -->
      <div class="holidays">
        {holidays.map((holiday) => (
          <div class="holiday"
            data-country={holiday.country}
            data-board={holiday.boardBasis}
            data-price={holiday.price + holiday.localChargesPp}
          >
            <img class="holiday-img" src={holiday.image} alt={holiday.title} loading="lazy" decoding="async" width="291" height="340" />
            <a class="gallery-link" href={`/Holidays/${holiday.countrySlug}/${holiday.slug}`} aria-hidden="true" tabindex="-1">
              <span class="icon-camera"></span>
              Gallery
            </a>
            <div class="details">
              <div>
                <a class="title" href={`/Holidays/${holiday.countrySlug}/${holiday.slug}`}>{holiday.title}</a>
                <ul>
                  <li><span class="icon-compass" aria-hidden="true"></span>{holiday.destination}</li>
                  <li><span class="icon-nights" aria-hidden="true"></span>{holiday.duration}</li>
                  <li><span class="icon-board-basis" aria-hidden="true"></span>{holiday.boardBasis}</li>
                </ul>
              </div>
              <p>{holiday.description}</p>
              <div class="horizontal">
                <div class="price" aria-label={`from £${Math.round(holiday.price + holiday.localChargesPp)} per person`}>
                  <span aria-hidden="true">from</span>
                  <div aria-hidden="true">&pound;{Math.round(holiday.price + holiday.localChargesPp)}<span>/pp</span></div>
                </div>
                <a class="btn-primary view-more-btn" href={`/Holidays/${holiday.countrySlug}/${holiday.slug}`}>
                  View More
                  <img src="/icons/more-icon-white.svg" alt="" class="icon-more" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Load More button -->
      <button class="btn-primary more-holidays" style="display:none">Load More Results</button>

      <div class="no-filter-results" style="display:none">
        <p>No holidays match your selected filters. <button type="button" class="clear-filters">Clear all filters</button></p>
      </div>

      {holidays.length === 0 && (
        <div class="no-results">
          <p>No holidays are currently available for {countryName}. Please check back soon or call us on <a href="tel:02081830518">0208 183 0518</a> for the latest deals.</p>
        </div>
      )}
    </div>

  </section>

  <Newsletter />
  <Footer />
  <MobileCallCTA />
</BaseLayout>

<style>
  /* ===========================
     Country Hero Section
     =========================== */
  .country-hero {
    margin-top: 100px;
    height: 500px;
    position: relative;
    color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 100%;
    overflow: hidden;
  }
  .country-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0.35) 100%);
    z-index: 1;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% center;
    z-index: 0;
  }
  .country-hero .breadcrumbs,
  .country-hero .hero-content {
    position: relative;
    z-index: 2;
  }
  @media (max-width: 768px) {
    .country-hero {
      margin-top: 50px;
      height: 400px;
    }
    .hero-bg { object-position: center; }
  }
  @media (max-width: 450px) {
    .country-hero {
      height: 300px;
    }
  }

  .breadcrumbs {
    position: absolute;
    left: 50px;
    top: 10px;
    z-index: 3;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
    color: #ffffff;
    display: flex;
    align-items: center;
  }
  @media (max-width: 768px) {
    .breadcrumbs { left: 20px; }
  }
  @media (max-width: 530px) {
    .breadcrumbs { max-width: calc(100vw - 40px); }
  }

  .breadcrumbs a,
  .breadcrumbs span {
    font-family: "BentonSansMedium", sans-serif;
    font-size: 13px;
    line-height: 16px;
    color: #ffffff;
  }

  .breadcrumb-icon {
    padding: 0 5px;
    width: auto;
    height: 8px;
  }

  .hero-content {
    text-align: center;
    padding-bottom: 80px;
  }
  @media (max-width: 1260px) {
    .hero-content {
      padding-bottom: 120px;
    }
  }
  @media (max-width: 768px) {
    .hero-content {
      padding-bottom: 0px;
    }
  }

  .hero-subtitle {
    font-family: "BentonSansBold", sans-serif;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 5px;
    text-transform: uppercase;
    padding-bottom: 14px;
  }

  .hero-content h1 {
    color: #ffffff;
    font-size: 64px;
    line-height: 1;
    padding-bottom: 25px;
    text-shadow: 2px 2px 5px #000;
  }
  @media (max-width: 768px) {
    .hero-content h1 {
      font-size: 44px;
    }
  }
  @media (max-width: 450px) {
    .hero-content h1 {
      font-size: 36px;
    }
  }

  /* ===========================
     Search Section Overlay
     =========================== */
  .search-section {
    position: absolute;
    top: 440px;
    left: 0;
    right: 0;
    margin: auto;
    width: 100%;
    z-index: 3;
  }
  @media (max-width: 1260px) {
    .search-section {
      max-width: 730px;
      top: 400px;
    }
  }
  @media (max-width: 768px) {
    .search-section {
      position: static;
    }
  }

  .search-form {
    border-radius: 2px;
    box-shadow: 0px 0px 8px rgba(0, 0, 0, 0.2);
    background-color: #ffffff;
    padding: 0 25px;
  }
  @media (max-width: 768px) {
    .search-form {
      display: none;
    }
  }
  .search-form form {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 96px;
    width: 100%;
  }
  @media (max-width: 1260px) {
    .search-form form {
      height: 164px;
    }
    .search-form {
      height: 164px;
    }
  }

  .search-form .mobile-wrap {
    display: flex;
    flex-grow: 1;
  }
  @media (max-width: 1260px) {
    .search-form .mobile-wrap {
      height: 124px;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
    }
  }

  .search-form .form-box {
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    height: 52px;
    width: 100%;
    padding-right: 40px;
  }
  @media (max-width: 1260px) {
    .search-form .form-box {
      padding-right: 0px;
    }
  }
  .search-form .form-box label {
    font-family: "BentonSansBold", sans-serif;
    font-size: 14px;
    color: #282828;
  }
  .search-form .form-box .input {
    display: flex;
    position: relative;
    left: -15px;
  }
  .search-form .form-box .input input,
  .search-form .form-box .input select {
    font-family: "BentonSansMedium", sans-serif;
    font-size: 14px;
    color: #878787;
    border: none;
    outline: none;
    background: transparent;
    padding-left: 15px;
    width: 100%;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }
  .search-form .form-box .input input:focus-visible,
  .search-form .form-box .input select:focus-visible {
    outline: 2px solid #20A1AA;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .search-submit-btn {
    width: 161px;
    min-width: 161px;
    letter-spacing: 1px;
    height: 64px;
    margin: 0px;
    box-shadow: 0px 20px 20px rgba(0, 0, 0, 0.2);
  }

  /* Floating mobile search button */
  .search-btn {
    display: none;
  }
  @media (max-width: 768px) {
    .search-btn {
      display: flex;
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 3;
      width: 51px;
      min-width: 51px;
      height: 51px;
      font-size: 8px;
      letter-spacing: 0px;
      flex-direction: column;
      text-decoration: none;
    }
    .search-btn .icon-search {
      content: "";
      background-image: url('/icons/search-icon.svg');
      background-size: cover;
      background-position: center;
      width: 18px;
      height: 18px;
    }
  }

  /* ===========================
     Intro Section
     =========================== */
  .intro-section {
    margin-top: 80px;
    margin-bottom: 95px;
  }
  @media (max-width: 768px) {
    .intro-section {
      margin-top: 40px;
      margin-bottom: 50px;
    }
  }
  .intro-section p {
    padding-bottom: 1px;
  }
  @media (max-width: 768px) {
    .intro-section p {
      text-align: justify;
    }
  }
  .intro-section .read-more {
    vertical-align: middle;
    font-family: "BentonSansBold", sans-serif;
    color: #424242;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 15px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }
  .intro-section .read-more .icon-dropdown {
    display: inline-block;
    width: 12px;
    height: 7px;
    background-image: url('/icons/dropdown-icon.svg');
    background-repeat: no-repeat;
    background-size: cover;
    margin-left: 15px;
    transition: transform 0.3s;
  }
  .intro-section .read-more.expanded .icon-dropdown {
    transform: rotate(180deg);
  }

  /* ===========================
     Holiday List Section
     =========================== */
  .holiday-list-section {
    margin-top: 60px;
    margin-bottom: 0px;
  }
  .holiday-list-section::after { content: ""; display: table; clear: both; }
  @media (max-width: 768px) {
    .holiday-list-section {
