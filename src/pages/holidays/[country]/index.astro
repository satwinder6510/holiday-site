<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Read more toggle
    const readMoreLink = document.querySelector<HTMLButtonElement>('.read-more');
    const extraText = document.querySelector('.intro-text-extra');
    if (readMoreLink && extraText) {
      readMoreLink.addEventListener('click', () => {
        const isHidden = extraText.classList.contains('hide');
        extraText.classList.toggle('hide');
        readMoreLink.innerHTML = isHidden
          ? 'Read less <span class="icon-dropdown"></span>'
          : 'Read more <span class="icon-dropdown"></span>';
        readMoreLink.classList.toggle('expanded', isHidden);
        readMoreLink.setAttribute('aria-expanded', String(isHidden));
      });
    }

    // ── Mobile sidebar with backdrop ──
    const filterBtn = document.querySelector<HTMLButtonElement>('.filter-btn');
    const sidebar = document.querySelector<HTMLElement>('.sidebar');
    const backdrop = document.querySelector<HTMLElement>('.sidebar-backdrop');
    const closeBtn = document.querySelector<HTMLButtonElement>('.sidebar-close');

    function openSidebar() {
      if (!sidebar || !backdrop) return;
      sidebar.classList.add('show');
      backdrop.classList.add('active');
      if (filterBtn) filterBtn.setAttribute('aria-expanded', 'true');
      // Focus the close button
      if (closeBtn) closeBtn.focus();
      // Trap focus inside sidebar
      document.addEventListener('keydown', trapFocus);
    }
    function closeSidebar() {
      if (!sidebar || !backdrop) return;
      sidebar.classList.remove('show');
      backdrop.classList.remove('active');
      if (filterBtn) { filterBtn.setAttribute('aria-expanded', 'false'); filterBtn.focus(); }
      document.removeEventListener('keydown', trapFocus);
    }
    function trapFocus(e: KeyboardEvent) {
      if (e.key === 'Escape') { closeSidebar(); return; }
      if (e.key !== 'Tab' || !sidebar) return;
      const focusable = sidebar.querySelectorAll<HTMLElement>('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }

    if (filterBtn) filterBtn.addEventListener('click', () => sidebar?.classList.contains('show') ? closeSidebar() : openSidebar());
    if (backdrop) backdrop.addEventListener('click', closeSidebar);
    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);

    const applyBtn = document.querySelector('.filter-apply-btn');
    if (applyBtn) {
      applyBtn.addEventListener('click', () => { applyFilters(); closeSidebar(); });
    }

    // ── Sidebar accordion with ARIA + keyboard ──
    const filterHeaders = document.querySelectorAll<HTMLElement>('.filter .sidebar-header');
    filterHeaders.forEach((header, index) => {
      if (index === 0) return;
      function toggleAccordion() {
        const content = header.nextElementSibling as HTMLElement;
        const icon = header.querySelector('.icon-pullup, .icon-dropdown') as HTMLElement;
        if (content && content.classList.contains('sidebar-content')) {
          const isVisible = content.style.display !== 'none';
          content.style.display = isVisible ? 'none' : 'block';
          header.setAttribute('aria-expanded', String(!isVisible));
          if (icon) icon.style.transform = isVisible ? 'rotate(0deg)' : 'rotate(180deg)';
        }
      }
      header.addEventListener('click', toggleAccordion);
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleAccordion(); }
      });
    });

    // Sync aria-expanded from DOM on load
    filterHeaders.forEach((header, index) => {
      if (index === 0) return;
      const content = header.nextElementSibling as HTMLElement;
      if (content && content.classList.contains('sidebar-content')) {
        const isVisible = content.style.display !== 'none';
        header.setAttribute('aria-expanded', String(isVisible));
      }
    });

    // ── Filtering + Pagination ──
    const PAGE_SIZE = 20;
    const cards = document.querySelectorAll<HTMLElement>('.holiday[data-country]');
    const resultsEl = document.querySelector('.results');
    const loadMoreBtn = document.querySelector<HTMLButtonElement>('.more-holidays');
    const noFilterResults = document.querySelector<HTMLElement>('.no-filter-results');
    let shownCount = 0;

    function getChecked(name: string): string[] {
      return Array.from(document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`))
        .map(el => el.value);
    }

    function getVisibleCards(): HTMLElement[] {
      return Array.from(cards).filter(c => !c.classList.contains('filtered-out'));
    }

    function updateFilterBadge() {
      const count = document.querySelectorAll('.sidebar input[type="checkbox"]:checked').length;
      if (filterBtn) {
        filterBtn.innerHTML = count > 0
          ? `<span class="icon-filter"></span>Filter <span class="filter-badge">${count}</span>`
          : '<span class="icon-filter"></span>Filter';
      }
    }

    function applyPagination(reset: boolean) {
      const visible = getVisibleCards();
      const totalVisible = visible.length;

      if (reset) shownCount = Math.min(PAGE_SIZE, totalVisible);

      visible.forEach((card, i) => {
        card.style.display = i < shownCount ? '' : 'none';
      });

      if (resultsEl) {
        resultsEl.textContent = `Showing ${Math.min(shownCount, totalVisible)} of ${totalVisible} holidays`;
      }

      if (loadMoreBtn) {
        const remaining = totalVisible - shownCount;
        if (remaining <= 0) {
          loadMoreBtn.style.display = 'none';
        } else {
          loadMoreBtn.style.display = 'flex';
          const nextBatch = Math.min(PAGE_SIZE, remaining);
          loadMoreBtn.textContent = `Load ${nextBatch} More${remaining > nextBatch ? ` (${remaining} remaining)` : ''}`;
        }
      }

      if (noFilterResults) {
        noFilterResults.style.display = totalVisible === 0 ? 'block' : 'none';
      }

      updateFilterBadge();
    }

    function applyFilters() {
      const boards = getChecked('board');
      const countries = getChecked('country');

      cards.forEach(card => {
        const matchBoard = boards.length === 0 || boards.includes(card.dataset.board || '');
        const matchCountry = countries.length === 0 || countries.includes(card.dataset.country || '');
        const passes = matchBoard && matchCountry;
        card.classList.toggle('filtered-out', !passes);
        if (!passes) card.style.display = 'none';
      });

      applyPagination(true);
    }

    // Load More click — scroll to first new card
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        const visible = getVisibleCards();
        const firstNewIndex = shownCount;
        shownCount = Math.min(shownCount + PAGE_SIZE, visible.length);
        applyPagination(false);
        if (visible[firstNewIndex]) {
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          visible[firstNewIndex].scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
        }
      });
    }

    // Clear filters button (in empty state)
    const clearFiltersBtn = document.querySelector('.clear-filters');
    if (clearFiltersBtn) {
      clearFiltersBtn.addEventListener('click', () => {
        document.querySelectorAll<HTMLInputElement>('.sidebar input[type="checkbox"]').forEach(cb => cb.checked = false);
        applyFilters();
      });
    }

    // Listen for checkbox changes (instant apply on desktop)
    document.querySelectorAll('.sidebar input[type="checkbox"]').forEach(cb => {
      cb.addEventListener('change', applyFilters);
    });

    // Reset buttons
    document.querySelectorAll('.reset').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll<HTMLInputElement>('.sidebar input[type="checkbox"]').forEach(cb => cb.checked = false);
        applyFilters();
      });
    });

    // ── Price sort (desktop + mobile sync) ──
    const holidaysContainer = document.querySelector('.holidays');
    const priceOrders = document.querySelectorAll<HTMLElement>('.search-sort .order .price .price-order');

    function sortCards(descending: boolean) {
      if (!holidaysContainer) return;
      const sorted = Array.from(cards).sort((a, b) => {
        const pa = parseFloat(a.dataset.price || '0');
        const pb = parseFloat(b.dataset.price || '0');
        return descending ? pb - pa : pa - pb;
      });
      sorted.forEach(card => holidaysContainer.appendChild(card));
      applyPagination(true);
    }

    priceOrders.forEach((el) => {
      el.addEventListener('click', () => {
        priceOrders.forEach((p) => { p.classList.remove('active'); p.setAttribute('aria-pressed', 'false'); });
        el.classList.add('active');
        el.setAttribute('aria-pressed', 'true');
        const isDesc = el.textContent?.includes('High') ?? false;
        sortCards(isDesc);
        const currentOption = document.querySelector('.current-option');
        if (currentOption) currentOption.textContent = isDesc ? 'Price: High to low' : 'Price: Low to high';
      });
    });

    // ── Mobile sort dropdown ──
    const sortOrder = document.querySelector('.sort-order');
    const sortOrderList = document.querySelector<HTMLElement>('.sort-order-list');
    if (sortOrder && sortOrderList) {
      sortOrder.addEventListener('click', () => {
        const isVisible = sortOrderList.style.display === 'block';
        sortOrderList.style.display = isVisible ? 'none' : 'block';
        sortOrder.setAttribute('aria-expanded', String(!isVisible));
      });

      const sortOptions = document.querySelectorAll<HTMLElement>('.sort-option');
      function selectSortOption(option: HTMLElement) {
        const currentOption = document.querySelector('.current-option');
        if (currentOption) currentOption.textContent = option.textContent;
        sortOrderList.style.display = 'none';
        sortOrder.setAttribute('aria-expanded', 'false');
        sortOptions.forEach(o => o.setAttribute('aria-selected', 'false'));
        option.setAttribute('aria-selected', 'true');
        const isDesc = option.textContent?.includes('High') ?? false;
        priceOrders.forEach((p) => { p.classList.remove('active'); p.setAttribute('aria-pressed', 'false'); });
        const matchBtn = isDesc ? priceOrders[1] : priceOrders[0];
        if (matchBtn) { matchBtn.classList.add('active'); matchBtn.setAttribute('aria-pressed', 'true'); }
        sortCards(isDesc);
        (sortOrder as HTMLElement).focus();
      }
      sortOptions.forEach((option) => {
        option.addEventListener('click', () => selectSortOption(option));
        option.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectSortOption(option); }
          if (e.key === 'ArrowDown') { e.preventDefault(); const next = option.nextElementSibling as HTMLElement; if (next) next.focus(); }
          if (e.key === 'ArrowUp') { e.preventDefault(); const prev = option.previousElementSibling as HTMLElement; if (prev) prev.focus(); }
          if (e.key === 'Home') { e.preventDefault(); sortOptions[0].focus(); }
          if (e.key === 'End') { e.preventDefault(); sortOptions[sortOptions.length - 1].focus(); }
        });
      });

      // Close dropdown on outside click
      document.addEventListener('click', (e) => {
        if (!sortOrder.contains(e.target as Node) && !sortOrderList.contains(e.target as Node)) {
          sortOrderList.style.display = 'none';
          sortOrder.setAttribute('aria-expanded', 'false');
        }
      });
      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sortOrderList.style.display === 'block') {
          sortOrderList.style.display = 'none';
          sortOrder.setAttribute('aria-expanded', 'false');
          (sortOrder as HTMLElement).focus();
        }
      });
    }

    // Initial pagination on page load
    applyPagination(true);
  });
</script>
