---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import MobileCallCTA from '../components/MobileCallCTA.astro';
---

<BaseLayout
  title="Page Not Found | Flights and Packages"
  description="Sorry, we couldn't find that page. Explore our holiday destinations, offers and river cruises instead."
  noindex={true}
>
  <Header />
  <MobileNav />

  <section class="nf-section section-container">
    <p class="nf-label">404</p>
    <h1>We couldn't find that page</h1>
    <p class="nf-text">
      The page may have moved or the offer may have ended — but the holidays haven't.
      Try one of these instead, or call us on <a href="tel:02081830518">0208 183 0518</a>.
    </p>
    <div class="nf-actions">
      <a class="btn-primary" href="/">Home</a>
      <a class="btn-primary" href="/destinations">Destinations</a>
      <a class="btn-primary" href="/Holidays/New-&-Exclusive-Offers">Offers</a>
      <a class="btn-primary" href="/Holidays/river-cruises/">River Cruises</a>
    </div>
  </section>

  <Footer />
  <MobileCallCTA />
</BaseLayout>

<style>
  .nf-section {
    margin-top: 160px;
    margin-bottom: 120px;
    text-align: center;
  }
  @media (max-width: 768px) {
    .nf-section { margin-top: 110px; margin-bottom: 80px; }
  }

  .nf-label {
    font-family: "CaslonGraphiqueEF", Georgia, serif;
    font-size: 96px;
    line-height: 1;
    color: #20A1AA;
    margin-bottom: 10px;
  }

  h1 {
    margin-bottom: 18px;
  }

  .nf-text {
    max-width: 520px;
    margin: 0 auto 34px;
    color: #424242;
  }
  .nf-text a {
    color: #073140;
    font-family: "BentonSansBold", sans-serif;
    text-decoration: none;
  }

  .nf-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
